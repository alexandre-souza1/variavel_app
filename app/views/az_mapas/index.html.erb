<div class="app-page">
  <div class="app-page-header">
    <div>
      <p class="app-page-eyebrow"><i class="bi bi-calendar-check me-1"></i>Resultados · AZ</p>
      <h1><i class="bi bi-graph-up-arrow me-2"></i>Resultados diários</h1>
      <p>Consulte os lançamentos e indicadores diários da operação AZ.</p>
    </div>
    <div class="app-page-actions">
      <% if current_user.admin? %>
        <%= link_to new_az_mapa_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i> Novo lançamento<% end %>
      <% end %>
      <%= link_to "Voltar", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div>
    <div class="card shadow-sm rounded mb-4">
      <div class="card-body">
        <div class="row align-items-center">
          <div class="col-md-6">
            <h2 class="mb-1">
              <i class="bi bi-calendar-date"></i>
              <%= @data_inicio&.strftime("%d/%m/%Y") %> a
              <%= @data_fim&.strftime("%d/%m/%Y") %>
            </h2>
            <p class="text-muted mb-0">
              Total de Lançamentos: <%= @az_mapas.size %>
            </p>
          </div>
          <div class="col-md-6 text-md-end">
            <% if current_user.admin? %>
            <div class="d-flex gap-2 flex-row-reverse">
              <%= button_to "Apagar todos os Lançamentos", destroy_all_az_mapas_path, method: :delete, data: { turbo_confirm: "Tem certeza que deseja apagar TODOS os Lançamentos?" }, class: "btn btn-danger" %>
            </div>
            <% end %>
            <% if @data_inicio && @data_fim && @dias_periodo %>
              <p class="mb-1"><strong>Período:</strong> <%= @data_inicio.strftime("%d/%m/%Y") %> a <%= @data_fim.strftime("%d/%m/%Y") %></p>
              <p class="mb-0"><strong>Dias:</strong> <%= @dias_periodo %></p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabela de Mapas -->
    <div class="card shadow-sm rounded mb-4">
      <div class="card-header bg-light border-bottom">
        <h5 class="mb-0"><i class="bi bi-map-fill me-2"></i>Detalhes dos Lançamentos</h5>
      </div>
      <div class="card-body">
          <div class="table-responsive">
            <div class="app-table-shell"><table class="table app-table app-table--data">
              <thead class="table-primary text-center">
                <tr>
                  <th>Data</th>
                  <th>Turnos</th>
                  <th>Tipo</th>
                  <th>Resultados</th>
                  <th>Atingiu Meta</th>
                  <th>Ações</th>
                </tr>
              </thead>
              <tbody>
                <% @az_mapas.each do |az_mapa| %>
                  <tr>
                    <td><%= az_mapa.data&.strftime("%d/%m/%Y") %></td>
                    <td><%= az_mapa.turno.map { |t| turno_label(t) }.join(", ") %></td>
                    <td><%= az_mapa.tipo.humanize.titleize %></td>
                    <td>
                      <% case az_mapa.tipo.to_s %>
                      <% when "tempo_atendimento" %>
                        <% decimal = az_mapa.resultado.to_f %>
                        <% horas = decimal.floor %>
                        <% minutos = ((decimal - horas) * 60).round %>
                        <%= "#{horas}:#{minutos.to_s.rjust(2, '0')} h" %>
                      <% when "eficiencia_carregamento", "eficiencia_descarga" %>
                        <%= number_to_percentage(az_mapa.resultado, precision: 2) %>
                      <% else %>
                        <%= az_mapa.resultado %>
                      <% end %>
                    </td>
                    <td>
                      <% if az_mapa.atingiu_meta? %>
                        <span class="badge bg-success">Sim</span>
                      <% else %>
                        <span class="badge bg-danger">Não</span>
                      <% end %>
                    </td>
                    <td class="text-end">
                      <%= link_to edit_az_mapa_path(az_mapa), class: 'icon-btn', title: 'Editar mapa AZ', aria: { label: 'Editar mapa AZ' } do %>
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                      <% end %>
                      <%= link_to az_mapa_path(az_mapa), data: { turbo_method: :delete, turbo_confirm: 'Tem certeza?' }, class: 'icon-btn danger', title: 'Excluir mapa AZ', aria: { label: 'Excluir mapa AZ' } do %>
                        <i class="bi bi-trash3" aria-hidden="true"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table></div>
          </div>
      </div>
      <%= link_to "Voltar", root_path, class: "btn btn-primary shadow-sm p-3 w-100 mt-2" %>
    </div>
  </div>
</div>
