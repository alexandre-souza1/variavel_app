<div class="time-off-page" data-controller="time-off group-dialog" data-action="turbo:before-cache@document->group-dialog#reset" data-time-off-settings-open-value="<%= @settings_open %>" data-time-off-editable-value="<%= @tab == 'day' && can_edit? && @schedule.covers?(@date) && !@date.sunday? %>">
  <header class="time-off-heading">
    <div>
      <span class="time-off-eyebrow">OPERAÇÃO · PILOTO 5×2</span>
      <h1>Escala de folgas</h1>
      <p>Rodízio por grupo e acompanhamento diário de motoristas e ajudantes.</p>
    </div>
    <% if can_edit? %><button type="button" class="btn btn-outline-primary" data-action="time-off#openSettings" aria-controls="time-off-settings" aria-label="Configuração"><i class="bi bi-gear" aria-hidden="true"></i> Configuração</button><% end %>
  </header>

  <% if @unassigned_people.any? %>
    <details class="time-off-unassigned app-panel">
      <summary><i class="bi bi-exclamation-circle" aria-hidden="true"></i> <strong><%= @unassigned_people.size %> <%= @unassigned_people.one? ? 'colaborador DU sem grupo definido' : 'colaboradores DU sem grupo definido' %></strong><span> em <%= l(@date) %></span><%= disclosure_arrow %></summary>
      <div class="app-panel__body">
        <p>Esses colaboradores ainda não aparecem na escala desta data. A lista considera toda a equipe DU, independentemente dos filtros de função e grupo.</p>
        <ul class="time-off-unassigned-list">
          <% @unassigned_people.each do |person| %>
            <li data-person-key="<%= TimeOff::GroupRoster.key(person) %>">
              <% future_member = @editable_memberships[TimeOff::GroupRoster.key(person)] %>
              <div><strong><%= person.nome %></strong><small><%= person.is_a?(Employee) ? person.role_on(@date).label : person.is_a?(Driver) ? 'Motorista' : 'Ajudante' %> · Matrícula <%= person.matricula %><% if future_member %> · Grupo <%= future_member.group_code %> a partir de <%= l(future_member.starts_on) %><% end %></small></div>
              <% if can_edit? %>
                <% dialog_id = "group-dialog-#{TimeOff::GroupRoster.key(person).tr(':', '-')}" %>
                <% group_action = future_member ? 'Corrigir vigência' : 'Definir grupo' %>
                <button type="button" class="employees-group-trigger" data-action="group-dialog#open" data-group-dialog-id="<%= dialog_id %>" aria-haspopup="dialog" aria-controls="<%= dialog_id %>" aria-label="<%= group_action %> de <%= person.nome %>"><%= group_action %> <i class="bi bi-pencil" aria-hidden="true"></i></button>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </details>
  <% end %>

  <nav class="time-off-tabs" aria-label="Seções da escala de folgas">
    <% [['calendar', 'Calendário', 'bi-calendar3'], ['day', 'Escala do dia', 'bi-person-check'], ['extras', 'Extras', 'bi-calendar-plus'], ['history', 'Histórico', 'bi-clock-history']].each do |tab, label, icon| %>
      <%= link_to time_off_tab_path(tab), class: "time-off-tab #{'is-active' if @tab == tab}", aria: { current: @tab == tab ? 'page' : nil } do %>
        <i class="bi <%= icon %>" aria-hidden="true"></i>
        <span><%= label %></span>
      <% end %>
    <% end %>
  </nav>

  <% if %w[day extras].include?(@tab) %>
    <%= form_with url: time_off_schedule_path, method: :get, class: 'time-off-filters' do |form| %>
      <%= form.hidden_field :tab, value: @tab %>
      <% if @tab == 'extras' %>
        <div><%= form.label :month, 'Mês de referência' %><%= form.month_field :month, value: @month.strftime('%Y-%m'), data: { action: 'change->time-off#syncDate' }, class: 'form-control', required: true %></div>
        <%= form.hidden_field :date, value: @date %>
      <% else %>
        <%= form.hidden_field :date, value: @date %>
        <%= form.hidden_field :month, value: @month.strftime('%Y-%m') %>
      <% end %>
      <div><%= form.label :role, 'Função' %><%= form.select :role, [['Todas as funções', ''], ['Motoristas', 'driver'], ['Ajudantes', 'helper']], { selected: @role }, class: 'form-select' %></div>
      <div><%= form.label :group, 'Grupo' %><%= form.select :group, [['Todos os grupos', '']] + TimeOffSchedule::GROUPS.map { |g| ["Grupo #{g}", g] }, { selected: @group }, class: 'form-select' %></div>
      <div><%= form.label :name, 'Nome do colaborador' %><%= form.search_field :name, value: @name_query, placeholder: 'Buscar por nome', class: 'form-control' %></div>
      <%= form.hidden_field :per_page, value: @per_page %>
      <% params.slice(:calendar_period, :page).permit(:calendar_period, :page).each do |key, value| %><%= form.hidden_field key, value: value %><% end %>
      <%= form.submit 'Exibir', class: 'btn btn-primary' %>
    <% end %>
  <% end %>

  <%= render @tab %>
  <%= render 'settings' %>
  <%= render 'change_dialog' if @tab == 'day' %>
  <% if can_edit? %>
    <% @unassigned_people.each do |person| %>
      <%= render 'group_dialog', person: person, membership: @editable_memberships[TimeOff::GroupRoster.key(person)], schedule: @schedule, date: @date, url: assign_group_time_off_schedule_path(origin: 'unassigned', date: @date, tab: @tab, role: @role, group: @group, calendar_period: @calendar_period, page: @page, name: @name_query, per_page: @per_page), revision_url: revise_membership_time_off_schedule_path(date: @date, tab: @tab, role: @role, group: @group, calendar_period: @calendar_period, page: @page, name: @name_query, per_page: @per_page) %>
    <% end %>
  <% end %>
</div>
