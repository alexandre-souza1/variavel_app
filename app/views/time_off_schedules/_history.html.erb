<section class="time-off-panel" aria-labelledby="history-heading">
    <div class="time-off-panel-heading"><div><h2 id="history-heading">Histórico de <%= l(@date) %></h2><p>Últimas 30 alterações do dia, com responsável e motivo.</p></div></div>
    <% if @changes.empty? %><p class="time-off-empty">Nenhuma alteração registrada para este dia.</p><% else %>
      <ol class="time-off-history"><% @changes.each do |change| %><li><div><strong><%= change.time_off_membership&.person&.nome || 'Composição e cobertura do dia' %></strong><span><% if change.details['action'] == 'coverage' %><%= change.details['summary'] %><% elsif %w[vacation vacation_cancelled].include?(change.details['action']) %><%= change.details['action'] == 'vacation' ? 'Férias registradas' : 'Férias canceladas' %> · <%= l(Date.iso8601(change.details['starts_on'])) %> a <%= l(Date.iso8601(change.details['ends_on'])) %><% elsif change.details['action'] == 'group' %>Grupo <%= change.details['before'].presence || 'não definido' %> → <%= change.details['after'] %><% if change.details['standard_operation'] %> · Titular <%= TimeOffMembership::STANDARD_OPERATIONS.key(change.details['standard_operation']) %><% end %><% else %><%= TimeOffSchedule::STATUSES[change.details['before']] %> → <%= TimeOffSchedule::STATUSES[change.details['after']] %><%= ' · Rodízio restaurado' if change.details['restored'] %><% end %></span><p><%= change.details['reason'] %></p></div><small><%= change.user&.name.presence || change.user&.email || (change.user_id ? 'Usuário removido' : 'Configuração inicial') %><br><%= l(change.created_at, format: '%d/%m %H:%M') %></small></li><% end %></ol>
    <% end %>
    <% @changes.select { |change| change.details['movements'].present? }.each do |change| %>
      <details class="time-off-settings time-off-movement-history"><summary>Posições alteradas em <%= l(change.created_at, format: '%H:%M') %> · <%= change.details['reason'] %></summary><% change.details['movements'].each do |movement| %><p class="time-off-muted mt-2"><%= movement %></p><% end %></details>
    <% end %>
  </section>
