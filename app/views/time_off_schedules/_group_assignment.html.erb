<% prefix = "group_#{TimeOff::GroupRoster.key(person).tr(':', '_')}" %>
<%= form_with scope: :membership, url: url, class: 'group-assignment-form', data: { controller: 'group-assignment' } do |form| %>
  <%= form.hidden_field :person, value: TimeOff::GroupRoster.key(person) %>
  <div><%= form.label :group_code, 'Grupo', for: "#{prefix}_code" %><%= form.select :group_code, TimeOffSchedule::GROUPS.map { |group| [group == 'FIXO' ? 'Fixo' : "Grupo #{group}", group] }, { include_blank: true, selected: membership&.group_code }, id: "#{prefix}_code", required: true, class: 'form-select', data: { group_assignment_target: 'group', action: 'change->group-assignment#update' } %></div>
  <div><%= form.label :starts_on, 'Válido a partir de', for: "#{prefix}_start" %><%= form.date_field :starts_on, value: [date, schedule.starts_on, membership&.starts_on&.+(1)].compact.max, min: schedule.starts_on, id: "#{prefix}_start", required: true, class: 'form-control' %></div>
  <div data-group-assignment-target="fixed"><%= form.label :fixed_weekday, 'Folga do grupo Fixo', for: "#{prefix}_weekday" %><%= form.select :fixed_weekday, TimeOffSchedule::WEEKDAYS, { include_blank: 'A definir', selected: membership&.fixed_weekday }, id: "#{prefix}_weekday", class: 'form-select' %></div>
  <div data-group-assignment-target="fixed"><%= form.label :standard_operation, 'Operação fixa', for: "#{prefix}_operation" %><%= form.select :standard_operation, TimeOffMembership::STANDARD_OPERATIONS, { include_blank: 'Sem operação fixa', selected: membership&.standard_operation }, id: "#{prefix}_operation", class: 'form-select' %></div>
  <small>Folga e operação se aplicam ao grupo Fixo. As vigências anteriores ficam preservadas.</small>
  <div class="group-assignment-form__actions">
    <% if local_assigns[:in_dialog] %><button type="button" class="btn btn-outline-secondary" data-action="group-dialog#close">Cancelar</button><% end %>
    <%= form.submit 'Salvar grupo', class: 'btn btn-primary btn-sm' %>
  </div>
<% end %>
