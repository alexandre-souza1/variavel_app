<% prefix = "group_#{TimeOff::GroupRoster.key(person).tr(':', '_')}" %>
<%= form_with scope: :membership, url: membership ? local_assigns.fetch(:revision_url) : url, method: membership ? :patch : :post, class: 'group-assignment-form', data: { controller: 'group-assignment' } do |form| %>
  <%= form.hidden_field :person, value: TimeOff::GroupRoster.key(person) %>
  <% if membership %>
    <%= form.hidden_field :id, value: membership.id, id: "#{prefix}_membership" %>
    <%= form.hidden_field :expected_updated_at, value: membership.updated_at.iso8601(6), id: "#{prefix}_revision" %>
  <% end %>
  <div><%= form.label :group_code, 'Grupo', for: "#{prefix}_code" %><%= form.select :group_code, TimeOffSchedule::GROUPS.map { |group| [group == 'FIXO' ? 'Fixo' : "Grupo #{group}", group] }, { include_blank: true, selected: membership&.group_code }, id: "#{prefix}_code", required: true, class: 'form-select', data: { group_assignment_target: 'group', action: 'change->group-assignment#update' } %></div>
  <div><%= form.label :starts_on, 'Válido a partir de', for: "#{prefix}_start" %><%= form.date_field :starts_on, value: membership&.starts_on || [date, schedule.starts_on].max, min: schedule.starts_on, max: membership&.ends_on, id: "#{prefix}_start", required: true, class: 'form-control' %></div>
  <div data-group-assignment-target="fixed"><%= form.label :fixed_weekday, 'Folga do grupo Fixo', for: "#{prefix}_weekday" %><%= form.select :fixed_weekday, TimeOffSchedule::WEEKDAYS, { include_blank: 'A definir', selected: membership&.fixed_weekday }, id: "#{prefix}_weekday", class: 'form-select' %></div>
  <div data-group-assignment-target="fixed"><%= form.label :standard_operation, 'Operação fixa', for: "#{prefix}_operation" %><%= form.select :standard_operation, TimeOffMembership::STANDARD_OPERATIONS, { include_blank: 'Sem operação fixa', selected: membership&.standard_operation }, id: "#{prefix}_operation", class: 'form-select' %></div>
  <% if membership %>
    <div><%= form.label :reason, 'Motivo da correção', for: "#{prefix}_reason" %><%= form.text_area :reason, id: "#{prefix}_reason", required: true, maxlength: 500, rows: 2, class: 'form-control' %></div>
    <small>Você está corrigindo o vínculo existente. A correção fica registrada no histórico.</small>
  <% else %>
    <small>Folga e operação se aplicam ao grupo Fixo.</small>
  <% end %>
  <small><%= link_to 'Corrigir ou excluir vigência já cadastrada', time_off_schedule_path(tab: 'calendar', date: date, settings: 1, correction: 1, membership_id: membership&.id) %></small>
  <div class="group-assignment-form__actions">
    <% if local_assigns[:in_dialog] %><button type="button" class="btn btn-outline-secondary" data-action="group-dialog#close">Cancelar</button><% end %>
    <%= form.submit membership ? 'Salvar correção' : 'Salvar grupo', class: 'btn btn-primary btn-sm' %>
  </div>
<% end %>
