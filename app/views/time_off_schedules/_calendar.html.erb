<% context = { tab: 'calendar', month: @month.strftime('%Y-%m'), date: @date, role: @role, group: @group, name: @name_query, per_page: @per_page } %>
<section class="time-off-panel" id="time-off-calendar" aria-labelledby="calendar-heading">
    <div class="time-off-panel-heading"><div><h2 id="calendar-heading"><i class="bi bi-calendar3" aria-hidden="true"></i> <%= l(@month, format: '%B de %Y').capitalize %></h2><p>Selecione um dia para ajustar a escala. Cores identificam os grupos; • indica ajuste individual.</p></div>
      <nav aria-label="Navegação do calendário" class="time-off-month-navigation">
        <%= link_to calendar_month_path(-1), class: 'time-off-month-arrow', rel: 'prev', aria: { label: 'Mês anterior' }, title: 'Mês anterior' do %><i class="bi bi-chevron-left" aria-hidden="true"></i><% end %>
        <%= render 'date_picker', mode: 'month', date: @month %>
        <%= link_to calendar_month_path(1), class: 'time-off-month-arrow', rel: 'next', aria: { label: 'Próximo mês' }, title: 'Próximo mês' do %><i class="bi bi-chevron-right" aria-hidden="true"></i><% end %>
      </nav>
    </div>
    <%= form_with url: time_off_schedule_path, method: :get, class: 'time-off-calendar-filters', aria: { label: 'Filtros de colaboradores' }, data: { turbo_frame: 'time-off-calendar-content' } do |form| %>
      <% context.except(:name).merge(calendar_period: @calendar_period).each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
      <div class="time-off-search">
        <%= form.label :name, 'Buscar por nome', for: 'calendar-name', class: 'visually-hidden' %>
        <i class="bi bi-search" aria-hidden="true"></i>
        <%= form.search_field :name, value: @name_query, id: 'calendar-name', placeholder: 'Buscar colaborador…', autocomplete: 'off', data: { action: 'input->time-off#searchCalendar keydown.enter->time-off#submitCalendarSearch' } %>
        <button type="button" class="time-off-search-clear" aria-label="Limpar busca" data-action="time-off#clearCalendarSearch" <%= 'hidden' if @name_query.blank? %>><i class="bi bi-x-lg" aria-hidden="true"></i></button>
      </div>
      <div class="time-off-segmented time-off-role-picker" role="group" aria-label="Função">
        <% [['', 'Todos'], ['driver', 'Motoristas'], ['helper', 'Ajudantes']].each do |role, label| %>
          <%= button_tag label, type: 'button', class: 'time-off-segment', aria: { pressed: @role.to_s == role }, data: { action: 'time-off#filterCalendarRole', role: role } %>
        <% end %>
      </div>
    <% end %>
    <div class="time-off-legend">
      <span><b>T</b> Em escala</span><span><b>F</b> Folga</span><span><b>D</b> DSR</span><span><b>I</b> Indisponível</span><span><b>V</b> Férias</span><span><b>?</b> Folga fixa a definir</span><span>— Fora da vigência</span>
    </div>
    <%= turbo_frame_tag 'time-off-calendar-content', data: { turbo_action: 'advance', action: 'turbo:frame-load->time-off#syncCalendarContext' } do %>
    <%= render 'group_legend', context: context %>
    <div class="time-off-calendar-controls">
      <%= form_with url: time_off_schedule_path, method: :get, class: 'time-off-period-picker', role: 'group', aria: { label: 'Período do calendário' } do %>
        <% context.merge(page: @page).each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
        <% @periods.each do |period| %>
          <%= button_tag "#{period.first.strftime('%d')}–#{period.last.strftime('%d')}", name: 'calendar_period', value: period.first.iso8601, class: "btn btn-sm time-off-calendar-button #{@calendar_period == period.first.iso8601 ? 'btn-primary is-active' : 'btn-outline-secondary'}", aria: { pressed: @calendar_period == period.first.iso8601 } %>
        <% end %>
        <%= button_tag 'Mês inteiro', name: 'calendar_period', value: 'month', class: "btn btn-sm time-off-calendar-button #{@calendar_period == 'month' ? 'btn-primary is-active' : 'btn-outline-secondary'}", aria: { pressed: @calendar_period == 'month' } %>
      <% end %>
      <span><%= l(@month, format: '%B').capitalize %> · <%= pluralize(@total_rows, 'colaborador', 'colaboradores') %></span>
    </div>
    <div class="time-off-table-scroll" tabindex="0" role="region" aria-label="Calendário <%= @calendar_period == 'month' ? 'mensal' : 'semanal' %> de colaboradores">
      <table class="time-off-calendar" style="--calendar-days: <%= @days.size %>">
        <caption class="visually-hidden">Escala de <%= l(@days.first) %> a <%= l(@days.last) %></caption>
        <colgroup><col class="time-off-person-column"><% @days.size.times do %><col><% end %></colgroup>
        <thead><tr><th scope="col" class="time-off-person-cell">Colaborador</th>
          <% @days.each do |day| %><th scope="col" class="<%= 'is-selected' if day == @date %> <%= 'is-sunday' if day.sunday? %>"><%= link_to time_off_tab_path('day', date: day), aria: { label: "Acompanhar #{l(day)}" }, data: { turbo_frame: '_top' }, class: 'time-off-day-link' do %><strong><%= day.day.to_s.rjust(2, '0') %></strong><small><%= %w[dom seg ter qua qui sex sáb][day.wday] %></small><% end %></th><% end %>
        </tr><tr class="time-off-original"><th scope="row" class="time-off-person-cell">Folga original do grupo</th>
          <% @days.each do |day| %><td class="<%= 'is-selected' if day == @date %>"><% group = @schedule.off_group_on(day) %><% if group %><span class="time-off-group time-off-group--<%= group %>"><%= group %></span><% elsif @schedule.covers?(day) && day.sunday? %>DSR<% else %>—<% end %></td><% end %>
        </tr></thead>
        <tbody>
          <% @calendar_memberships.each_with_index do |member, index| %><tr class="<%= 'time-off-calendar-group-start' if index.positive? && @calendar_memberships[index - 1].group_code != member.group_code %>">
            <th scope="row" class="time-off-person-cell"><div class="time-off-person-name"><span class="time-off-group time-off-group--<%= member.group_code %>"><%= member.group_code %></span><span><strong title="<%= member.person.nome %>"><%= member.person.nome %></strong><small><%= member.role_label(@date) %> · <%= member.code_on(@date) %> · <%= pluralize(@extras.dates(member).size, 'extra', 'extras') %><% if member.ends_on %> · até <%= l(member.ends_on) %><% end %></small></span></div></th>
            <% @days.each do |day| %>
              <% base = @schedule.base_status(member, day); override = base ? @availability.override(member, day) : nil; status = base && status_for(member, day); vacation = base && @availability.vacation(member, day) %>
              <td class="<%= 'is-selected' if day == @date %> <%= 'is-sunday' if day.sunday? %>">
                <%= link_to time_off_tab_path('day', date: day), data: { turbo_frame: '_top' }, class: "time-off-cell time-off-cell--#{status || 'none'} #{"time-off-group--#{member.group_code}" if status == 'off'}", title: "#{member.person.nome}: #{TimeOffSchedule::STATUSES[status] || 'Fora da vigência'}#{vacation ? " · #{l(vacation.starts_on)} a #{l(vacation.ends_on)} · #{vacation.reason}" : (" · #{override.reason}" if override)}", aria: { label: "#{member.person.nome}, #{l(day)}: #{TimeOffSchedule::STATUSES[status] || 'Fora da vigência'}" } do %>
                  <span class="time-off-cell-label"><%= { 'working' => 'T', 'off' => 'F', 'dsr' => 'D', 'unavailable' => 'I', 'vacation' => 'V', 'pending' => '?' }[status] || '—' %><% if override && override.status != base && status != 'vacation' %><sup>•</sup><% end %></span>
                <% end %>
              </td>
            <% end %>
          </tr><% end %>
          <% if @calendar_memberships.empty? %><tr><td colspan="<%= @days.size + 1 %>" class="time-off-empty">Nenhum colaborador encontrado para os filtros selecionados.</td></tr><% end %>
        </tbody>
      </table>
    </div>
    <div class="time-off-calendar-pagination">
      <div class="time-off-calendar-count">
        <p aria-live="polite"><%= @total_rows.zero? ? 0 : (@page - 1) * @per_page + 1 %>–<%= [@page * @per_page, @total_rows].min %> de <%= @total_rows %> colaboradores</p>
        <%= form_with url: time_off_schedule_path, method: :get, class: 'time-off-row-picker', aria: { label: 'Linhas por página' } do %>
          <% context.except(:per_page).merge(calendar_period: @calendar_period).each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
          <span>Linhas</span>
          <div class="time-off-segmented" role="group" aria-label="Quantidade de linhas">
            <% TimeOffSchedulesController::CALENDAR_PAGE_SIZES.each do |size| %>
              <%= button_tag size.to_s, name: 'per_page', value: size, class: 'time-off-segment', aria: { pressed: @per_page == size, label: "#{size} linhas por página" } %>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= form_with url: time_off_schedule_path, method: :get, class: 'time-off-calendar-actions', aria: { label: 'Paginação de colaboradores' } do %>
        <% context.merge(calendar_period: @calendar_period).each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
        <%= button_tag 'Anterior', name: 'page', value: @page - 1, disabled: @page == 1, class: 'time-off-pagination-button time-off-calendar-button' %>
        <span aria-live="polite" aria-label="Página <%= @page %> de <%= @total_pages %>"><%= @page %> / <%= @total_pages %></span>
        <%= button_tag 'Próxima', name: 'page', value: @page + 1, disabled: @page == @total_pages, class: 'time-off-pagination-button time-off-calendar-button' %>
      <% end %>
    </div>
    <% end %>
  </section>
