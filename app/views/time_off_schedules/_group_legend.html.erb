<div class="time-off-group-legend" aria-label="Grupos do piloto e folgas originais">
  <% TimeOffSchedule::GROUPS.each do |group| %>
    <div class="time-off-group-summary"><span class="time-off-group time-off-group--<%= group %>">Grupo <%= group %></span><small><%= @memberships.count { |m| m.group_code == group && m.covers?(@date) } %> no dia</small>
      <div class="time-off-group-dates"><% @month_days.select { |day| group == 'FIXO' ? @schedule.covers?(day) && @memberships.any? { |m| m.group_code == 'FIXO' && m.covers?(day) && m.fixed_weekday == day.cwday } : @schedule.off_group_on(day) == group }.each do |day| %><%= link_to day.strftime('%d/%m'), time_off_tab_path('day', date: day, group: group), title: l(day, format: '%A') %><% end %></div>
    </div>
  <% end %>
</div>
