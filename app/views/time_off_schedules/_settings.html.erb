<% if can_edit? %>
  <div class="offcanvas offcanvas-end time-off-config" tabindex="-1" id="time-off-settings" aria-labelledby="settings-heading" data-time-off-target="settings">
    <div class="offcanvas-header"><h2 id="settings-heading">Configuração da escala</h2><button type="button" class="btn-close" aria-label="Fechar configuração" data-action="time-off#closeSettings"></button></div>
    <div class="offcanvas-body">
      <%= render 'membership_correction' %>
      <%= render 'vacations' %>
    <% if @pilot_pending.any? %><div class="time-off-notice"><strong>Composição do piloto a completar</strong><ul class="mt-2 mb-0"><% @pilot_pending.each do |entry| %><li>Grupo <%= entry['group'] %> · <%= entry['name'] %> · <%= entry['role'] == 'driver' ? 'Motorista' : 'Ajudante' %><%= entry['vacancy'] ? ' — vaga a preencher' : ' — vincule ao cadastro correspondente' %></li><% end %></ul></div><% end %>
    </div>
  </div>
<% end %>
