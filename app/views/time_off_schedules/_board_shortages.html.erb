<% metrics = @board.metrics %>
<div class="time-off-metrics time-off-shortage-summary <%= 'has-shortage' if metrics[:driver_gap].positive? || metrics[:helper_gap].positive? %>" role="status" aria-live="polite" data-time-off-board-target="shortageSummary">
  <div><i class="bi bi-truck" aria-hidden="true"></i><span><strong data-time-off-board-target="carCount"><%= metrics[:cars] %></strong> saídas previstas</span><small><%= metrics[:dimensioned_cars] %> posições dimensionadas</small></div>
  <div data-shortage-card class="<%= 'is-missing' if metrics[:driver_gap].positive? %>"><i class="bi bi-person-exclamation" aria-hidden="true"></i><span><strong data-time-off-board-target="driverGap"><%= metrics[:driver_gap] %></strong> <span data-shortage-label="driver"><%= metrics[:driver_gap] == 1 ? 'motorista faltando' : 'motoristas faltando' %></span></span><small><span data-time-off-board-target="driverCount"><%= metrics[:drivers] %> / <%= metrics[:cars] %></span> posições preenchidas</small></div>
  <div data-shortage-card class="<%= 'is-missing' if metrics[:helper_gap].positive? %>"><i class="bi bi-people" aria-hidden="true"></i><span><strong data-time-off-board-target="helperGap"><%= metrics[:helper_gap] %></strong> <span data-shortage-label="helper"><%= metrics[:helper_gap] == 1 ? 'ajudante faltando' : 'ajudantes faltando' %></span></span><small>Somente vagas previstas na composição</small></div>
</div>
