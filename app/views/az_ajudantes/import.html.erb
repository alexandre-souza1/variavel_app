<div class="container-fluid py-4 px-3 px-lg-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <p class="text-uppercase text-muted small fw-semibold mb-1">Armazém</p>
      <h1 class="h3 mb-1">Importar ajudantes</h1>
      <p class="text-muted mb-0">Atualize vários cadastros de uma vez usando um arquivo CSV.</p>
    </div>
    <%= link_to "Voltar para ajudantes", az_ajudantes_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="row g-4">
    <div class="col-xl-8">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-lg-5">
          <%= form_with url: import_csv_az_ajudantes_path, local: true, multipart: true do %>
            <div class="mb-4">
              <%= label_tag :file, "Arquivo CSV", class: "form-label fw-semibold" %>
              <%= file_field_tag :file, class: "form-control", accept: ".csv,text/csv", required: true %>
              <div class="form-text">Use ponto e vírgula (;) como separador. Registros com a mesma matrícula serão atualizados.</div>
            </div>
            <%= submit_tag "Importar arquivo", class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-xl-4">
      <div class="card border-0 bg-light h-100">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-muted mb-3">Colunas esperadas</h2>
          <ul class="small text-muted mb-0">
            <li><code>matricula</code> — obrigatória</li>
            <li><code>nome</code> — obrigatória</li>
            <li><code>turno</code> — A, B ou C</li>
            <li><code>cpf</code> — opcional</li>
            <li><code>data_nascimento</code> — opcional, de preferência DD/MM/AAAA</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
