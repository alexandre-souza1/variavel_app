<div class="app-page">
  <div class="app-page-header">
    <div>
      <p class="text-uppercase text-muted small fw-semibold mb-1">Armazém</p>
      <h1 class="h3 mb-1"><i class="bi bi-person-vcard me-2"></i>Ajudantes AZ</h1>
      <p class="text-muted mb-0">Cadastre a matrícula e o turno usados na consulta de remuneração variável.</p>
    </div>

    <div class="app-page-actions">
      <% if current_user.admin? || current_user.supervisor? %>
        <%= link_to import_az_ajudantes_path, class: "btn btn-outline-primary" do %>
          <i class="bi bi-upload me-1"></i> Importar CSV
        <% end %>
        <%= link_to new_az_ajudante_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg me-1"></i> Novo ajudante
        <% end %>
      <% end %>
      <%= link_to "Voltar para consultas", az_consultas_new_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <%= render "shared/flashes" if lookup_context.exists?("shared/flashes", [], true) %>

  <div class="app-table-section">
    <div class="app-table-section__body">
      <% if @az_ajudantes.any? %>
        <div class="table-responsive">
          <div class="app-table-shell"><table class="table app-table app-table--data mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Matrícula</th>
                <th>Nome</th>
                <th>Turno</th>
                <th>CPF</th>
                <th class="text-end pe-4">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% @az_ajudantes.each do |az_ajudante| %>
                <tr>
                  <td class="ps-4 fw-semibold"><%= az_ajudante.matricula %></td>
                  <td><%= az_ajudante.nome %></td>
                  <td><span class="badge text-bg-light"><%= turno_label(az_ajudante.turno) %></span></td>
                  <td><%= az_ajudante.cpf.presence || "—" %></td>
                  <td class="text-end pe-4">
                    <%= link_to az_ajudante, class: "icon-btn", title: "Ver ajudante AZ", aria: { label: "Ver ajudante AZ" } do %>
                      <i class="bi bi-eye" aria-hidden="true"></i>
                    <% end %>
                    <% if current_user.admin? || current_user.supervisor? %>
                      <%= link_to edit_az_ajudante_path(az_ajudante), class: "icon-btn", title: "Editar ajudante AZ", aria: { label: "Editar ajudante AZ" } do %>
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                      <% end %>
                    <% end %>
                    <% if current_user.admin? %>
                      <%= button_to az_ajudante, method: :delete, class: "icon-btn danger", title: "Inativar ajudante AZ", aria: { label: "Inativar ajudante AZ" }, form: { class: "d-inline" }, data: { turbo_confirm: "Inativar este ajudante? O histórico será preservado." } do %>
                        <i class="bi bi-archive" aria-hidden="true"></i>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table></div>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-people fs-1 d-block mb-3"></i>
          <p class="mb-3">Nenhum ajudante cadastrado.</p>
          <% if current_user.admin? || current_user.supervisor? %>
            <%= link_to "Importar ajudantes", import_az_ajudantes_path, class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if current_user.admin? && @az_ajudantes.any? %>
    <div class="text-end mt-3">
      <%= button_to "Inativar todos", destroy_all_az_ajudantes_path, method: :delete, class: "btn btn-sm btn-outline-warning", data: { turbo_confirm: "Inativar todos os ajudantes? O histórico será preservado." } %>
    </div>
  <% end %>
</div>
