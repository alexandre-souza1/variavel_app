<div class="container-fluid py-4 px-3 px-lg-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <p class="text-uppercase text-muted small fw-semibold mb-1">Armazém / Ajudantes</p>
      <h1 class="h3 mb-1"><%= @az_ajudante.nome %></h1>
      <p class="text-muted mb-0">Matrícula <%= @az_ajudante.matricula %></p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Voltar", az_ajudantes_path, class: "btn btn-outline-secondary" %>
      <% if current_user.admin? || current_user.supervisor? %>
        <%= link_to "Editar", edit_az_ajudante_path(@az_ajudante), class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-muted mb-4">Dados cadastrais</h2>
          <div class="row g-4">
            <div class="col-sm-6"><span class="small text-muted d-block">Matrícula</span><strong><%= @az_ajudante.matricula %></strong></div>
            <div class="col-sm-6"><span class="small text-muted d-block">Turno</span><strong><%= turno_label(@az_ajudante.turno) %></strong></div>
            <div class="col-sm-6"><span class="small text-muted d-block">CPF</span><strong><%= @az_ajudante.cpf.presence || "Não informado" %></strong></div>
            <div class="col-sm-6"><span class="small text-muted d-block">Data de nascimento</span><strong><%= @az_ajudante.data_nascimento.present? ? l(@az_ajudante.data_nascimento) : "Não informada" %></strong></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-primary-subtle bg-primary-subtle shadow-sm h-100">
        <div class="card-body p-4 d-flex flex-column">
          <i class="bi bi-bar-chart-line fs-3 text-primary mb-3"></i>
          <h2 class="h5">Consultar remuneração variável</h2>
          <p class="text-muted small">Abra a consulta já preenchida com a matrícula deste ajudante.</p>
          <%= link_to "Abrir consulta", az_consulta_path(perfil: "ajudante", matricula: @az_ajudante.matricula), class: "btn btn-primary mt-auto" %>
        </div>
      </div>
    </div>
  </div>
</div>
