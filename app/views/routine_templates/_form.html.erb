<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-file-earmark-plus fs-2 text-primary"></i>
        <h2 class="fw-bold mb-0">
          <%= routine_template.new_record? ? 'Novo Template' : 'Editar Template' %>
        </h2>
      </div>

      <%= form_with model: routine_template, class: "card shadow-sm p-4" do |f| %>

        <% if routine_template.errors.any? %>
          <div class="alert alert-danger">
            <h5><%= pluralize(routine_template.errors.count, "erro") %> impediu o salvamento:</h5>
            <ul class="mb-0">
              <% routine_template.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :name, class: "form-label fw-semibold" do %>
            <i class="bi bi-tag me-1"></i> Nome <span class="text-danger">*</span>
          <% end %>
          <%= f.text_field :name,
                           class: "form-control form-control-lg",
                           placeholder: "Ex: Rotina de Vendas Semanal",
                           autofocus: true %>
          <small class="text-muted">Escolha um nome descritivo para o template.</small>
        </div>

        <div class="mb-3">
          <%= f.label :description, class: "form-label fw-semibold" do %>
            <i class="bi bi-card-text me-1"></i> Descrição
          <% end %>
          <%= f.text_area :description,
                          rows: 4,
                          class: "form-control",
                          placeholder: "Descreva o propósito e uso deste template..." %>
        </div>

        <div class="mb-4">
          <%= f.label :sector, class: "form-label fw-semibold" do %>
            <i class="bi bi-diagram-3 me-1"></i> Setor do template
          <% end %>

          <div class="row g-3">
            <% User::USER_SECTORS.each do |label, value| %>
              <% selected = routine_template.sector == value.to_s %>
              <div class="col-md-6 col-xl-4">
                <label class="d-block w-100">
                  <%= f.radio_button :sector, value, checked: selected, class: "btn-check" %>
                  <span class="d-flex align-items-center justify-content-between w-100 px-3 py-2 border rounded-3 bg-body <%= selected ? 'border-primary shadow-sm' : 'border-secondary-subtle' %>">
                    <span class="fw-medium"><%= label %></span>
                    <i class="bi <%= selected ? 'bi-record-circle-fill text-primary' : 'bi-circle text-secondary' %>"></i>
                  </span>
                </label>
              </div>
            <% end %>
          </div>

          <small class="text-muted d-block mt-2">Usuários do setor selecionado enxergam este template e suas rotinas.</small>
        </div>

        <div class="form-check form-switch mb-4">
          <%= f.check_box :active,
                          class: "form-check-input",
                          role: "switch" %>
          <%= f.label :active,
                      class: "form-check-label fw-semibold" do %>
            <i class="bi bi-check-circle me-1"></i> Ativo
          <% end %>
          <small class="d-block text-muted">Templates inativos não aparecem na lista de geração.</small>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit class: "btn btn-primary btn-lg px-4" %>
          <%= link_to "Cancelar", routine_templates_path, class: "btn btn-outline-secondary btn-lg" %>
        </div>

      <% end %>

    </div>
  </div>
</div>
