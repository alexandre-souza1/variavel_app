<div class="container py-4">

  <!-- ========== CABEÇALHO ========== -->
  <div class="d-flex flex-wrap flex-md-nowrap justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <h2 class="fw-bold mb-0 d-flex align-items-center gap-2">
          <i class="bi bi-file-earmark-text text-primary"></i>
          <%= @routine_template.name %>
        </h2>
        <span class="badge <%= @routine_template.active? ? 'bg-success' : 'bg-secondary' %>">
          <%= @routine_template.active? ? 'Ativo' : 'Inativo' %>
        </span>
      </div>
      <p class="text-muted mb-2">
        <%= @routine_template.description.presence || 'Sem descrição' %>
      </p>
      <div class="d-flex flex-wrap gap-3 small text-muted">
        <span><i class="bi bi-calendar3 me-1"></i> Criado em <%= l(@routine_template.created_at.to_date, format: :long) %></span>
        <span><i class="bi bi-folder me-1"></i> <%= @routine_template.routine_categories.count %> categorias</span>
        <span><i class="bi bi-clock-history me-1"></i> <%= @routine_template.routines.count %> rotinas geradas</span>
      </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <%= link_to new_routine_template_generator_path(@routine_template), class: "btn btn-success d-flex align-items-center gap-1" do %>
        <i class="bi bi-play-fill"></i> Gerar Rotina
      <% end %>
      <%= link_to new_routine_template_routine_category_path(@routine_template), class: "btn btn-primary d-flex align-items-center gap-1" do %>
        <i class="bi bi-plus-lg"></i> Nova Categoria
      <% end %>
      <%= link_to edit_routine_template_path(@routine_template), class: "btn btn-outline-secondary d-flex align-items-center gap-1" do %>
        <i class="bi bi-pencil"></i> Editar
      <% end %>
    </div>
  </div>

  <!-- ========== LISTA DE CATEGORIAS ========== -->
  <% if @routine_template.routine_categories.any? %>

    <div class="row g-4">

      <% @routine_template.routine_categories.order(:position).each do |category| %>

        <div class="col-12">
          <div class="card shadow-sm border-0 transition-hover">

            <!-- Cabeçalho da categoria -->
            <div class="card-header bg-light bg-opacity-50 d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
              <div class="d-flex align-items-center gap-3">
                <i class="bi bi-folder2-open text-primary fs-5"></i>
                <h5 class="fw-semibold mb-0"><%= category.name %></h5>
                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                  <i class="bi bi-bar-chart me-1"></i> <%= category.routine_indicators.count %> indicadores
                </span>
              </div>
              <div class="d-flex gap-2">
                <%= link_to new_routine_template_routine_category_routine_indicator_path(@routine_template, category), class: "btn btn-sm btn-primary d-flex align-items-center gap-1" do %>
                  <i class="bi bi-plus-circle"></i> Indicador
                <% end %>
                <%= link_to edit_routine_template_routine_category_path(@routine_template, category), class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
                  <i class="bi bi-pencil"></i>
                <% end %>
                <%= button_to routine_template_routine_category_path(@routine_template, category), method: :delete, class: "btn btn-sm btn-outline-danger d-flex align-items-center gap-1", form: { data: { turbo_confirm: "Tem certeza que deseja excluir esta categoria e seus indicadores?" } } do %>
                  <i class="bi bi-trash3"></i>
                <% end %>
              </div>
            </div>

            <!-- Corpo (lista de indicadores) -->
            <div class="card-body p-0">
              <% if category.routine_indicators.any? %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                      <tr>
                        <th class="ps-3">Indicador</th>
                        <th>Tipo</th>
                        <th>Cálculo</th>
                        <th>Preenchimento</th>
                        <th class="text-end pe-3">Ações</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% category.routine_indicators.order(:position).each do |indicator| %>
                        <tr>
                          <td class="ps-3 fw-medium"><%= indicator.name %></td>
                          <td>
                            <span class="badge bg-info bg-opacity-10 text-info">
                              <%= indicator.value_type_label.humanize %>
                            </span>
                          </td>
                          <td>
                            <span class="badge bg-warning bg-opacity-10 text-warning">
                              <%= indicator.calculation_type_label.humanize %>
                            </span>
                          </td>
                          <td>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                              <%= RoutineIndicator::RESPONSE_FREQUENCY_LABELS[indicator.response_frequency] %>
                            </span>
                          </td>
                          <td class="text-end pe-3 d-flex justify-content-end gap-2">
                            <div class="d-flex justify-content-end gap-2">

                              <%= link_to "Metas",
                                  routine_template_routine_category_routine_indicator_routine_indicator_targets_path(
                                    @routine_template,
                                    category,
                                    indicator
                                  ),
                                  class: "btn btn-sm btn-outline-primary" %>

                              <%= link_to "Editar",
                                  edit_routine_template_routine_category_routine_indicator_path(
                                    @routine_template,
                                    category,
                                    indicator
                                  ),
                                  class: "btn btn-sm btn-outline-secondary" %>

                            </div>
                            <%= button_to routine_template_routine_category_routine_indicator_path(@routine_template, category, indicator), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Tem certeza?" } } do %>
                              <i class="bi bi-trash3"></i>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <div class="text-center py-4 text-muted">
                  <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                  Nenhum indicador cadastrado nesta categoria.
                </div>
              <% end %>
            </div>

            <!-- Rodapé com ação rápida (opcional) -->
            <div class="card-footer bg-transparent border-top-0 py-2 d-flex justify-content-end">
              <small class="text-muted">
                <i class="bi bi-arrows-expand me-1"></i> Posição: <%= category.position || '—' %>
              </small>
            </div>

          </div>
        </div>

      <% end %>

    </div>

  <% else %>

    <!-- Empty state para categorias -->
    <div class="text-center py-5 my-4">
      <i class="bi bi-folder-plus display-1 text-muted"></i>
      <h4 class="fw-light mt-3">Nenhuma categoria cadastrada</h4>
      <p class="text-muted mb-4">
        Comece criando a primeira categoria para este template.
      </p>
      <%= link_to new_routine_template_routine_category_path(@routine_template), class: "btn btn-primary btn-lg" do %>
        <i class="bi bi-plus-circle me-1"></i> Criar Categoria
      <% end %>
    </div>

  <% end %>

  <!-- Link para voltar -->
  <div class="mt-4">
    <%= link_to routine_templates_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i> Voltar para Templates
    <% end %>
  </div>

</div>

<!-- ========== CSS ADICIONAL ========== -->
<style>
  .transition-hover {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .transition-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1.2rem rgba(0,0,0,0.08) !important;
  }
  .table-hover tbody tr:hover {
    background-color: rgba(13, 110, 253, 0.04);
  }
  .card-header .btn-group .btn {
    position: relative;
    z-index: 2;
  }
  .badge.bg-opacity-10 {
    background-color: rgba(var(--bs-info-rgb), 0.1) !important;
  }
  /* Ajuste para os botões de ação dentro da tabela */
  .table .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
  }
</style>
