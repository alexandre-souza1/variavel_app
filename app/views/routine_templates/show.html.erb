<div class="template-show-page">

  <!-- ========== CABEÇALHO ========== -->
  <header class="template-show-header">
    <div class="header-content">
      <div>
        <div class="title-group">
          <h1>
            <i class="bi bi-file-earmark-text"></i>
            <%= @routine_template.name %>
          </h1>
          <span class="status-badge <%= @routine_template.active? ? 'active' : 'inactive' %>">
            <%= @routine_template.active? ? 'Ativo' : 'Inativo' %>
          </span>
        </div>
        <p class="subtitle">
          <%= @routine_template.description.presence || 'Sem descrição' %>
        </p>
        <div class="meta-info text-muted">
          <span><i class="bi bi-calendar3"></i> Criado em <%= l(@routine_template.created_at.to_date, format: :long) %></span>
          <br>
          <span><i class="bi bi-folder"></i> <%= @routine_template.routine_categories.count %> categorias</span>
          <br>
          <span><i class="bi bi-clock-history"></i> <%= @routine_template.routines.count %> rotinas geradas</span>
        </div>
      </div>
      <div class="header-actions">
        <%= link_to routine_templates_path, class: "btn-outline" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Voltar
        <% end %>
        <%= link_to new_routine_template_generator_path(@routine_template), class: "btn-primary-solid" do %>
          <i class="bi bi-play-fill"></i> Gerar Rotina
        <% end %>
        <%= link_to edit_routine_template_path(@routine_template), class: "btn-primary-solid" do %>
          <i class="bi bi-pencil"></i> Editar
        <% end %>
      </div>
    </div>
  </header>

  <!-- ========== LISTA DE CATEGORIAS ========== -->
  <section class="categories-section">

    <% if @routine_template.routine_categories.any? %>

      <div class="categories-grid">

        <% @routine_template.routine_categories.order(:position).each do |category| %>

          <div class="category-card">
            <!-- Cabeçalho da categoria -->
            <div class="category-header">
              <div class="category-title">
                <i class="bi bi-folder2-open"></i>
                <h3><%= category.name %></h3>
                <span class="indicator-count">
                  <i class="bi bi-bar-chart"></i> <%= category.routine_indicators.count %>
                </span>
              </div>
              <div class="category-actions">
                <%= link_to new_routine_template_routine_category_routine_indicator_path(@routine_template, category), class: "icon-btn", title: "Novo indicador" do %>
                  <i class="bi bi-plus-circle"></i>
                <% end %>
                <%= link_to edit_routine_template_routine_category_path(@routine_template, category), class: "icon-btn", title: "Editar categoria" do %>
                  <i class="bi bi-pencil"></i>
                <% end %>
                <%= button_to routine_template_routine_category_path(@routine_template, category), method: :delete, class: "icon-btn danger", form: { data: { turbo_confirm: "Tem certeza que deseja excluir esta categoria e seus indicadores?" } }, title: "Excluir" do %>
                  <i class="bi bi-trash3"></i>
                <% end %>
              </div>
            </div>

            <!-- Lista de indicadores -->
            <div class="indicators-list">
              <% if category.routine_indicators.any? %>
                <% category.routine_indicators.order(:position).each do |indicator| %>
                  <div class="indicator-item">
                    <div class="indicator-main">
                      <span class="indicator-name"><%= indicator.name %></span>
                      <div class="indicator-tags">
                        <span class="tag tag-type"><%= indicator.value_type_label.humanize %></span>
                        <span class="tag tag-calc"><%= indicator.calculation_type_label.humanize %></span>
                        <span class="tag tag-freq"><%= RoutineIndicator::RESPONSE_FREQUENCY_LABELS[indicator.response_frequency] %></span>
                      </div>
                    </div>
                    <div class="indicator-actions">
                      <%= link_to "Metas",
                          routine_template_routine_category_routine_indicator_routine_indicator_targets_path(
                            @routine_template, category, indicator
                          ),
                          class: "link-action" %>
                      <%= link_to "Editar",
                          edit_routine_template_routine_category_routine_indicator_path(
                            @routine_template, category, indicator
                          ),
                          class: "link-action" %>
                      <%= button_to routine_template_routine_category_routine_indicator_path(@routine_template, category, indicator),
                          method: :delete,
                          class: "link-action danger",
                          form: { data: { turbo_confirm: "Tem certeza?" } } do %>
                        <i class="bi bi-trash3"></i>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="empty-indicators">
                  <i class="bi bi-inbox"></i>
                  <span>Nenhum indicador nesta categoria</span>
                </div>
              <% end %>
            </div>

            <!-- Rodapé com posição (editável inline) -->
            <div class="category-footer">
              <div data-controller="inline-edit">
                <div data-inline-edit-target="display">
                  <button type="button" data-action="click->inline-edit#edit" class="position-edit-btn">
                    <i class="bi bi-arrows-expand"></i> Posição: <%= category.position %>
                  </button>
                </div>
                <div data-inline-edit-target="form" class="d-none">
                  <%= form_with model: [@routine_template, category] do |f| %>
                    <div class="position-form">
                      <%= f.select :position, options_for_select(0..(@routine_template.routine_categories.count)), { prompt: "Posição" }, { class: "position-select" } %>
                      <button class="btn-save-position">Salvar</button>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

        <% end %>

        <!-- ===== CARD PARA ADICIONAR NOVA CATEGORIA ===== -->
        <div class="category-card add-category-card" data-controller="collapsible">
          <div class="add-category-trigger" data-action="click->collapsible#toggle">
            <i class="bi bi-plus-circle"></i>
            <span>Adicionar nova categoria</span>
          </div>
          <div class="add-category-form" data-collapsible-target="content">
            <%= form_with model: [@routine_template, RoutineCategory.new] do |f| %>
              <div class="form-row">
                <div class="form-group">
                  <%= f.label :name, "Nome da categoria" %>
                  <%= f.text_field :name, class: "form-control-custom", placeholder: "Ex: Indicadores Financeiros" %>
                </div>
                <div class="form-group small">
                  <%= f.label :position, "Posição" %>
                  <%= f.select :position, options_for_select(0..(@routine_template.routine_categories.count + 1)), { prompt: "Selecione" }, { class: "form-control-custom" } %>
                </div>
                <div class="form-group actions">
                  <%= f.submit "Adicionar", class: "btn-primary-solid" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

      </div>

    <% else %>

      <!-- Estado vazio (sem categorias) -->
      <div class="empty-state">
        <i class="bi bi-folder-plus"></i>
        <h4>Nenhuma categoria cadastrada</h4>
        <p>Comece criando a primeira categoria para este template.</p>
        <%= link_to new_routine_template_routine_category_path(@routine_template), class: "btn-primary-solid" do %>
          <i class="bi bi-plus-circle"></i> Criar Categoria
        <% end %>
      </div>

    <% end %>

  </section>

  <!-- Link voltar -->
  <div class="back-link">
    <%= link_to routine_templates_path do %>
      <i class="bi bi-arrow-left"></i> Voltar para Templates
    <% end %>
  </div>

</div>
