<div class="templates-page">

  <!-- ========== CABEÇALHO ========== -->
  <header class="templates-header">
    <div class="header-content">
      <div>
        <h1>
          <i class="bi bi-layout-text-window"></i>
          Templates de Rotina
        </h1>
        <p class="subtitle">Modelos utilizados para gerar as rotinas diárias</p>
      </div>
      <div class="header-actions">
        <%= form_tag routine_templates_path, method: :get, class: "search-form" do %>
          <%= text_field_tag :search, params[:search], placeholder: "Filtrar templates...", class: "search-input" %>
          <%= submit_tag "Buscar", name: nil, class: "btn-search" %>
        <% end %>
        <%= link_to new_routine_template_path, class: "btn-primary-solid" do %>
          <i class="bi bi-plus-lg"></i> Novo Template
        <% end %>
      </div>
    </div>
  </header>

  <!-- ========== GRADE DE TEMPLATES ========== -->
  <% if @routine_templates.any? %>

    <div class="templates-grid">
      <% @routine_templates.each do |template| %>

        <div class="template-card">
          <%= link_to template, class: "card-link" do %>
            <div class="card-body">
              <!-- Cabeçalho do card -->
              <div class="card-header-row">
                <div class="card-title-group">
                  <i class="bi bi-file-earmark-richtext"></i>
                  <h3><%= template.name %></h3>
                </div>
                <span class="status-badge <%= template.active? ? 'active' : 'inactive' %>">
                  <%= template.active? ? 'Ativo' : 'Inativo' %>
                </span>
              </div>

              <!-- Descrição -->
              <p class="card-description">
                <%= template.description.presence || 'Sem descrição' %>
              </p>

              <!-- Rodapé do card -->
              <div class="card-footer-row">
                <div class="meta-info">
                  <span><i class="bi bi-calendar3"></i> <%= l(template.created_at.to_date, format: :short) %></span>
                  <span><i class="bi bi-list-task"></i> <%= template.routines.count %> rotinas</span>
                </div>
                <div class="card-actions" onclick="event.stopPropagation();">
                  <%= link_to edit_routine_template_path(template), class: "icon-btn", title: "Editar" do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  <%= button_to routine_template_path(template), method: :delete, class: "icon-btn danger", form: { data: { turbo_confirm: "Tem certeza?" } }, title: "Excluir" do %>
                    <i class="bi bi-trash3"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

      <% end %>
    </div>

    <!-- Paginação (caso exista) -->
    <% if @routine_templates.respond_to?(:total_pages) && @routine_templates.total_pages > 1 %>
      <div class="pagination-wrapper">
        <%= paginate @routine_templates %>
      </div>
    <% end %>

  <% else %>

    <!-- Estado vazio -->
    <div class="empty-state">
      <i class="bi bi-file-earmark-plus"></i>
      <h4>Nenhum template cadastrado</h4>
      <p>Crie seu primeiro modelo de rotina e comece a organizar seus processos.</p>
      <%= link_to new_routine_template_path, class: "btn-primary-solid" do %>
        <i class="bi bi-plus-circle"></i> Criar Template
      <% end %>
    </div>

  <% end %>

</div>
