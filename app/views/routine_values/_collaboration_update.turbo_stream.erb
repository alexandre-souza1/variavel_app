<% indicator = routine_value.routine_indicator %>

<% calculation = Routines::CalculationService.call(
     routine: routine_value.routine,
     indicator: indicator
   ) %>

<%= turbo_stream.replace "routine-value-display-#{routine_value.id}" do %>

  <%= render "routines/value_display", routine_value: routine_value, indicator: indicator %>

<% end %>

<%= turbo_stream.replace "routine-result-#{indicator.id}" do %>

  <td
    id="routine-result-<%= indicator.id %>"
    class="text-center result-value"
    data-routine-result-indicator-id="<%= indicator.id %>">

    <%= render "routines/result_status",
               indicator: indicator,
               calculation: calculation %>

  </td>

<% end %>
