<div class="container py-4">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
      <p class="text-uppercase small fw-bold text-primary mb-1">Financeiro · Integrações</p>
      <h1 class="h3 mb-2">Importação de invoices por e-mail</h1>
      <p class="text-muted mb-0">Defina os padrões usados nas notas de abastecimento recebidas.</p>
    </div>
    <%= link_to invoices_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left"></i> Voltar para invoices
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-4">
      <% if @setting.errors.any? %>
        <div class="alert alert-danger"><%= @setting.errors.full_messages.to_sentence %></div>
      <% end %>

      <%= form_with model: @setting, url: invoice_email_import_setting_path, method: :patch, local: true do |f| %>
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :sender_email, "Remetente autorizado", class: "form-label" %>
            <%= f.email_field :sender_email, class: "form-control", required: true %>
          </div>
          <div class="col-md-3">
            <%= f.label :imap_folder, "Pasta IMAP", class: "form-label" %>
            <%= f.text_field :imap_folder, class: "form-control", required: true %>
          </div>
          <div class="col-md-3">
            <%= f.label :schedule_time, "Horário automático", class: "form-label" %>
            <%= f.time_field :schedule_time, value: @setting.schedule_time, class: "form-control", required: true %>
          </div>
          <div class="col-md-4">
            <%= f.label :purchaser_id, "Responsável padrão", class: "form-label" %>
            <%= f.collection_select :purchaser_id, @purchasers, :id, :name,
                                    { prompt: "Selecione o responsável" }, class: "form-select", required: true %>
          </div>
          <div class="col-md-4">
            <%= f.label :budget_category_id, "Categoria padrão", class: "form-label" %>
            <%= f.collection_select :budget_category_id, @budget_categories, :id, :name,
                                    { prompt: "Selecione a categoria" }, class: "form-select", required: true %>
          </div>
          <div class="col-md-4">
            <%= f.label :fallback_cost_center_id, "Centro de custo fallback", class: "form-label" %>
            <%= f.collection_select :fallback_cost_center_id, @cost_centers, :id, :name,
                                    { prompt: "Selecione o centro de custo" }, class: "form-select", required: true %>
          </div>
        </div>
        <div class="alert alert-info mt-4 mb-0">
          <i class="bi bi-info-circle me-1"></i>
          O servidor, porta e senha IMAP continuam protegidos nas variáveis de ambiente.
        </div>
        <div class="d-flex justify-content-end mt-4">
          <%= f.submit "Salvar configuração", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
