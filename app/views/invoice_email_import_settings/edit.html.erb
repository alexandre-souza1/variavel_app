<div class="container py-4">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
      <p class="text-uppercase small fw-bold text-primary mb-1">Financeiro · Integrações</p>
      <h1 class="h3 mb-2">Importação de invoices por e-mail</h1>
      <p class="text-muted mb-0">Defina os padrões usados nas notas de abastecimento recebidas.</p>
    </div>
    <%= link_to invoices_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left"></i> Voltar para invoices
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-4">
      <%= render "form", setting: @setting, purchasers: @purchasers,
                         budget_categories: @budget_categories, cost_centers: @cost_centers %>
    </div>
  </div>
</div>
