<div class="app-page">
  <div class="app-page-header">
    <div>
      <p class="text-uppercase text-muted small fw-semibold mb-1">Operação</p>
      <h1 class="h3 mb-1"><i class="bi bi-person-workspace me-2"></i>Operadores</h1>
      <p class="text-muted mb-0">Cadastre e acompanhe os operadores utilizados na operação.</p>
    </div>
    <div class="app-page-actions">
      <% if current_user.admin? || current_user.supervisor? %>
        <%= button_to destroy_all_operators_path, method: :delete, class: "btn btn-outline-warning", form: { class: "d-inline" }, data: { turbo_confirm: "Inativar TODOS os operadores? O histórico será preservado." } do %><i class="bi bi-archive me-1"></i> Inativar todos<% end %>
        <%= link_to import_operators_path, class: "btn btn-outline-primary" do %><i class="bi bi-upload me-1"></i> Importar CSV<% end %>
        <%= link_to new_operator_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i> Novo operador<% end %>
      <% end %>
      <%= link_to "Voltar", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
  <%= render "shared/flashes" if lookup_context.exists?("shared/flashes", [], true) %>

    <div class="app-table-section">
      <div class="app-table-section__body">
        <div class="table-responsive">
          <div class="app-table-shell"><table class="table app-table app-table--data">
            <thead class="table-light">
          <tr>
            <th>Nome</th>
            <th>Matrícula</th>
            <th>Turno</th>
            <th>CPF</th>
            <th>Data de Nascimento</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @operators.each do |operator| %>
            <tr>
              <td><%= operator.nome %></td>
              <td><%= operator.matricula %></td>
              <td><%= turno_label(operator.turno) %></td>
              <td><%= operator.cpf %></td>
              <td><%= operator.data_nascimento.strftime("%d/%m/%Y") if operator.data_nascimento %></td>
              <td class="text-end">
                <div class="btn-group btn-group-sm" role="group">
                <%= link_to operator_path(operator), class: "icon-btn", title: "Ver operador", aria: { label: "Ver operador" } do %>
                  <i class="bi bi-eye" aria-hidden="true"></i>
                <% end %>
                <%= link_to edit_operator_path(operator), class: "icon-btn", title: "Editar operador", aria: { label: "Editar operador" } do %>
                  <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <% end %>
                <% if current_user.admin? or current_user.supervisor? %>
                <%= link_to operator_path(operator),
                  data: { turbo_method: :delete, turbo_confirm: "Inativar este operador? O histórico será preservado." },
                class: "icon-btn danger", title: "Inativar operador", aria: { label: "Inativar operador" } do %>
                  <i class="bi bi-archive" aria-hidden="true"></i>
                <% end %>
                <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
          </table></div>
    </div>
  </div>
</div>
</div>
</div>
