<div class="user-editor-card" data-controller="theme">
  <div class="user-editor-card__header">
    <div>
      <h2 id="userEditorModalTitle"><%= user == current_user ? "Meu cadastro" : "Editar usuário" %></h2>
      <p class="text-muted mb-0"><%= user.email %></p>
    </div>
    <%= link_to admin_users_path, class: "btn btn-outline-secondary btn-sm" do %>
      <i class="bi bi-x-lg me-1"></i>Fechar
    <% end %>
  </div>

  <% if user.errors.any? %>
    <div class="alert alert-danger mb-4">
      <strong>Não foi possível salvar.</strong>
      <ul class="mb-0 mt-2">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: [:admin, user], local: true, html: { multipart: true }) do |f| %>
    <div class="row g-3">
      <div class="col-md-8">
        <%= f.label :name, "Nome", class: "form-label fw-semibold" %>
        <%= f.text_field :name, class: "form-control", placeholder: "Nome completo" %>
        <%= f.label :email, "E-mail", class: "form-label fw-semibold" %>
        <%= f.email_field :email, class: "form-control", placeholder: "usuario@email.com" %>
      </div>
      <div class="col-md-4">
        <div class="user-editor-photo-panel">
          <span class="form-label fw-semibold">Foto de perfil</span>
          <% if user.photo.attached? %>
            <%= image_tag user.photo.variant(resize_to_limit: [88, 88]), class: "user-editor-photo-panel__image", alt: user.name %>
          <% else %>
            <span class="user-editor-photo-panel__placeholder"><i class="bi bi-person"></i></span>
          <% end %>
          <%= f.label :photo, "Escolher outra foto", class: "btn btn-sm btn-outline-primary" %>
          <%= f.file_field :photo, class: "visually-hidden" %>
          <% if user.photo.attached? %>
            <div class="form-check mt-1">
              <%= f.check_box :remove_photo, class: "form-check-input" %>
              <%= f.label :remove_photo, "Remover foto", class: "form-check-label" %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="col-12">
        <%= f.label :color_theme, "Tema de cores", class: "form-label fw-semibold" %>
        <div class="theme-picker" role="radiogroup" aria-label="Tema de cores">
          <% theme_descriptions = {
            "blue_teal" => "Azul equilibrado com detalhes em azul-petróleo.",
            "sage_teal" => "Verde-azulado suave e corporativo.",
            "retro_orange" => "Creme, verde e laranja com personalidade."
          } %>
          <% theme_swatches = {
            "blue_teal" => %w[#3368A0 #66A3BF #C8DFDB #F2EFE7],
            "sage_teal" => %w[#2D9596 #265073 #9AD0C2 #ECF4D6],
            "retro_orange" => %w[#527853 #F9E8D9 #F7B787 #EE7214]
          } %>
          <% User::COLOR_THEMES.each do |label, value| %>
            <%= f.radio_button :color_theme, value, class: "theme-picker__input", id: "user_color_theme_#{value}", data: { theme_target: "colorSelect", action: "change->theme#setColor" } %>
            <%= f.label :color_theme, value: value, for: "user_color_theme_#{value}", class: "theme-picker__option" do %>
              <span class="theme-picker__topline">
                <strong><%= label.upcase %></strong>
                <span class="theme-picker__check"><i class="bi bi-check2"></i></span>
              </span>
              <span class="theme-picker__description"><%= theme_descriptions.fetch(value) %></span>
              <span class="theme-picker__swatches" aria-hidden="true">
                <% theme_swatches.fetch(value).each do |color| %>
                  <span style="--theme-swatch: <%= color %>"></span>
                <% end %>
              </span>
            <% end %>
          <% end %>
        </div>
        <div class="form-text">A escolha vale para o claro e o escuro. O modo de exibição continua separado.</div>
      </div>
      <% if current_user.admin? %>
        <div class="col-md-3">
          <%= f.label :role, "Perfil de acesso", class: "form-label fw-semibold" %>
          <div class="input-group user-editor-select-group">
            <span class="input-group-text" aria-hidden="true"><i class="bi bi-person-badge user-editor-select-icon"></i></span>
            <%= f.select :role,
              [["Usuário", "user"], ["Supervisor", "supervisor"], ["Administrador", "admin"], ["Mecânico", "mechanical"]],
              {}, class: "form-select", data: { icon_map: { user: "bi-person", supervisor: "bi-person-workspace", admin: "bi-shield-lock-fill", mechanical: "bi-tools" }.to_json, action: "change->theme#setSelectionIcon" } %>
          </div>
        </div>
        <div class="col-md-3">
          <%= f.label :sector, "Setor", class: "form-label fw-semibold" %>
          <div class="input-group user-editor-select-group">
            <span class="input-group-text" aria-hidden="true"><i class="bi bi-building user-editor-select-icon"></i></span>
            <%= f.select :sector,
              User::USER_SECTORS.map { |label, value| [label == "Planejamento" ? "Gestão" : label, value] },
              { include_blank: "Selecione" },
              class: "form-select",
              data: { icon_map: { fleet: "bi-truck", du: "bi-signpost-2", warehouse: "bi-box-seam", hr: "bi-people", safety: "bi-shield-check", finance: "bi-cash-stack", planning: "bi-person-workspace" }.to_json, action: "change->theme#setSelectionIcon" } %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="user-editor-card__security mt-4">
      <h3><i class="bi bi-key-fill me-2"></i>Alterar senha</h3>
      <p>Preencha apenas se quiser definir uma nova senha.</p>
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :password, "Nova senha", class: "form-label fw-semibold" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :password_confirmation, "Confirmar senha", class: "form-label fw-semibold" %>
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
      <%= f.submit "Salvar cadastro", class: "btn btn-primary px-4" %>
    </div>
  <% end %>
</div>
