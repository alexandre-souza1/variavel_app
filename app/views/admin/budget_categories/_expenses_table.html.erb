<div class="app-panel table-card category-expenses-panel mb-4">
  <div class="app-panel__header table-card-header">
    <div class="dashboard-panel-heading">
      <span class="dashboard-panel-kicker"><i class="fas fa-receipt me-1"></i> Composição</span>
      <h2>Gastos da categoria: <%= category.name.titleize %></h2>
      <small>Lançamentos do período selecionado</small>
    </div>
    <button class="btn-outline btn-sm"
            onclick="document.getElementById('category-details-container').innerHTML = ''">
      <i class="fas fa-times me-1"></i> Fechar
    </button>
  </div>

  <div class="table-card-body">
    <% if expenses.any? %>
      <div class="app-table-shell">
        <table class="table app-table app-table--report">
        <thead>
          <tr>
            <th>Fornecedor</th>
            <th>NFs</th>
            <th>Data</th>
            <th>Centro de Custo</th>
            <th>Valor</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% expenses.each do |invoice| %>
            <tr>
              <td data-label="Fornecedor">
                <strong><%= invoice.supplier.name %></strong><br>
                <small class="text-muted"><%= invoice.supplier.cnpj %></small>
              </td>

              <td data-label="NFs">
                <% invoice_numbers = invoice.invoice_numbers.to_a %>
                <% invoice_numbers.first(2).each do |num| %>
                  <span class="badge bg-info" title="NF <%= num.number %>"><%= num.number %></span>
                <% end %>
                <% if invoice_numbers.size > 2 %>
                  <span class="badge bg-info" title="<%= invoice_numbers.size - 2 %> NFs adicionais">+<%= invoice_numbers.size - 2 %></span>
                <% end %>
              </td>

              <td data-label="Data">
                <%= invoice.date_issued.present? ? l(invoice.date_issued, format: :short) : "-" %>
              </td>

              <td data-label="Centro de Custo">
                <% centers = invoice.invoice_numbers.includes(:cost_center).map(&:cost_center).compact.uniq %>

                <% if centers.any? %>
                  <% centers.first(2).each do |cc| %>
                    <span class="badge bg-secondary" title="<%= cc.name.upcase %>"><%= cc.name.upcase %></span>
                  <% end %>
                  <% if centers.size > 2 %>
                    <span class="badge bg-secondary" title="<%= centers.size - 2 %> centros adicionais">+<%= centers.size - 2 %></span>
                  <% end %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>

              <td data-label="Valor" class="fw-bold text-success">
                R$ <%= number_to_currency(invoice.total, unit: "", separator: ",", delimiter: ".") %>
              </td>

              <td data-label="Ações">
                <%= link_to invoice_path(invoice),
                            class: "btn-outline btn-sm",
                            title: "Ver detalhes" do %>
                  <i class="fas fa-eye"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        </table>
      </div>

      <!-- 🔹 Paginação -->
      <div class="d-flex justify-content-between align-items-center mt-3 px-4 pb-4">
        <div>
          <small class="text-muted">
            Página <%= current_page %> de <%= total_pages %>
          </small>
        </div>
        <div>
          <% if current_page > 1 %>
            <button class="btn-outline btn-sm"
                    data-action="click->category-details#changePage"
                    data-page="<%= current_page - 1 %>">
              <i class="fas fa-chevron-left"></i> Anterior
            </button>
          <% end %>

          <% if current_page < total_pages %>
            <button class="btn-outline btn-sm"
                    data-action="click->category-details#changePage"
                    data-page="<%= current_page + 1 %>">
              Próxima <i class="fas fa-chevron-right"></i>
            </button>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="text-muted mb-0">Nenhum gasto encontrado para esta categoria no período selecionado.</p>
    <% end %>
  </div>
</div>
