<%= form_with model: [:admin, @ai_setting], url: admin_ai_setting_path, method: :patch, local: true, class: "ai-settings-preferences" do |form| %>
  <% if @ai_setting.errors.any? %><div class="alert alert-danger ai-settings-preferences__errors"><%= @ai_setting.errors.full_messages.to_sentence %></div><% end %>
  <div class="app-panel info-card ai-settings-card">
    <div class="app-panel__header info-card-header">
      <%= render "panel_heading", icon: "sliders", kicker: "Preferências", title: "Configurações do aplicativo", subtitle: "Modelo principal e gravação de reuniões" %>
    </div>
    <div class="app-panel__body info-card-body">
      <section class="ai-settings-section">
        <div class="ai-settings-section__icon"><i class="bi bi-cpu" aria-hidden="true"></i></div>
        <div class="ai-settings-section__content">
          <h2>Modelo prioritário</h2>
          <p>O primeiro modelo usado pelo assistente, pelo chat e pelas atas. Os modelos reserva são tentados quando necessário.</p>
          <%= form.label :primary_model, "Modelo para iniciar as consultas", class: "form-label" %>
          <%= form.select :primary_model, AiSetting::MODELS.map { |label, value| [label, value] }, {}, class: "form-select" %>
        </div>
      </section>
      <section class="ai-settings-section">
        <div class="ai-settings-section__icon"><i class="bi bi-mic" aria-hidden="true"></i></div>
        <div class="ai-settings-section__content">
          <h2>Gravações de atas</h2>
          <p>O gravador encerra a captura ao atingir esse tempo e deixa o áudio pronto para gerar a ata.</p>
          <%= form.label :meeting_audio_max_minutes, "Duração máxima da gravação (minutos)", class: "form-label" %>
          <%= form.number_field :meeting_audio_max_minutes, class: "form-control", min: 1, max: 180, required: true %>
          <small class="text-muted">O limite de tamanho do arquivo também continua em vigor.</small>
        </div>
      </section>
    </div>
  </div>
  <div class="app-panel info-card ai-settings-card" id="limites-modelos">
    <div class="app-panel__header info-card-header">
      <%= render "panel_heading", icon: "speedometer2", kicker: "Disponibilidade", title: "Limites do AI Studio", subtitle: "Cotas utilizadas para estimar o saldo de cada modelo" %>
    </div>
    <div class="app-panel__body info-card-body"><%= render "model_limits" %></div>
  </div>
  <div class="ai-settings-actions"><%= form.submit "Salvar configurações", class: "btn btn-primary" %></div>
<% end %>
