<div class="dashboard-page ai-settings-page">
  <header class="dashboard-header">
    <div class="header-content">
      <div>
        <p class="dashboard-eyebrow"><i class="bi bi-grid-1x2 me-1" aria-hidden="true"></i> Administração · IA</p>
        <h1><i class="bi bi-stars" aria-hidden="true"></i> Inteligência artificial</h1>
        <p class="subtitle">Acompanhe o consumo, as cotas e o uso dos recursos de IA do aplicativo.</p>
      </div>
      <div class="header-actions">
        <%= link_to ai_settings_tab_path(@tab, user_query: params[:user_query], page: params[:page]), class: "btn-outline" do %>
          <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Atualizar dados
        <% end %>
      </div>
    </div>
  </header>
  <nav class="ai-settings-tabs" aria-label="Seções de inteligência artificial">
    <% Admin::AiSettingsController::TABS.each do |key, label| %>
      <%= link_to ai_settings_tab_path(key), class: "ai-settings-tabs__link #{'is-active' if @tab == key}", aria: { current: @tab == key ? "page" : nil } do %>
        <i class="bi bi-<%= { 'overview' => 'grid-1x2', 'models' => 'cpu', 'users' => 'people', 'settings' => 'sliders' }.fetch(key) %>" aria-hidden="true"></i>
        <%= label %>
      <% end %>
    <% end %>
  </nav>
  <div class="ai-settings-panel" id="ai-tab-<%= @tab %>">
    <% if @tab == "overview" %>
      <%= render "report_filters" %>
      <%= render "overview" %>
    <% elsif @tab == "models" %>
      <%= render "usage" %>
    <% elsif @tab == "users" %>
      <%= render "report_filters" %>
      <%= render "users" %>
    <% elsif @tab == "settings" %>
      <%= render "preferences" %>
    <% end %>
  </div>
</div>
