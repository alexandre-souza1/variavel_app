<div class="dashboard-page ai-settings-page">
  <header class="dashboard-header">
    <div class="header-content">
      <div>
        <p class="dashboard-eyebrow"><i class="bi bi-grid-1x2 me-1" aria-hidden="true"></i> Administração · IA</p>
        <h1><i class="bi bi-stars" aria-hidden="true"></i> Inteligência artificial</h1>
        <p class="subtitle">Acompanhe o consumo, as cotas e o uso dos recursos de IA do aplicativo.</p>
      </div>
      <div class="header-actions">
        <%= link_to ai_settings_tab_path(@tab, user_query: params[:user_query], page: params[:page]), class: "btn-outline" do %>
          <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Atualizar dados
        <% end %>
      </div>
    </div>
  </header>
  <%= render "shared/page_tabs", label: "Seções de inteligência artificial", nav_class: "ai-settings-tabs", link_class: "ai-settings-tabs__link", current: @tab,
    tabs: Admin::AiSettingsController::TABS.map { |key, label| { key: key, label: label, path: ai_settings_tab_path(key), icon: { 'overview' => 'bi-grid-1x2', 'models' => 'bi-cpu', 'users' => 'bi-people', 'settings' => 'bi-sliders' }.fetch(key) } } %>
  <div class="ai-settings-panel" id="ai-tab-<%= @tab %>">
    <% if @tab == "overview" %>
      <%= render "report_filters" %>
      <%= render "overview" %>
    <% elsif @tab == "models" %>
      <%= render "usage" %>
    <% elsif @tab == "users" %>
      <%= render "report_filters" %>
      <%= render "users" %>
    <% elsif @tab == "settings" %>
      <%= render "preferences" %>
    <% end %>
  </div>
</div>
