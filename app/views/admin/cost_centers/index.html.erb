<div class="admin-catalog-page">
  <div class="admin-catalog-header">
    <div><p class="admin-catalog-eyebrow"><i class="bi bi-diagram-3 me-1"></i> Cadastros · Financeiro</p><h1><i class="bi bi-diagram-3 me-2"></i>Centros de custo</h1><p>Organize os lançamentos por área responsável.</p></div>
    <button type="button" class="az-report-btn az-report-btn--primary" data-bs-toggle="modal" data-bs-target="#newCostCenterModal"><i class="bi bi-plus-lg"></i> Novo centro</button>
  </div>
  <div class="admin-catalog-summary"><div><span>Centros cadastrados</span><strong><%= @cost_centers.size %></strong></div><div><span>Com lançamentos</span><strong><%= @cost_center_invoice_counts.count { |_id, count| count.positive? } %></strong></div></div>

  <div class="card admin-catalog-card">
    <div class="card-body">
      <table class="table admin-catalog-table table-hover align-middle">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Setor</th>
            <th>Lançamentos</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @cost_centers.each do |cost_center| %>
            <tr>
              <td><%= cost_center.name %></td>
              <td><span class="badge bg-secondary"><%= cost_center.sector.upcase %></span></td>
              <td><span class="admin-catalog-count"><%= @cost_center_invoice_counts[cost_center.id].to_i %></span></td>
              <td>
              <div class="d-flex gap-2">
                <%= link_to edit_admin_cost_center_path(cost_center), class: 'btn btn-sm btn-outline-primary', title: 'Editar centro de custo' do %><i class="bi bi-pencil"></i><% end %>
                <%= button_to admin_cost_center_path(cost_center),
                              method: :delete,
                              class: 'btn btn-sm btn-outline-danger',
                              title: 'Excluir centro de custo',
                              data: { turbo_confirm: 'Tem certeza?' } do %><i class="bi bi-trash"></i><% end %>
              </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade catalog-modal" id="newCostCenterModal" tabindex="-1" aria-labelledby="newCostCenterModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div><h5 class="modal-title" id="newCostCenterModalLabel"><i class="bi bi-diagram-3 me-2"></i>Novo centro de custo</h5><small>Informe os dados do novo centro.</small></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <%= form_with model: [:admin, CostCenter.new], local: true do |form| %>
        <div class="modal-body">
          <div class="mb-3"><%= form.label :name, "Nome do centro de custo", class: "form-label" %><%= form.text_field :name, class: "form-control", required: true, autofocus: true, placeholder: "Ex.: Operação Norte" %></div>
          <div><%= form.label :sector, "Setor", class: "form-label" %><%= form.select :sector, CostCenter.sectors.keys.map { |key| [key.humanize.upcase, key] }, { include_blank: "Selecione um setor" }, class: "form-select", required: true %></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><%= form.submit "Criar centro de custo", class: "btn btn-primary" %></div>
      <% end %>
    </div>
  </div>
</div>
