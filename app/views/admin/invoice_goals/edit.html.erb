<div class="catalog-form-page invoice-goal-editor">
  <div class="catalog-form-header">
    <div>
      <p class="admin-catalog-eyebrow"><i class="bi bi-bullseye me-1" aria-hidden="true"></i> Financeiro · Metas</p>
      <h1><i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Alterar meta</h1>
      <p>Escolha o novo valor e quando ele começa a valer.</p>
    </div>
    <%= link_to admin_invoice_goals_path, class: "az-report-btn" do %><i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar<% end %>
  </div>
  <div class="card catalog-form-card">
    <div class="card-header">
      <span class="badge bg-secondary mb-2"><%= InvoiceGoal.sectors[@source.sector] %></span>
      <h5 class="mb-1"><%= @source.name %></h5>
      <small class="text-muted"><%= @source.budget_categories.map(&:name).join(", ") %></small>
    </div>
    <div class="card-body">
      <%= render "form", invoice_goal: @invoice_goal, budget_categories: @budget_categories, source: @source %>
    </div>
  </div>
</div>
