<%= form_with(model: [:admin, invoice_goal], local: true) do |form| %>
  <% if invoice_goal.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(invoice_goal.errors.count, "erro") %> impediram esta meta de ser salva:</h4>
      <ul class="mb-0">
        <% invoice_goal.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Nome da meta", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true, placeholder: "Ex.: Pacote 113 - Custos gerais de frota" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :sector, "Setor", class: "form-label" %>
      <%= form.select :sector,
          InvoiceGoal.sectors.keys.map { |key| [InvoiceGoal.sectors[key], key] },
          { include_blank: "Selecione um setor" }, class: "form-select", required: true %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :reference_month, "Mês de referência", class: "form-label" %>
      <%= form.month_field :reference_month,
          value: invoice_goal.reference_month&.strftime("%Y-%m"), class: "form-control", required: true %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :target_amount, "Valor da meta", class: "form-label" %>
    <%= form.number_field :target_amount, step: "0.01", min: "0.01", class: "form-control", required: true %>
  </div>

  <div class="mb-4">
    <%= form.label :budget_category_ids, "Categorias incluídas", class: "form-label" %>
    <p class="text-muted small">Selecione somente categorias do mesmo setor da meta.</p>
    <div class="border rounded p-3">
      <% if budget_categories.any? %>
        <div class="row">
          <% budget_categories.each do |category| %>
            <div class="col-md-6 mb-2">
              <div class="form-check">
                <%= check_box_tag "invoice_goal[budget_category_ids][]", category.id,
                    invoice_goal.budget_category_ids.include?(category.id),
                    id: "invoice_goal_budget_category_#{category.id}", class: "form-check-input" %>
                <%= label_tag "invoice_goal_budget_category_#{category.id}", category.name, class: "form-check-label" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <span class="text-muted">Nenhuma categoria cadastrada para este setor.</span>
      <% end %>
    </div>
  </div>

  <div>
    <%= form.submit invoice_goal.persisted? ? "Atualizar meta" : "Criar meta", class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_invoice_goals_path, class: "btn btn-secondary" %>
  </div>
<% end %>
