<div class="admin-catalog-page">
  <div class="admin-catalog-header">
    <div>
      <p class="admin-catalog-eyebrow"><i class="bi bi-bullseye me-1" aria-hidden="true"></i> Financeiro · Metas</p>
      <h1><i class="bi bi-bullseye me-2" aria-hidden="true"></i>Metas mensais</h1>
      <p>O valor de cada indicador se repete nos meses seguintes, até a próxima alteração.</p>
    </div>
    <%= link_to new_admin_invoice_goal_path, class: "az-report-btn az-report-btn--primary", data: { bs_toggle: "modal", bs_target: "#invoiceGoalEditorNew" } do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i> Novo indicador
    <% end %>
  </div>

  <div class="d-flex flex-wrap justify-content-between gap-2 small text-muted mb-2">
    <span><%= pluralize(@indicators.size, "indicador", "indicadores") %></span>
    <span>Referência: <strong><%= l(@month, format: "%B de %Y") %></strong></span>
  </div>
  <div class="app-table-section admin-catalog-card">
    <div class="app-table-section__body">
      <div class="app-table-shell table-responsive">
        <table class="table app-table app-table--data admin-catalog-table">
          <thead>
            <tr>
              <th scope="col">Indicador</th>
              <th scope="col">Setor</th>
              <th scope="col">Categorias</th>
              <th scope="col" class="text-end">Meta mensal</th>
              <th scope="col">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @indicators.each do |indicator| %>
              <% current = indicator[:current] %>
              <% source = indicator[:source] %>
              <tr class="invoice-indicator">
                <td>
                  <strong><%= indicator[:name] %></strong>
                  <% if (upcoming = indicator[:scheduled].first) %>
                    <small class="invoice-indicator-scheduled d-block text-muted mt-1">
                      <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>
                      <%= number_to_currency(upcoming.target_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
                      a partir de <%= l(upcoming.reference_month, format: "%B de %Y") %>
                      <%= link_to "Editar", edit_admin_invoice_goal_path(upcoming), class: "ms-1", data: { bs_toggle: "modal", bs_target: "#invoiceGoalEditor#{upcoming.id}" }, aria: { label: "Editar meta agendada de #{indicator[:name]}" } %>
                    </small>
                  <% end %>
                </td>
                <td><span class="badge bg-secondary"><%= InvoiceGoal.sectors[indicator[:sector]] %></span></td>
                <td><%= source.budget_categories.map(&:name).join(", ") %></td>
                <td class="invoice-indicator-amount text-end">
                  <% if current %>
                    <strong class="text-nowrap"><%= number_to_currency(current.target_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
                    <% if current.ends_at %>
                      <small class="d-block text-muted">Até <%= l(current.ends_at, format: "%B de %Y") %></small>
                    <% end %>
                  <% else %>
                    <span class="invoice-indicator-unset text-muted">Sem meta definida</span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex gap-2">
                    <%= link_to edit_admin_invoice_goal_path(source), class: "btn btn-sm btn-outline-primary invoice-indicator-change",
                        data: { bs_toggle: "modal", bs_target: "#invoiceGoalEditor#{source.id}" }, title: "Alterar meta", aria: { label: "Alterar meta de #{indicator[:name]}" } do %>
                      <i class="bi bi-pencil" aria-hidden="true"></i>
                    <% end %>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal"
                        data-bs-target="#invoiceGoalHistory<%= source.id %>" title="Histórico da meta" aria-label="Histórico de <%= indicator[:name] %>">
                      <i class="bi bi-clock-history" aria-hidden="true"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if @indicators.empty? %>
              <tr><td colspan="5" class="text-center text-muted py-4">Nenhum indicador cadastrado.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% @indicators.each do |indicator| %>
  <%= render "history", indicator: indicator %>
<% end %>

<%= render "editor", invoice_goal: @new_invoice_goal, source: nil, budget_categories: @budget_categories, scheduled_change: nil %>
<% @editors.each do |editor| %>
  <%= render "editor", **editor %>
<% end %>
