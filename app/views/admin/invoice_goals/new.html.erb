<div class="catalog-form-page invoice-goal-editor">
  <div class="catalog-form-header">
    <div>
      <p class="admin-catalog-eyebrow"><i class="bi bi-bullseye me-1" aria-hidden="true"></i> Financeiro · Metas</p>
      <h1><i class="bi bi-bullseye me-2" aria-hidden="true"></i>Novo indicador</h1>
      <p>Defina o que acompanhar e o valor da meta mensal.</p>
    </div>
    <%= link_to admin_invoice_goals_path, class: "az-report-btn" do %><i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar<% end %>
  </div>
  <div class="card catalog-form-card"><div class="card-body">
    <%= render "form", invoice_goal: @invoice_goal, budget_categories: @budget_categories, source: nil %>
  </div></div>
</div>
