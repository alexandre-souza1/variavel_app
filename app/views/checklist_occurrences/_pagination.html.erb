<% total_pages = (total_count / per_page.to_f).ceil %>
<% pages = ([1, total_pages] + ((current_page - 1)..(current_page + 1)).to_a).select { |number| number.between?(1, total_pages) }.uniq.sort %>
<% if total_pages > 1 %>
  <nav class="checklist-tracking__pagination" aria-label="<%= label %>">
    <span class="checklist-tracking__page-summary">Página <strong><%= current_page %></strong> de <%= total_pages %></span>
    <div class="checklist-tracking__page-controls">
      <% if current_page > 1 %>
        <%= link_to checklist_occurrences_path(filters.merge(page_key => current_page - 1, anchor: anchor)), class: "btn btn-outline-secondary btn-sm checklist-tracking__page-link", aria: { label: 'Página anterior' } do %><i class="bi bi-chevron-left" aria-hidden="true"></i><span>Anterior</span><% end %>
      <% else %>
        <span class="btn btn-outline-secondary btn-sm checklist-tracking__page-link disabled" aria-disabled="true"><i class="bi bi-chevron-left" aria-hidden="true"></i><span>Anterior</span></span>
      <% end %>
      <% pages.each_with_index do |number, index| %>
        <% prior = index.positive? ? pages[index - 1] : nil %>
        <% if prior && number > prior + 1 %><span class="checklist-tracking__page-gap" aria-hidden="true">…</span><% end %>
        <%= link_to number, checklist_occurrences_path(filters.merge(page_key => number, anchor: anchor)), class: "btn btn-outline-secondary btn-sm checklist-tracking__page-link #{'active' if number == current_page}", aria: { label: "Página #{number}", current: number == current_page ? 'page' : nil } %>
      <% end %>
      <% if current_page < total_pages %>
        <%= link_to checklist_occurrences_path(filters.merge(page_key => current_page + 1, anchor: anchor)), class: "btn btn-outline-secondary btn-sm checklist-tracking__page-link", aria: { label: 'Próxima página' } do %><span>Próxima</span><i class="bi bi-chevron-right" aria-hidden="true"></i><% end %>
      <% else %>
        <span class="btn btn-outline-secondary btn-sm checklist-tracking__page-link disabled" aria-disabled="true"><span>Próxima</span><i class="bi bi-chevron-right" aria-hidden="true"></i></span>
      <% end %>
    </div>
  </nav>
<% end %>
