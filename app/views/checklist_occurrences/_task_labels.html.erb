<% if task.labels.any? %>
  <span role="group" class="d-flex flex-wrap gap-2 my-2" aria-label="Etiquetas da tarefa">
    <% task.labels.each do |label| %>
      <span class="badge task-label-badge action-plan-color-badge" style="--task-label-color: <%= label.color %>"><%= label.name %></span>
    <% end %>
  </span>
<% end %>
