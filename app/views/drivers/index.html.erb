<div class="app-page">
  <div class="app-page-header">
    <div>
        <p class="text-uppercase text-muted small fw-semibold mb-1">Operação</p>
        <h1 class="h3 mb-1"><i class="bi bi-person-badge me-2"></i>Motoristas</h1>
        <p class="text-muted mb-0">Cadastre e acompanhe os motoristas utilizados na operação.</p>
      </div>
      <div class="app-page-actions">
        <% if current_user.admin? || current_user.supervisor? %>
          <%= button_to destroy_all_drivers_path, method: :delete, class: "btn btn-outline-warning", form: { class: "d-inline" }, data: { turbo_confirm: "Inativar TODOS os motoristas? O histórico será preservado." } do %><i class="bi bi-archive me-1"></i> Inativar todos<% end %>
          <%= link_to import_drivers_path, class: "btn btn-outline-primary" do %><i class="bi bi-upload me-1"></i> Importar CSV<% end %>
          <%= link_to new_driver_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i> Novo motorista<% end %>
        <% end %>
        <%= link_to "Voltar", root_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
    <%= render "shared/flashes" if lookup_context.exists?("shared/flashes", [], true) %>

    <div class="app-table-section">
      <div class="app-table-section__body">
        <div class="table-responsive">
          <div class="app-table-shell"><table class="table app-table app-table--data">
            <thead class="table-light">
          <tr>
            <th>Nome</th>
            <th>Matrícula</th>
            <th>Promax</th>
            <th>CPF</th>
            <th>Data de Nascimento</th>
            <th>Autonomia</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @drivers.each do |driver| %>
            <tr>
              <td><%= driver.nome %></td>
              <td><%= driver.matricula %></td>
              <td><%= driver.promax %></td>
              <td><%= driver.cpf %></td>
              <td><%= driver.data_nascimento.strftime("%d/%m/%Y") if driver.data_nascimento %></td>
              <td>
                <span class="badge <%= driver.autonomy? ? 'bg-success' : 'bg-secondary' %>">
                  <%= driver.autonomy? ? 'Sim' : 'Não' %></span>
              </td>
              <td class="text-end">
                <div class="btn-group btn-group-sm" role="group">
                  <%= link_to driver_path(driver), class: "icon-btn", title: "Ver motorista", aria: { label: "Ver motorista" } do %>
                    <i class="bi bi-eye" aria-hidden="true"></i>
                  <% end %>
                  <%= link_to edit_driver_path(driver), class: "icon-btn", title: "Editar motorista", aria: { label: "Editar motorista" } do %>
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                  <% end %>
                  <% if current_user.admin? or current_user.supervisor? %>
                  <%= link_to driver_path(driver),
                    data: { turbo_method: :delete, turbo_confirm: "Inativar este motorista? O histórico será preservado." },
                  class: "icon-btn danger", title: "Inativar motorista", aria: { label: "Inativar motorista" } do %>
                    <i class="bi bi-archive" aria-hidden="true"></i>
                  <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
          </table></div>
    </div>
  </div>
</div>
</div>
</div>
