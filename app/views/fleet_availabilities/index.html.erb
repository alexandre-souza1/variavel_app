<div class="app-page fleet-availability-index">

  <header class="app-page-header fleet-availability-index__header">

    <div>

      <p class="app-page-eyebrow"><i class="bi bi-truck-front me-1"></i> Gestão · Frota</p>
      <h1><i class="bi bi-calendar2-check me-2"></i>Disponibilidade da frota</h1>

      <p>Consulte o histórico e acompanhe a cobertura da frota por quinzena.</p>

    </div>

    <div class="app-page-actions fleet-availability-index__actions">
      <%= link_to fleet_dimensionings_path,
                  class: "btn btn-outline-primary" do %>
        <i class="bi bi-calendar-range"></i>
        Dimensionamentos
      <% end %>

      <% if current_user.admin? || current_user.sector_fleet? %>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#fleetAvailabilitySettingsModal">
          <i class="bi bi-gear"></i>
          Configurações
        </button>
      <% end %>

      <%= link_to new_fleet_availability_path,
                  class: "btn btn-primary",
                  data: { bs_toggle: "modal", bs_target: "#newFleetAvailabilityModal" } do %>
        <i class="bi bi-plus-circle"></i>
        <span>Nova <span class="fleet-action-text-optional">Disponibilidade</span></span>
      <% end %>

    </div>

  </header>

  <section class="app-panel fleet-filter-card mb-4">
    <div class="app-panel__body">
      <%= form_with url: fleet_availabilities_path,
                    method: :get,
                    local: true,
                    class: "fleet-period-filter" do %>
        <div class="fleet-period-filter__summary">
          <span class="fleet-period-filter__eyebrow"><i class="bi bi-calendar-range me-1"></i> Período selecionado</span>
          <strong>
            <% if @selected_dimensioning %>
              <%= l(@selected_dimensioning.start_date) %> a <%= l(@selected_dimensioning.end_date) %>
            <% else %>
              Nenhuma quinzena cadastrada
            <% end %>
          </strong>
          <small>Selecione uma quinzena para consultar os registros da frota.</small>
        </div>

        <div class="fleet-period-filter__control">
          <%= label_tag :dimensioning_id, "Quinzena", class: "form-label" %>
          <%= select_tag :dimensioning_id,
                         options_from_collection_for_select(
                           @dimensioning_periods,
                           :id,
                           :label,
                           @selected_dimensioning&.id
                         ),
                         class: "form-select",
                         onchange: "this.form.requestSubmit()" %>
        </div>
      <% end %>
    </div>
  </section>

  <div class="row g-3 mb-4 fleet-summary-grid">

    <div class="col-md-3">
      <div class="card h-100 fleet-summary-card">
        <div class="card-body">
          <span class="text-muted small">Dias registrados na quinzena</span>
          <strong class="d-block fs-3">
            <%= @fleet_summary[:total_days] %>
          </strong>
          <small class="text-muted">
            Dentro do período selecionado
          </small>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100 fleet-summary-card fleet-summary-card--success">
        <div class="card-body">
          <span class="text-muted small">Cobertura média</span>
          <strong class="d-block fs-3">
            <%= @fleet_summary[:average_coverage] %>%
          </strong>
          <small class="text-muted">
            Disponíveis sobre dimensionamento
          </small>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100 fleet-summary-card fleet-summary-card--danger">
        <div class="card-body">
          <span class="text-muted small">Média de indisponibilidade</span>
          <strong class="d-block fs-3">
            <%= @fleet_summary[:average_unavailability] %>%
          </strong>
          <small class="text-muted">
            Indisponíveis em relação ao dimensionamento
          </small>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100 fleet-summary-card">
        <div class="card-body">
          <span class="text-muted small">Placa mais indisponível</span>
          <strong class="d-block fs-4 text-truncate" title="<%= @fleet_summary[:most_unavailable_plate] %>">
            <%= @fleet_summary[:most_unavailable_plate] %>
          </strong>
          <small class="text-muted">
            Maior número de ocorrências no período
          </small>
        </div>
      </div>
    </div>

  </div>

  <section class="fleet-history-card">

    <div class="fleet-history-card__body">

      <% if @fleet_availabilities.any? %>

        <div class="app-table-shell table-responsive">

          <table class="table align-middle mb-0 app-table fleet-availability-table">

            <thead>

              <tr>

                <th>Data</th>

                <th>Iniciada por</th>

                <th class="text-center">Status</th>

                <th class="text-center">Dimensionamento</th>

                <th class="text-center">Disponibilizados</th>

                <th class="text-center">Disponíveis p/ Troca</th>

                <th class="text-center">Indisponíveis</th>

                <th class="text-center">Cobertura</th>

                <th class="text-end"></th>

              </tr>

            </thead>

            <tbody>

              <% @fleet_availabilities.each do |availability| %>

                <tr>

                  <td data-label="Data" class="fleet-availability-table__date">
                    <%= l(availability.date) %>
                  </td>

                  <td data-label="Iniciada por" class="text-muted">
                    <%= availability.user.name.presence || availability.user.email %>
                  </td>

                  <td data-label="Status" class="text-center">
                    <% if availability.locked? %>
                      <span class="badge text-bg-secondary">Enviada</span>
                    <% else %>
                      <span class="badge text-bg-light border text-muted">Aberta</span>
                    <% end %>
                  </td>

                  <td data-label="Dimensionamento" class="text-center">
                    <%= availability.agreed_quantity %>
                  </td>

                  <td data-label="Disponibilizados" class="text-center">
                    <span class="badge bg-success">
                      <%= availability.available_count %>
                    </span>
                  </td>

                  <td data-label="Troca" class="text-center">
                    <span class="badge bg-warning text-dark">
                      <%= availability.exchange_count %>
                    </span>
                  </td>

                  <td data-label="Indisponíveis" class="text-center">
                    <span class="badge bg-danger">
                      <%= availability.unavailable_count %>
                    </span>
                  </td>

                  <td data-label="Cobertura" class="text-center">

                    <% percentage = availability.coverage_percentage %>

                    <div class="progress"
                         style="height: 20px;">

                      <div class="progress-bar
                        <%= percentage >= 100 ? "bg-success" : percentage >= 80 ? "bg-warning" : "bg-danger" %>"
                           role="progressbar"
                           style="width: <%= [percentage, 100].min %>%">

                        <%= percentage %>%

                      </div>

                    </div>

                  </td>

                  <td class="text-end fleet-availability-table__actions">

                    <div class="fleet-availability-row-actions btn-group btn-group-sm" role="group">
                      <%= link_to availability,
                                  class: "icon-btn",
                                  title: "Abrir disponibilidade",
                                  aria: { label: "Abrir disponibilidade" } do %>
                        <i class="bi bi-eye" aria-hidden="true"></i>
                      <% end %>

                      <% if current_user.admin? %>
                        <%= button_to availability,
                                      method: :delete,
                                      class: "icon-btn danger",
                                      title: "Apagar disponibilidade",
                                      aria: { label: "Apagar disponibilidade" },
                                      form: {
                                        class: "d-inline-block",
                                        data: {
                                          turbo_confirm: "Tem certeza que deseja apagar esta disponibilidade?"
                                        }
                                      } do %>
                          <i class="bi bi-trash" aria-hidden="true"></i>
                        <% end %>
                      <% end %>
                    </div>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      <% else %>

        <div class="text-center py-5 fleet-empty-state">

          <i class="bi bi-truck display-4 text-muted"></i>

          <h5 class="mt-3">
            Nenhuma disponibilidade cadastrada
          </h5>

          <p class="text-muted">
            Clique em <strong>Nova Disponibilidade</strong> para criar o primeiro registro.
          </p>

          <%= link_to new_fleet_availability_path,
                      class: "btn btn-primary" do %>

            <i class="bi bi-plus-circle"></i>
            Nova Disponibilidade

          <% end %>

        </div>

      <% end %>

    </div>

  </section>

</div>

<div class="modal fade app-modal fleet-availability-modal" id="newFleetAvailabilityModal" tabindex="-1" aria-labelledby="newFleetAvailabilityModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <p class="fleet-availability-modal__eyebrow"><i class="bi bi-plus-circle me-1"></i> Nova operação</p>
          <h2 class="modal-title" id="newFleetAvailabilityModalLabel">Nova disponibilidade</h2>
          <p>Informe a data e use o dimensionamento da quinzena correspondente.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <% if @new_dimensioning_period.present? %>
          <div class="fleet-availability-modal__period">
            <i class="bi bi-calendar2-check"></i>
            <div><strong><%= @new_dimensioning_period.label %></strong><span><%= l(@new_dimensioning_period.start_date) %> a <%= l(@new_dimensioning_period.end_date) %></span></div>
          </div>
        <% else %>
          <div class="fleet-availability-modal__period is-warning"><i class="bi bi-exclamation-circle"></i><span>Nenhum dimensionamento cadastrado para a data selecionada.</span></div>
        <% end %>
        <%= render "form", fleet_availability: @new_fleet_availability, dimensioning_period: @new_dimensioning_period, modal: true %>
      </div>
    </div>
  </div>
</div>

<% if current_user.admin? || current_user.sector_fleet? %>
<div class="modal fade app-modal" id="fleetAvailabilitySettingsModal" tabindex="-1" aria-labelledby="fleetAvailabilitySettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <%= form_with model: @fleet_availability_setting,
                      url: fleet_availability_setting_path,
                      method: :patch do |f| %>
          <div class="modal-header">
            <h5 class="modal-title" id="fleetAvailabilitySettingsModalLabel">Configurações da disponibilidade</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <%= f.label :auto_open_time, "Abrir disponibilidade automaticamente às", class: "form-label" %>
              <%= f.time_field :auto_open_time, value: @fleet_availability_setting.normalized_time(@fleet_availability_setting.auto_open_time), class: "form-control" %>
              <div class="form-text">O job pode ser executado antes desse horário; a abertura só acontecerá a partir dele.</div>
            </div>
            <div>
              <%= f.label :auto_lock_time, "Fechar disponibilidade automaticamente às", class: "form-label" %>
              <%= f.time_field :auto_lock_time, value: @fleet_availability_setting.normalized_time(@fleet_availability_setting.auto_lock_time), class: "form-control" %>
              <div class="form-text">A disponibilidade de amanhã será travada hoje nesse horário, para envio.</div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <%= f.submit "Salvar", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
