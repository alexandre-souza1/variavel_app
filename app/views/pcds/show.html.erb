<div class="pcd-page">
  <header class="pcd-heading"><div><span class="time-off-eyebrow">DU · ROTEIRIZAÇÃO</span><h1>PCD</h1><p>Saídas, mapas, placas e equipes do dia.</p></div><div class="pcd-heading-actions"><%= link_to 'Escala de folgas', time_off_schedule_path(tab: 'day', date: @date), class: 'btn btn-sm btn-outline-secondary' %><% if @plan %><%= link_to pcd_path(date: @date, format: :pdf), class: 'btn btn-sm btn-outline-primary', target: '_blank', rel: 'noopener', data: { turbo: false } do %><i class="bi bi-printer" aria-hidden="true"></i> Imprimir PCD SALAS<% end %><% end %></div></header>
  <div class="pcd-date-bar"><%= link_to '‹', pcd_path(date: @date - 1, tab: @tab), class: 'time-off-day-arrow', aria: { label: 'Dia anterior' }, rel: 'prev' %><h2><%= l(@date, format: '%A, %d de %B').capitalize %></h2><%= link_to '›', pcd_path(date: @date + 1, tab: @tab), class: 'time-off-day-arrow', aria: { label: 'Próximo dia' }, rel: 'next' %><%= form_with url: pcd_path, method: :get do |f| %><%= f.hidden_field :tab, value: @tab %><%= f.date_field :date, value: @date, class: 'form-control form-control-sm', aria: { label: 'Data do PCD' } %><%= f.submit 'Exibir', class: 'btn btn-sm btn-outline-secondary' %><% end %></div>
  <nav class="time-off-tabs" aria-label="Seções do PCD"><% [['board', 'Roteirização'], ['imports', 'Importações'], ['history', 'Histórico']].each do |tab, label| %><%= link_to label, pcd_path(date: @date, tab: tab), class: "time-off-tab #{'is-active' if @tab == tab}", aria: { current: @tab == tab ? 'page' : nil } %><% end %></nav>
  <% if @tab == 'board' %><%= render 'board' %>
  <% elsif @tab == 'imports' %>
    <section class="pcd-panel"><h2>Importações de <%= l(@date) %></h2><% if @imports.empty? %><p class="time-off-muted">Nenhuma importação salva para este dia.</p><% end %><% @imports.each do |item| %><details class="pcd-history-item"><summary><%= disclosure_arrow %> <strong><%= item.filename %></strong><span><%= l(item.created_at, format: '%d/%m %H:%M') %> · <%= item.user&.name || 'Usuário removido' %></span></summary><p><%= item.details['own'] %> saídas próprias · <%= item.details['freight'] %> freteiros · <%= item.details['maps'] %> mapas. <%= item.details['ignored_unrouted'] %> linhas não roteirizadas ignoradas.</p><p class="time-off-muted">Arquivo: <%= item.digest.first(12) %> · O histórico preserva cada versão importada.</p><ul><% Array(item.details['rows']).each do |row| %><li><%= row['plate'] %> · Mapas <%= row['maps'].map { |map| map['number'] }.join(', ') %> · <%= row['freight'] ? 'Freteiro' : 'Próprio' %><ul><% row['maps'].each do |map| %><li><%= map['cities'] %> · <%= map['region'] %></li><% end %></ul></li><% end %></ul></details><% end %></section>
  <% else %>
    <section class="pcd-panel"><h2>Histórico de execução</h2><% if @changes.empty? %><p class="time-off-muted">Nenhuma execução registrada.</p><% end %><% @changes.each do |item| %><details class="pcd-history-item"><summary><%= disclosure_arrow %> <strong><%= { 'import' => 'Importação e revisão', 'update' => 'Ajuste da roteirização', 'print' => 'Impressão PCD SALAS' }.fetch(item.action, item.action) %></strong><span><%= l(item.created_at, format: '%d/%m %H:%M') %> · <%= item.user&.name || 'Usuário removido' %></span></summary><p><%= item.reason %></p><ul><% Array(item.details['movements']).each do |movement| %><li><%= movement %></li><% end %></ul><% if item.action == 'print' %><p><%= Array(item.details['cars']).size %> saídas na impressão.</p><% end %></details><% end %></section>
  <% end %>
</div>
