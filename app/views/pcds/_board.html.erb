<section class="pcd-panel" data-controller="pcd" data-pcd-state-value="<%= @board.state.to_json %>" data-pcd-url-value="<%= pcd_path(date: @date) %>" data-pcd-import-url-value="<%= preview_routing_pcd_path(date: @date) %>" data-pcd-date-value="<%= @date %>" data-pcd-revision-value="<%= @plan&.lock_version || -1 %>" data-pcd-plates-value="<%= @plate_options.to_json %>" data-pcd-rooms-value="<%= Pcd::Board::ROOMS.to_json %>">
  <div class="pcd-import"><%= form_with url: preview_routing_pcd_path(date: @date), multipart: true, data: { pcd_target: 'importForm', action: 'submit->pcd#importFile' } do |f| %><div><%= f.label :file, 'Relatório PW00943S do dia' %><%= f.file_field :file, accept: '.csv,text/csv', class: 'form-control form-control-sm', required: true %></div><button class="btn btn-sm btn-outline-primary" data-pcd-target="importButton"><i class="bi bi-upload" aria-hidden="true"></i> Carregar CSV</button><% end %><p data-pcd-target="importReport"><% source = @plan&.details&.fetch('routing_import', nil) %><%= source ? "#{source['filename']} · #{source['rows'].size} saídas importadas" : 'Importe no dia da saída. Rotas próprias e freteiros entram no PCD.' %></p><small>Carregar cria uma prévia. Organize as equipes, confira salas e horários e salve para registrar a importação.</small></div>
  <div class="pcd-summary" data-pcd-target="summary"></div>
  <% unless @board.dimensioning %><p class="pcd-notice">Sem dimensionamento vigente. O CSV continua disponível para montar o PCD; a necessidade futura do piloto depende do dimensionamento.</p><% end %>
  <div class="pcd-commands"><p role="status" aria-live="polite" data-pcd-target="message">Arraste um nome disponível para a rota ou selecione o nome e toque na vaga.</p><div><button class="btn btn-sm btn-outline-secondary" data-action="pcd#reset">Desfazer rascunho</button><button class="btn btn-sm btn-primary" data-action="pcd#openSave">Salvar PCD</button></div></div>
  <div class="pcd-layout"><div class="pcd-rooms" data-pcd-target="rooms"></div><aside class="pcd-pools"><% [['working', 'Disponíveis'], ['off', 'De folga / DSR'], ['unavailable', 'Indisponíveis']].each do |status, label| %><section class="pcd-pool"><h3><%= label %> <span data-pool-count="<%= status %>"></span></h3><div class="pcd-pool-people" data-pcd-target="pool" data-status="<%= status %>"></div></section><% end %><p class="time-off-muted">Folgas e ausências são ajustadas na <%= link_to 'Escala do dia', time_off_schedule_path(tab: 'day', date: @date) %>.</p></aside></div>
  <div class="pcd-save"><span data-pcd-target="dirty"><%= @plan ? 'PCD salvo' : 'Sugestão inicial' %></span><button class="btn btn-primary" data-action="pcd#openSave">Salvar roteirização</button></div>
  <dialog class="time-off-dialog" data-pcd-target="dialog" data-action="cancel->pcd#cancel"><h2>Salvar PCD de <%= l(@date) %></h2><label for="pcd_reason">Motivo da execução</label><textarea id="pcd_reason" class="form-control" maxlength="500" rows="3" data-pcd-target="reason" placeholder="Ex.: roteirização do dia, substituição de veículo ou ajuste de equipe."></textarea><p role="alert" data-pcd-target="error"></p><div class="d-flex justify-content-end gap-2 mt-3"><button class="btn btn-outline-secondary" data-action="pcd#cancel">Cancelar</button><button class="btn btn-primary" data-pcd-target="saveButton" data-action="pcd#save">Confirmar e salvar</button></div></dialog>
  <% @board.members.each do |person| %><template data-pcd-target="person" data-person-id="<%= person['id'] %>"><%= render 'person', person: person %></template><% end %>
</section>
