<!DOCTYPE html>
<html>
  <head>
    <title>Workstation - LOG20 FOZ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= favicon_link_tag 'logo.png', type: 'image/png' %>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#3368A0"> <!-- Cor da barra do Chrome -->
    <script nonce="<%= request.content_security_policy_nonce %>">
      (() => {
        const storedTheme = localStorage.getItem("theme");
        const userColorTheme = <%= raw(json_escape((current_user&.color_theme || 'blue_teal').to_json)) %>;
        const userId = <%= raw(json_escape((current_user&.id || 'guest').to_json)) %>;
        const storedColorTheme = localStorage.getItem(`colorTheme:${userId}`) || localStorage.getItem("colorTheme");
        const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const theme = storedTheme || preferredTheme;

        document.documentElement.dataset.bsTheme = theme;
        document.documentElement.dataset.colorTheme = storedColorTheme || userColorTheme;
        document.querySelector("meta[name='theme-color']")?.setAttribute(
          "content",
          theme === "dark" ? "#0b0f0b" : "#3368A0"
        );
      })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
    <script nonce="<%= request.content_security_policy_nonce %>" src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-shell" data-user-id="<%= current_user&.id || 'guest' %>" data-controller="chart-theme">
  <%= render "shared/navbar" %>
  <%= render "layouts/#{secondary_nav}" if secondary_nav.present? %>
  <div id="flash-container">
    <%= render 'shared/flashes' %>
  </div>
  <main class="app-main flex-grow-1">
    <div class="app-content m-5">
    <%= yield %>
    </div>
  </main>
  <div id="import-progress"
      data-controller="reconnect"
      data-reconnect-user-id-value="<%= current_user&.id %>">
  </div>
  <div id="modal-container"></div>
  <%= render 'shared/footer' %>
  </body>
</html>
