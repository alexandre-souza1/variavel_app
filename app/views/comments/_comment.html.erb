<% author_name = comment.user.name.presence || comment.user.email %>
<div class="comment-item d-flex gap-2 mb-3">
  <!-- Avatar -->
  <div class="comment-avatar">
    <%= author_name.first.upcase %>
  </div>

  <!-- Conteúdo -->
  <div class="comment-body">
    <div class="comment-header">
      <strong><%= author_name.split.first %></strong>
      <span class="comment-time">
        <%= comment.created_at.strftime("%d/%m %H:%M") %>
      </span>
    </div>

    <div class="comment-content">
      <%= comment.content %>
    </div>
  </div>
</div>
