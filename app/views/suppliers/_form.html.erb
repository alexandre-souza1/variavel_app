<%= form_with(model: @supplier, local: true, data: { controller: "supplier" }, class: "supplier-form") do |f| %>
  <div class="supplier-form__body">
    <% if @supplier.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <strong>Revise os dados do fornecedor.</strong>
        <ul class="mb-0 mt-2"><% @supplier.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <section class="supplier-form__panel supplier-form__identification" aria-labelledby="supplier-identification-title">
      <div class="supplier-form__section-heading">
        <span class="supplier-form__section-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
        <div><h2 id="supplier-identification-title">Identificação do fornecedor</h2><p>Consulte o CNPJ para preencher os dados cadastrais.</p></div>
      </div>
      <div class="supplier-form__lookup-grid">
        <div class="supplier-form__field">
          <%= f.label :cnpj, "CNPJ", class: "form-label" %>
          <div class="supplier-form__lookup">
            <%= f.text_field :cnpj, class: "form-control", required: true, inputmode: "numeric",
                data: { supplier_target: "cnpj", action: "blur->supplier#fetchSupplierData keydown.enter->supplier#lookupOnEnter" },
                aria: { describedby: "supplier-lookup-status" }, placeholder: "00.000.000/0000-00" %>
            <button type="button" class="btn btn-outline-primary" data-supplier-target="lookupButton" data-action="supplier#fetchSupplierData">
              <i class="bi bi-search" aria-hidden="true"></i><span data-supplier-target="lookupLabel">Consultar</span>
            </button>
          </div>
          <p id="supplier-lookup-status" class="supplier-form__hint" role="status" aria-live="polite" data-supplier-target="status">Informe os 14 dígitos do CNPJ.</p>
        </div>
        <div class="supplier-form__field">
          <%= f.label :supplier_type, "Tipo de fornecedor", class: "form-label" %>
          <%= f.select :supplier_type, Supplier::TYPES.map { |value, label| [label, value] }, {}, class: "form-select", aria: { describedby: "supplier-type-hint" } %>
          <p id="supplier-type-hint" class="supplier-form__hint">Oficinas e borracharias ficam disponíveis na manutenção da frota.</p>
        </div>
      </div>
    </section>

    <div class="supplier-form__data-tools">
      <p class="supplier-form__autofill-note"><i class="bi bi-magic" aria-hidden="true"></i> <span data-supplier-target="editHint">Os dados abaixo são preenchidos pela consulta do CNPJ.</span></p>
      <button type="button" class="supplier-form__edit" aria-pressed="false" aria-controls="supplier-details"
              data-supplier-target="editButton" data-action="supplier#toggleManualEditing">
        <i class="bi bi-pencil" aria-hidden="true"></i><span data-supplier-target="editLabel">Editar dados</span>
      </button>
    </div>

    <div class="supplier-form__details" id="supplier-details">
      <section class="supplier-form__panel" aria-labelledby="supplier-company-title">
        <div class="supplier-form__section-heading">
          <span class="supplier-form__section-icon" aria-hidden="true"><i class="bi bi-building"></i></span>
          <div><h2 id="supplier-company-title">Dados da empresa</h2><p>Razão social, situação e contato.</p></div>
        </div>
        <div class="supplier-form__fields">
          <% [[:name, "Razão social", "name", "full"], [:fantasy_name, "Nome fantasia", "fantasyName", "wide"], [:situation, "Situação", "situation", "narrow"], [:email, "E-mail", "email", "half"], [:phone, "Telefone", "phone", "half"]].each do |attribute, label, target, span| %>
            <div class="supplier-form__field supplier-form__field--<%= span %>">
              <%= f.label attribute, label, class: "form-label" %>
              <%= f.text_field attribute, type: attribute == :email ? "email" : "text", class: "form-control-plaintext supplier-form__value", readonly: true, placeholder: "—", data: { supplier_target: "#{target} editableField" } %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="supplier-form__panel" aria-labelledby="supplier-address-title">
        <div class="supplier-form__section-heading">
          <span class="supplier-form__section-icon" aria-hidden="true"><i class="bi bi-geo-alt"></i></span>
          <div><h2 id="supplier-address-title">Endereço</h2><p>Localização cadastrada da empresa.</p></div>
        </div>
        <div class="supplier-form__fields">
          <% [[:street, "Logradouro", "street", "wide"], [:number, "Número", "number", "narrow"], [:complement, "Complemento", "complement", "half"], [:neighborhood, "Bairro", "neighborhood", "half"], [:city, "Cidade", "city", "half"], [:state, "UF", "state", "narrow"], [:zip_code, "CEP", "zipCode", "narrow"]].each do |attribute, label, target, span| %>
            <div class="supplier-form__field supplier-form__field--<%= span %> supplier-form__field--<%= attribute %>">
              <%= f.label attribute, label, class: "form-label" %>
              <%= f.text_field attribute, class: "form-control-plaintext supplier-form__value", readonly: true, placeholder: "—", data: { supplier_target: "#{target} editableField" } %>
            </div>
          <% end %>
        </div>
      </section>
    </div>

  </div>
    <div class="supplier-form__footer" role="group" aria-label="Ações do fornecedor">
      <button type="button" class="supplier-form__clear" data-action="supplier#clearFields"><i class="bi bi-eraser" aria-hidden="true"></i> Limpar campos</button>
      <div class="supplier-form__actions">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancelar</button>
        <%= f.button type: "submit", class: "btn btn-primary", data: { supplier_target: "submit" } do %>
          <i class="bi bi-check2" aria-hidden="true"></i> <%= @supplier.persisted? ? "Salvar alterações" : "Cadastrar fornecedor" %>
        <% end %>
      </div>
    </div>
  <% end %>
