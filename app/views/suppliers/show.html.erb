<div class="supplier-show-page az-operator-report-page">
  <% if notice %><div class="alert alert-success alert-dismissible fade show" role="alert"><%= notice %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% end %>

  <header class="supplier-show-header">
    <div>
      <p class="supplier-show-eyebrow"><i class="bi bi-building me-1"></i> Cadastro · Visão geral do fornecedor</p>
      <h1><i class="bi bi-truck me-2"></i><%= @supplier.name %></h1>
      <p><%= CNPJ.new(@supplier.cnpj).formatted %> · histórico financeiro e notas fiscais relacionadas.</p>
    </div>
    <div class="supplier-show-actions">
      <%= link_to suppliers_path, class: "az-report-btn" do %><i class="bi bi-arrow-left"></i> Voltar<% end %>
      <%= link_to edit_supplier_path(@supplier), class: "az-report-btn az-report-btn--primary" do %><i class="bi bi-pencil-square"></i> Editar fornecedor<% end %>
    </div>
  </header>

  <section class="supplier-show-summary" aria-label="Resumo financeiro do fornecedor">
    <div class="supplier-summary-card supplier-summary-card--total"><span><i class="bi bi-cash-stack"></i> Total gasto</span><strong><%= number_to_currency(@supplier_invoice_total, unit: "R$ ", separator: ",", delimiter: ".") %></strong><small>em <%= @supplier_invoices.size %> lançamento(s)</small></div>
    <div class="supplier-summary-card"><span><i class="bi bi-receipt"></i> Notas fiscais</span><strong><%= @supplier_invoice_numbers.size %></strong><small><%= number_to_currency(@supplier_invoice_numbers_total, unit: "R$ ", separator: ",", delimiter: ".") %> somados nas NFs</small></div>
    <div class="supplier-summary-card"><span><i class="bi bi-diagram-3"></i> Centro principal</span><strong><%= @top_cost_center&.name || "—" %></strong><small><%= @top_cost_center ? number_to_currency(@top_cost_center_total, unit: "R$ ", separator: ",", delimiter: ".") : "Nenhum rateio informado" %></small></div>
    <div class="supplier-summary-card"><span><i class="bi bi-person-check"></i> Situação</span><strong class="supplier-situation supplier-situation--<%= @supplier.situation.to_s.parameterize.presence || "unknown" %>"><%= @supplier.situation.presence || "Não informada" %></strong><small>status cadastral</small></div>
  </section>

  <section class="supplier-show-grid">
    <article class="az-report-panel">
      <div class="az-panel-header"><div><h2 class="az-report-section-title"><i class="bi bi-person-vcard"></i> Dados cadastrais</h2><p>Informações de identificação e contato.</p></div></div>
      <div class="az-panel-body">
        <div class="supplier-profile"><div class="supplier-avatar"><i class="bi bi-building"></i></div><div><strong><%= @supplier.name %></strong><span><%= @supplier.email.presence || "E-mail não informado" %></span></div></div>
        <div class="az-period-details">
          <div class="az-detail-item"><span>CNPJ</span><strong><%= CNPJ.new(@supplier.cnpj).formatted %></strong></div>
          <div class="az-detail-item"><span>Telefone</span><strong><%= @supplier.phone.presence || "Não informado" %></strong></div>
          <div class="az-detail-item"><span>E-mail</span><strong><%= @supplier.email.presence || "Não informado" %></strong></div>
          <div class="az-detail-item"><span>Endereço</span><strong><%= [@supplier.street, @supplier.number, @supplier.city, @supplier.state].compact_blank.join(", ").presence || "Não informado" %></strong></div>
        </div>
      </div>
    </article>

    <article class="az-report-panel">
      <div class="az-panel-header"><div><h2 class="az-report-section-title"><i class="bi bi-bar-chart-line"></i> Gastos por centro de custo</h2><p>Onde os lançamentos deste fornecedor estão concentrados.</p></div></div>
      <div class="az-panel-body">
        <% if @cost_center_totals.any? %>
          <div class="supplier-cost-center-list supplier-scroll-panel"><% @cost_center_totals.sort_by { |_center, total| -total }.each do |center, total| %><div class="supplier-cost-center-row"><span><strong><%= center.name %></strong><small><%= @supplier_invoice_numbers.count { |number| number.cost_center_id == center.id } %> NF(s)</small></span><strong><%= number_to_currency(total, unit: "R$ ", separator: ",", delimiter: ".") %></strong></div><% end %></div>
        <% else %><p class="az-report-empty">Nenhum centro de custo foi informado nas notas fiscais.</p><% end %>
      </div>
    </article>
  </section>

  <article class="az-report-panel supplier-nf-panel">
    <div class="az-panel-header"><div><h2 class="az-report-section-title"><i class="bi bi-list-ol"></i> Notas fiscais geradas</h2><p>Exibindo até 50 NFs; seus valores e o lançamento de origem.</p></div><div class="supplier-panel-actions"><% if @supplier_invoice_numbers.size > 50 %><%= link_to invoices_path(supplier_name: @supplier.name), class: "az-report-btn" do %><i class="bi bi-search"></i> Ver todas no index<% end %><% end %><%= link_to new_invoice_path, class: "az-report-btn" do %><i class="bi bi-plus-lg"></i> Novo lançamento<% end %></div></div>
    <% if @supplier_invoice_numbers.any? %>
      <div class="az-report-table-wrap supplier-nf-table-wrap"><table class="az-report-table"><thead><tr><th>Número da NF</th><th>Código do lançamento</th><th>Emissão</th><th>Centro de custo</th><th class="text-end">Valor</th><th></th></tr></thead><tbody>
        <% @supplier_invoice_numbers.first(50).each do |invoice_number| %><% invoice = invoice_number.invoice %><tr><td data-label="Número da NF"><strong><%= invoice_number.number %></strong></td><td data-label="Código"><%= link_to(invoice.code.presence || "##{invoice.id}", invoice_path(invoice), class: "supplier-history-link") %></td><td data-label="Emissão"><%= invoice.date_issued ? l(invoice.date_issued) : "—" %></td><td data-label="Centro de custo"><%= invoice_number.cost_center&.name || "Sem centro de custo" %></td><td data-label="Valor" class="text-end az-table-total"><%= number_to_currency(invoice_number.amount, unit: "R$ ", separator: ",", delimiter: ".") %></td><td class="text-end"><%= link_to invoice_path(invoice), class: "btn btn-sm btn-outline-secondary", title: "Ver lançamento" do %><i class="bi bi-eye"></i><% end %></td></tr><% end %>
      </tbody></table></div>
    <% else %>
      <div class="supplier-empty-state"><i class="bi bi-receipt"></i><p>Nenhuma nota fiscal cadastrada para este fornecedor.</p><%= link_to "Cadastrar lançamento", new_invoice_path, class: "az-report-btn az-report-btn--primary" %></div>
    <% end %>
  </article>

  <article class="az-report-panel supplier-launches-panel">
    <div class="az-panel-header"><div><h2 class="az-report-section-title"><i class="bi bi-clock-history"></i> Histórico de lançamentos</h2><p>Exibindo até 50 lançamentos recentes.</p></div><div class="supplier-panel-actions"><% if @supplier_invoices.size > 50 %><%= link_to invoices_path(supplier_name: @supplier.name), class: "az-report-btn" do %><i class="bi bi-search"></i> Ver todos no index<% end %><% end %><span class="az-overview-detail"><strong><%= @supplier_invoices.size %></strong> lançamento(s)</span></div></div>
    <div class="az-report-table-wrap supplier-history-table-wrap"><table class="az-report-table"><thead><tr><th>Código</th><th>Data</th><th>Categoria</th><th>Responsável</th><th class="text-end">Total</th></tr></thead><tbody>
      <% @supplier_invoices.first(50).each do |invoice| %><tr><td data-label="Código"><%= link_to(invoice.code.presence || "##{invoice.id}", invoice_path(invoice), class: "supplier-history-link") %></td><td data-label="Data"><%= invoice.date_issued ? l(invoice.date_issued) : "—" %></td><td data-label="Categoria"><%= invoice.budget_category&.name&.titleize || "—" %></td><td data-label="Responsável"><%= invoice.purchaser&.name || "—" %></td><td data-label="Total" class="text-end az-table-total"><%= number_to_currency(invoice.total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><% end %>
    </tbody></table></div>
  </article>

  <div class="supplier-audit-line"><span><i class="bi bi-plus-circle me-1"></i>Criado em <%= l(@supplier.created_at, format: :short) %></span><span><i class="bi bi-arrow-repeat me-1"></i>Atualizado em <%= l(@supplier.updated_at, format: :short) %></span></div>
</div>
