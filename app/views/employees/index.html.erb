<div class="app-page employees-page" data-controller="group-dialog" data-action="turbo:before-cache@document->group-dialog#reset">
  <header class="app-page-header">
    <div>
      <p class="app-page-eyebrow">Gestão de pessoas · RH</p>
      <h1><i class="bi bi-people" aria-hidden="true"></i> Colaboradores</h1>
      <p>Pessoas, cargos e movimentações em um só lugar.</p>
    </div>
    <div class="app-page-actions">
      <% if @archived_view %>
        <%= link_to employees_path(employee_navigation.except(:status)), class: 'btn btn-outline-secondary' do %><i class="bi bi-people me-1" aria-hidden="true"></i> Ativos<% end %>
      <% elsif @archived_count.positive? %>
        <%= link_to employees_path(employee_navigation.merge(status: 'archived')), class: 'btn btn-outline-secondary' do %><i class="bi bi-archive me-1" aria-hidden="true"></i> Arquivados (<%= @archived_count %>)<% end %>
      <% end %>
      <% if current_user.can_manage_employees? %><%= link_to new_employee_path(employee_sector: @sector_filter), class: 'btn btn-primary' do %><i class="bi bi-plus-lg" aria-hidden="true"></i> Novo colaborador<% end %><% end %>
    </div>
  </header>

  <section class="app-panel">
    <div class="app-panel__header">
      <div><span class="app-panel__kicker"><%= @archived_view ? 'Arquivo RH' : 'Equipe ativa' %></span><h2 class="app-panel__title"><%= @archived_view ? 'Colaboradores arquivados' : 'Encontre um colaborador' %></h2></div>
      <span class="employees-badge"><%= @employees.size %> exibidos</span>
    </div>
    <div class="app-panel__body">
      <%= form_with url: employees_path(employee_navigation.except(:status)), method: :get, class: 'employees-search' do |f| %>
        <%= hidden_field_tag :status, 'archived' if @archived_view %>
        <div class="employees-field">
          <%= f.label :q, 'Buscar por nome ou matrícula' %>
          <div class="employees-search__input"><i class="bi bi-search" aria-hidden="true"></i><%= f.search_field :q, value: params[:q], placeholder: 'Digite o nome ou a matrícula', class: 'form-control' %></div>
        </div>
        <% sectors = EmployeeRole::SECTORS.select { |_, sector| current_user.employee_sectors.include?(sector) }.to_a %>
        <div class="employees-field"><%= f.label :employee_sector, 'Setor' %><%= f.select :employee_sector, (sectors.size > 1 ? [['Todos', '']] : []) + sectors, { selected: @sector_filter }, class: 'form-select' %></div>
        <% cargos = @sector_filter ? EmployeeRole.cargos_for(@sector_filter) : EmployeeRole::CARGOS %>
        <div class="employees-field"><%= f.label :cargo, 'Cargo' %><%= f.select :cargo, [['Todos', '']] + cargos.to_a, { selected: params[:cargo] }, class: 'form-select' %></div>
        <% if current_user.employee_sectors.include?('az') && @sector_filter != 'du' %><div class="employees-field"><%= f.label :turno, 'Turno AZ' %><%= f.select :turno, [['Todos', '']] + EmployeeRole::TURNOS.to_a, { selected: params[:turno] }, class: 'form-select' %></div><% end %>
        <%= f.submit 'Buscar' , class: 'btn btn-primary' %>
        <% if params[:q].present? %><%= link_to 'Limpar', employees_path(employee_navigation.except(:q, :cargo, :turno)), class: 'btn btn-outline-secondary' %><% end %>
      <% end %>
    </div>
    <% if @employees.any? %>
      <div class="app-table-shell">
        <table class="table app-table app-table--data employees-table">
          <thead><tr><th>Colaborador</th><th>Matrícula</th><th>Setor</th><th>Cargo</th><th>Turno</th><th>Grupo</th><th>Situação</th><th aria-label="Acessar cadastro"></th></tr></thead>
          <tbody>
            <% @employees.each do |employee| %>
              <% role = employee.role_on(Date.current) %>
              <% displayed_role = role || (employee.initial_role if employee.awaiting_function_start?) %>
              <tr>
                <td><%= link_to employee_path(employee, employee_navigation), class: 'employees-person' do %><span class="employees-avatar" aria-hidden="true"><%= employee.nome.split.first(2).map(&:first).join %></span><span><strong><%= employee.nome %></strong><small>Ver cadastro e histórico</small></span><% end %></td>
                <td><span class="employees-code"><%= employee.matricula %></span>
                  <% if @duplicate_counts.key?(employee.matricula) %>
                    <%= link_to employee_path(employee, **employee_navigation, anchor: 'cadastros-duplicados'), class: 'employees-duplicate-link' do %><i class="bi bi-intersect" aria-hidden="true"></i> Matrícula repetida · revisar vínculo<% end %>
                  <% end %>
                </td>
                <td><%= displayed_role&.sector_label || '—' %></td><td><span class="employees-badge"><%= displayed_role&.label || 'Sem vigência' %></span></td><td><%= displayed_role&.az? ? (displayed_role.shift_label || 'A definir') : '—' %></td>
                <td class="employees-group-cell" data-employee-id="<%= employee.id %>">
                  <% if role&.du? && employee.active? %>
                    <% membership = @group_memberships["employee:#{employee.id}"] %>
                    <% if @schedule && current_user.can_manage_time_off? %>
                      <button type="button" class="employees-group-trigger" data-action="group-dialog#open" data-group-dialog-id="group-dialog-employee-<%= employee.id %>" aria-haspopup="dialog" aria-controls="group-dialog-employee-<%= employee.id %>" aria-label="<%= membership ? 'Alterar' : 'Definir' %> grupo de <%= employee.nome %>"><span class="employees-group-value"><%= membership&.group_code %></span><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    <% else %><span class="employees-group-value"><%= membership&.group_code %></span><% end %>
                  <% end %>
                </td>
                <td><span class="employees-status <%= 'employees-status--active' if employee.active? && !employee.awaiting_function_start? %>"><%= employee.employment_status_label %></span></td>
                <td><%= link_to employee_path(employee, employee_navigation), class: 'icon-btn', aria: { label: "Abrir cadastro de #{employee.nome}" } do %><i class="bi bi-arrow-up-right" aria-hidden="true"></i><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="employees-empty"><i class="bi bi-search" aria-hidden="true"></i><h3>Nenhum colaborador encontrado</h3><p>Tente outro nome ou matrícula para encontrar a pessoa.</p></div>
    <% end %>
  </section>
  <div class="employees-note"><i class="bi bi-info-circle" aria-hidden="true"></i><p>Cadastros antigos podem ter início de cargo desconhecido. Revise o histórico antes de registrar um fechamento.</p></div>
  <% if @schedule && current_user.can_manage_time_off? %>
    <% @employees.each do |employee| %>
      <% next unless employee.active? && employee.role_on(Date.current)&.du? %>
      <%= render 'time_off_schedules/group_dialog', person: employee, membership: @editable_group_memberships["employee:#{employee.id}"], schedule: @schedule, date: Date.current, url: assign_group_employee_path(employee, employee_navigation), revision_url: revise_membership_employee_path(employee, employee_navigation) %>
    <% end %>
  <% end %>
</div>
