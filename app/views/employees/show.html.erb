<% current_role = @employee.role_on(Date.current) %>
<% displayed_role = current_role || (@employee.initial_role if @employee.awaiting_function_start?) %>
<div class="app-page employees-page">
  <%= link_to employees_path(employee_navigation), class: 'employees-back' do %><i class="bi bi-arrow-left" aria-hidden="true"></i> Colaboradores<% end %>
  <header class="app-page-header">
    <div><p class="app-page-eyebrow">Gestão de pessoas · RH</p><h1><%= @employee.nome %></h1><p>Matrícula <%= @employee.matricula %> <span aria-hidden="true">·</span> Cadastro #<%= @employee.id %></p></div>
    <div class="app-page-actions"><% if current_user.can_manage_employees? %><%= link_to "Editar dados", edit_employee_path(@employee, employee_navigation), class: "btn btn-outline-primary" %><%= button_to(@employee.active? ? "Inativar" : "Reativar", @employee.active? ? retire_employee_path(@employee, employee_navigation) : reactivate_employee_path(@employee, employee_navigation), method: :patch, class: "btn btn-outline-secondary", data: { turbo_confirm: "Confirmar a alteração de situação deste colaborador?" }) %><% end %><%= link_to consulta_path(matricula: @employee.matricula, categoria: 'colaborador', employee_sector: current_role&.sector), class: 'btn btn-primary' do %><i class="bi bi-bar-chart" aria-hidden="true"></i> Consultar variável<% end %></div>
  </header>
  <% if @duplicate_employees.any? && @roles.any? %>
    <%= render 'duplicate_registrations', employee: @employee, duplicate_employees: @duplicate_employees %>
  <% end %>
  <section class="employees-overview" aria-label="Resumo do colaborador">
    <div class="app-panel employees-stat"><span><i class="bi bi-briefcase" aria-hidden="true"></i> <%= current_role || !@employee.awaiting_function_start? ? 'Cargo atual' : 'Cargo previsto' %></span><strong><%= displayed_role&.label || 'Sem vigência' %></strong></div>
    <div class="app-panel employees-stat"><span><i class="bi bi-calendar-check" aria-hidden="true"></i> Início na função</span><strong><%= displayed_role&.starts_on ? l(displayed_role.starts_on) : 'Não informado' %></strong></div>
    <div class="app-panel employees-stat"><span><i class="bi bi-calendar3" aria-hidden="true"></i> Registro na carteira</span><strong><%= @employee.registered_on ? l(@employee.registered_on) : 'Não informado' %></strong></div>
    <div class="app-panel employees-stat"><span><i class="bi bi-person-badge" aria-hidden="true"></i> Código / turno</span><strong><%= displayed_role&.az? ? "Turno #{displayed_role.shift_label || 'não informado'}" : (displayed_role&.promax || '—') %></strong></div>
    <div class="app-panel employees-stat"><span><i class="bi bi-person-check" aria-hidden="true"></i> Situação</span><strong class="employees-status <%= 'employees-status--active' if @employee.active? && !@employee.awaiting_function_start? %>"><%= @employee.employment_status_label %></strong></div>
  </section>

  <div class="employees-profile-grid">
    <section class="app-panel">
      <div class="app-panel__header"><div><span class="app-panel__kicker">Trajetória</span><h2 class="app-panel__title">Histórico de cargos</h2><p class="app-panel__subtitle">Cada movimentação preserva o período anterior.</p></div><span class="employees-badge"><%= @roles.size %> registros</span></div>
      <div class="app-panel__body">
        <% if @roles.any? %>
          <ol class="employees-timeline">
            <% @roles.each do |role| %>
              <li class="employees-timeline__item <%= 'employees-timeline__item--current' if role.covers?(Date.current) %>">
                <div class="employees-timeline__heading"><h3><%= role.label %> · <%= role.sector_label %></h3><% if role.pending_start? %><span class="employees-badge">Em integração</span><% elsif role.covers?(Date.current) %><span class="employees-badge employees-badge--accent">Atual</span><% elsif role.starts_on && role.starts_on > Date.current %><span class="employees-badge">Agendado</span><% end %></div>
                <p class="employees-timeline__period"><i class="bi bi-calendar3" aria-hidden="true"></i> <%= role.starts_on ? l(role.starts_on) : (role.pending_start? ? 'Aguardando início na função' : 'Início desconhecido') %> <span>→</span> <%= role.ends_on ? l(role.ends_on) : 'Em aberto' %></p>
                <p><span class="employees-badge"><%= role.az? ? "Turno #{role.shift_label || 'a definir'}" : "Promax #{role.promax.presence || 'a definir'}" %></span></p>
                <p class="employees-timeline__reason"><%= role.reason %></p>
                <small><i class="bi bi-person" aria-hidden="true"></i> <%= role.created_by&.email || 'Migração do cadastro' %></small>
                <% if current_user.admin? && role.created_by_id == current_user.id && role == @roles.first && @roles.size > 1 %>
                  <div class="employees-role-actions">
                    <%= button_to delete_role_employee_path(@employee, **employee_navigation, role_id: role.id), method: :delete, class: 'btn btn-outline-danger', data: { turbo_confirm: 'Excluir esta movimentação e restaurar o cargo anterior? Os fechamentos salvos serão preservados.' } do %><i class="bi bi-trash" aria-hidden="true"></i> Excluir movimentação<% end %>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ol>
        <% else %><div class="employees-empty"><i class="bi bi-clock-history" aria-hidden="true"></i><h3>Sem vigências neste cadastro</h3><p>As referências históricas continuam disponíveis nos fechamentos abaixo.</p></div><% end %>
      </div>
    </section>
    <% if current_user.can_manage_employees? %>
    <section class="app-panel">
      <div class="app-panel__header"><div><span class="app-panel__kicker">Movimentação</span><h2 class="app-panel__title">Alterar setor, cargo ou turno</h2><p class="app-panel__subtitle">O vínculo anterior termina na véspera da nova vigência.</p></div><i class="bi bi-arrow-left-right employees-panel-icon" aria-hidden="true"></i></div>
      <div class="app-panel__body">
        <% if @employee.initial_role&.pending_start? %>
          <p>O colaborador está em integração. Informe a data de início na função para liberar sua atuação na operação.</p>
          <%= link_to 'Informar início na função', edit_employee_path(@employee, employee_navigation), class: 'btn btn-primary' %>
        <% else %>
        <%= form_with url: change_role_employee_path(@employee, employee_navigation), class: 'employees-form' do |f| %>
          <%= render 'role_fields', prefix: 'promotion', allowed_cargos: @next_cargos, current_role: @roles.first %>
          <div class="employees-form-actions"><%= f.submit 'Registrar movimentação', class: 'btn btn-primary' %></div>
        <% end %>
        <% if @roles.first&.du? %>
          <details class="mt-3"><summary>Alterar somente o código Promax</summary>
            <%= form_with url: change_role_employee_path(@employee, employee_navigation), class: 'employees-form mt-3' do |f| %>
              <%= fields_for :employee_role do |career| %>
                <%= career.hidden_field :sector, value: 'du' %>
                <%= career.hidden_field :cargo, value: @roles.first.cargo %>
                <div class="employees-fields">
                  <div class="employees-field"><%= career.label :promax, 'Novo código Promax', for: 'code_change_promax' %><%= career.text_field :promax, id: 'code_change_promax', required: true, class: 'form-control' %></div>
                  <div class="employees-field"><%= career.label :starts_on, 'Data efetiva de início', for: 'code_change_starts_on' %><%= career.date_field :starts_on, id: 'code_change_starts_on', required: true, class: 'form-control' %></div>
                  <div class="employees-field employees-field--full"><%= career.label :reason, 'Motivo da alteração', for: 'code_change_reason' %><%= career.text_area :reason, id: 'code_change_reason', required: true, class: 'form-control' %></div>
                </div>
              <% end %>
              <%= f.submit 'Registrar troca de código', class: 'btn btn-outline-primary' %>
            <% end %>
          </details>
        <% end %>
        <% end %>
      </div>
    </section>
    <% end %>
  </div>

  <div class="app-page-actions mb-3">
    <% (@roles.map(&:sector) + @closings.map(&:sector)).uniq.each do |sector| %>
      <%= link_to "Consultar variável #{sector.upcase}", consulta_path(matricula: @employee.matricula, employee_sector: sector), class: 'btn btn-outline-primary' %>
    <% end %>
    <% if @employee.eligible_for?(:time_off) %><%= link_to 'Escala 5×2', time_off_schedule_path, class: 'btn btn-outline-secondary' %><% end %>
    <% if @employee.eligible_for?(:pcd) && (current_user.admin? || current_user.sector_du?) %><%= link_to 'PCD', pcd_path, class: 'btn btn-outline-secondary' %><% end %>
  </div>
  <section class="app-panel employees-section">
    <div class="app-panel__header"><div><span class="app-panel__kicker">Remuneração variável</span><h2 class="app-panel__title">Variáveis registradas</h2><p class="app-panel__subtitle">DU: 21 a 20 · AZ: 19 a 18 · Histórico preservado por setor.</p></div><i class="bi bi-journal-check employees-panel-icon" aria-hidden="true"></i></div>
    <div class="app-panel__body">
      <% if @closing_cargos.any? %>
        <%= form_with url: employee_path(@employee, employee_navigation), method: :get, local: true, class: 'd-flex align-items-end gap-2 mt-3' do |f| %>
          <% employee_navigation.except(:cargo).each do |key, value| %><%= hidden_field_tag key, value %><% end %>
          <div class="employees-field"><%= f.label :cargo, 'Exibir variável por cargo' %><%= f.select :cargo, [['Todos os cargos', '']] + @closing_cargos.filter_map { |cargo| [EmployeeRole::CARGOS.key(cargo), cargo] }, { selected: @cargo_filter }, class: 'form-select', onchange: 'this.form.submit()' %></div>
        <% end %>
      <% end %>
      <div class="employees-closings">
        <% if @closings.empty? %><div class="employees-empty"><i class="bi bi-journal" aria-hidden="true"></i><h3>Nenhuma variável registrada</h3><p>As variáveis apuradas para este colaborador aparecerão aqui.</p></div><% end %>
        <% @closings.each do |closing| %>
          <% if closing.sector == 'az' %><%= render 'az_closing', closing: closing %><% next %><% end %>
          <% closing_groups = closing.result.fetch('groups', {}) %>
          <% visible_groups = @cargo_filter.present? ? closing_groups.slice(@cargo_filter) : closing_groups %>
          <% visible_total = @cargo_filter.present? && visible_groups[@cargo_filter] ? visible_groups[@cargo_filter]['valor_total'] : closing.result.dig('totals', 'valor_total') %>
          <details class="employees-disclosure employees-closing">
            <summary><span class="employees-disclosure__icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span><span class="employees-disclosure__text"><strong><%= I18n.t('date.month_names')[closing.month].capitalize %> / <%= closing.year %></strong><small><%= if closing.result['consolidated_from']
              'Fechamento consolidado por cargo'
            else
              [closing.legacy_baseline? ? 'Referência legada' : 'Fechamento', "Revisão #{closing.revision}"].join(' · ')
            end %></small></span><strong class="employees-closing__total"><%= number_to_currency(visible_total.to_d, unit: 'R$ ', separator: ',', delimiter: '.') %></strong><%= disclosure_arrow(css_class: "employees-disclosure__chevron") %></summary>
            <div class="employees-disclosure__body">
              <p class="employees-muted"><%= closing.reason %></p><p class="employees-muted"><%= closing.user&.email || 'Referência legada da implantação' %> · <%= l(closing.created_at) %></p>
              <div class="app-table-shell"><table class="table app-table"><thead><tr><th>Cargo</th><th>Mapas</th><th>Bônus</th><th>Total</th></tr></thead><tbody>
                <% visible_groups.each do |cargo, totals| %><tr><td><%= EmployeeRole::CARGOS.key(cargo) %></td><td><%= totals['quantidade_mapas'] %></td><td><%= number_to_currency(totals['bonus_devolucao'].to_d, unit: 'R$ ', separator: ',', delimiter: '.') %></td><td><%= number_to_currency(totals['valor_total'].to_d, unit: 'R$ ', separator: ',', delimiter: '.') %></td></tr><% end %>
              </tbody></table></div>
              <% if current_user.can_manage_employees? %>
              <div class="mt-3">
                <%= form_with url: recalculate_closing_employee_path(@employee, employee_navigation), class: 'employees-form' do |f| %>
                  <%= hidden_field_tag :closing_id, closing.id %>
                  <%= hidden_field_tag :reason, 'Recalculado após correção do histórico de cargos' %>
                  <div class="employees-form-actions"><%= f.submit 'Recalcular pelo histórico atual', class: 'btn btn-outline-primary', data: { turbo_confirm: 'Criar uma nova revisão deste período usando o histórico atual de cargos?' } %></div>
                <% end %>
              </div>
              <% if closing_groups.keys.any? { |cargo| EmployeeRole::CARGOS.value?(cargo) } %>
                <details class="mt-3">
                  <summary class="btn btn-sm btn-outline-primary"><%= disclosure_arrow %> Revisar cargo desta variável</summary>
                  <div class="border rounded p-3 mt-2">
                    <p class="employees-muted">Crie uma nova revisão sem alterar este registro. Os mapas e totais serão recalculados com o cargo corrigido.</p>
                    <%= form_with url: revise_closing_employee_path(@employee, employee_navigation), class: 'employees-form' do |f| %>
                      <%= hidden_field_tag :closing_id, closing.id %>
                      <div class="employees-fields">
                        <div class="employees-field"><%= f.label :from_cargo, 'Cargo atual no fechamento' %><%= f.select :from_cargo, closing_groups.keys.filter_map { |cargo| [EmployeeRole::CARGOS.key(cargo), cargo] if EmployeeRole::CARGOS.value?(cargo) }, {}, class: 'form-select' %></div>
                        <div class="employees-field"><%= f.label :to_cargo, 'Cargo correto' %><%= f.select :to_cargo, EmployeeRole::CARGOS, {}, class: 'form-select' %></div>
                        <div class="employees-field employees-field--full"><%= f.label :reason, 'Motivo da revisão' %><%= f.text_area :reason, rows: 2, required: true, class: 'form-control', placeholder: 'Ex.: cadastro legado identificado como motorista de van' %></div>
                      </div>
                      <div class="employees-form-actions"><%= f.submit 'Criar revisão corrigida', class: 'btn btn-outline-primary', data: { turbo_confirm: 'Criar uma nova revisão desta variável com o cargo corrigido?' } %></div>
                    <% end %>
                  </div>
                </details>
              <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <% if current_user.can_manage_employees? %>
  <div class="employees-adjustments">
    <details class="app-panel employees-disclosure">
      <summary><span class="employees-disclosure__icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span><span class="employees-disclosure__text"><strong>Corrigir uma vigência</strong><small>Ajuste uma informação registrada no histórico.</small></span><%= disclosure_arrow(css_class: "employees-disclosure__chevron") %></summary>
      <div class="employees-disclosure__body">
        <p class="employees-muted">A correção fica registrada. Para alterar um fechamento salvo, registre também uma revisão do período.</p>
        <%= form_with url: revise_role_employee_path(@employee, employee_navigation), class: 'employees-form' do |f| %>
          <div class="employees-field"><%= f.label :role_id, 'Vigência a corrigir' %><%= f.select :role_id, @roles.map { |role| ["#{role.label} · #{role.starts_on ? l(role.starts_on) : 'Legado'}", role.id] }, {}, class: 'form-select' %></div>
          <%= render 'role_fields', prefix: 'correction', allowed_cargos: EmployeeRole::CARGOS.values %>
          <div class="employees-form-actions"><%= f.submit 'Registrar correção', class: 'btn btn-outline-primary' %></div>
        <% end %>
      </div>
    </details>
    <details id="vincular-cadastro" class="app-panel employees-disclosure" <% if @suggested_source %>open<% end %>>
      <summary><span class="employees-disclosure__icon"><i class="bi bi-link-45deg" aria-hidden="true"></i></span><span class="employees-disclosure__text"><strong>Vincular outro cadastro</strong><small>Reúna os registros da mesma pessoa.</small></span><%= disclosure_arrow(css_class: "employees-disclosure__chevron") %></summary>
      <div class="employees-disclosure__body">
        <p class="employees-muted">Informe o número do outro cadastro para abrir uma página de conferência. Os CPFs devem coincidir; nada será mesclado antes da sua confirmação.</p>
        <% if @suggested_source %><p class="employees-note">Cadastro sugerido: <strong><%= @suggested_source.nome %> (#<%= @suggested_source.id %>)</strong>. Confirme a data e o motivo antes de vincular.</p><% end %>
        <%= form_with url: link_record_employee_path(@employee, employee_navigation), method: :get, class: 'employees-form' do |f| %>
          <% employee_navigation.each do |key, value| %><%= hidden_field_tag key, value %><% end %>
          <div class="employees-fields">
            <div class="employees-field"><%= f.label :source_employee_id, 'Número do cadastro de origem' %><%= f.number_field :source_employee_id, value: @suggested_source&.id, required: true, min: 1, class: 'form-control' %></div>
          </div>
          <div class="employees-form-actions"><%= f.submit 'Revisar os dois cadastros', class: 'btn btn-outline-primary' %></div>
        <% end %>
      </div>
    </details>
  </div>
  <% end %>
  <% @employee.employee_career_events.where("details ->> 'action' = ?", 'link_record').each do |event| %>
    <div class="employees-note"><i class="bi bi-link-45deg" aria-hidden="true"></i><p><%= link_to 'Consultar referências do cadastro vinculado', employee_path(event.details.dig('source', 'id')) %>. Para consolidar os resultados, registre uma revisão do período neste cadastro.</p></div>
  <% end %>
</div>
