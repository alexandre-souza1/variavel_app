<div class="dashboard-finance invoice-dashboard-page">

  <!-- ========== CABEÇALHO ========== -->
  <header class="dashboard-header">
    <div class="header-content">
      <div>
        <p class="invoice-dashboard-eyebrow"><i class="bi bi-wallet2 me-1"></i> Financeiro · Indicadores</p>
        <h1>
          <i class="bi bi-graph-up-arrow"></i>
          Dashboard Financeiro
        </h1>
        <p class="subtitle">
          Visão consolidada dos gastos e indicadores financeiros
        </p>
      </div>
      <div class="header-actions">
        <!-- Filtros -->
        <%= form_with url: dashboard_invoices_path, method: :get, local: true, class: "filter-form" do %>
          <div class="filter-group">
            <%= select_tag :month,
                options_for_select((1..12).map { |m| [I18n.t("date.month_names")[m], m] }, params[:month]),
                include_blank: "Mês",
                class: "form-select form-select-sm" %>
            <%= select_tag :year,
                options_for_select((2022..Date.today.year).to_a.reverse, params[:year]),
                include_blank: "Ano",
                class: "form-select form-select-sm" %>
            <%= submit_tag "Filtrar", class: "az-report-btn az-report-btn--primary" %>
          </div>
        <% end %>
        <%= link_to "Mês Atual", dashboard_invoices_path(month: Date.today.month, year: Date.today.year, sector: @invoice_sector_filter), class: "az-report-btn" %>
        <%= link_to "Limpar", dashboard_invoices_path, class: "az-report-btn" %>
      </div>
    </div>
  </header>

  <!-- ========== KPI CARDS ========== -->
  <div class="kpi-grid">
    <!-- Total Ano -->
    <div class="kpi-card kpi-card--total">
      <div class="kpi-icon bg-primary-soft">
        <i class="fas fa-money-bill-wave text-primary"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Total Ano (YTD)</span>
        <span class="kpi-value">R$ <%= number_to_currency(@total_spent, unit: "", separator: ",", delimiter: ".") %></span>
        <span class="kpi-sub"><%= @invoices_count %> notas fiscais</span>
      </div>
    </div>

    <!-- Média Mensal -->
    <div class="kpi-card">
      <div class="kpi-icon bg-warning-soft">
        <i class="fas fa-chart-line text-warning"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Média Mensal</span>
        <span class="kpi-value">R$ <%= number_to_currency(@monthly_average, unit: "", separator: ",", delimiter: ".") %></span>
        <span class="kpi-sub">últimos 6 meses</span>
      </div>
    </div>

    <!-- Período Atual -->
    <div class="kpi-card">
      <div class="kpi-icon bg-success-soft">
        <i class="fas fa-calendar-day text-success"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label"><%= @has_period_filter ? @period_display : "Este Mês" %></span>
        <span class="kpi-value">R$ <%= number_to_currency(@current_month_total, unit: "", separator: ",", delimiter: ".") %></span>
        <span class="kpi-sub"><%= @current_month_count %> notas</span>
      </div>
    </div>

    <!-- Fornecedores -->
    <div class="kpi-card">
      <div class="kpi-icon bg-info-soft">
        <i class="fas fa-building text-info"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Fornecedores</span>
        <span class="kpi-value"><%= @suppliers_count %></span>
        <span class="kpi-sub">ativos</span>
      </div>
    </div>
  </div>

  <% if @invoice_goals.present? %>
    <section class="app-panel invoice-goals-panel" aria-labelledby="invoice-goals-title">
      <div class="app-panel__header invoice-goals-header">
        <div>
          <span class="invoice-goals-kicker"><i class="bi bi-bullseye me-1"></i> Acompanhamento</span>
          <h2 id="invoice-goals-title">Metas do período</h2>
        </div>
        <% if @can_filter_invoice_sector %>
          <%= link_to admin_invoice_goals_path, class: "invoice-goals-manage" do %>
            Gerenciar metas <i class="bi bi-arrow-up-right"></i>
          <% end %>
        <% end %>
      </div>
      <div class="invoice-goals-list">
        <% @invoice_goals.each do |goal_data| %>
          <% goal = goal_data[:goal] %>
          <div class="invoice-goal-row">
            <div class="invoice-goal-icon"><i class="bi bi-bullseye"></i></div>
            <div class="invoice-goal-main">
              <div class="invoice-goal-title-line">
                <strong><%= goal.name %></strong>
                <span><%= InvoiceGoal.sectors[goal.sector] %></span>
              </div>
              <small><%= goal.budget_categories.map(&:name).join(" · ") %></small>
              <div class="invoice-goal-progress" role="progressbar" aria-label="Progresso da meta <%= goal.name %>" aria-valuenow="<%= [goal_data[:percentage], 100].min %>" aria-valuemin="0" aria-valuemax="100">
                <span style="width: <%= [goal_data[:percentage], 100].min %>%"></span>
              </div>
            </div>
            <div class="invoice-goal-values">
              <strong><%= goal_data[:percentage] %>%</strong>
              <small><%= number_to_currency(goal_data[:actual_amount], unit: "R$ ", separator: ",", delimiter: ".") %> de <%= number_to_currency(goal.target_amount, unit: "R$ ", separator: ",", delimiter: ".") %></small>
              <em><%= number_to_currency(goal_data[:remaining_amount], unit: "R$ ", separator: ",", delimiter: ".") %> restante</em>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- ========== GRÁFICO DE EVOLUÇÃO ========== -->
  <div class="app-panel chart-card">
    <div class="app-panel__header chart-header">
      <div class="dashboard-panel-heading">
        <span class="dashboard-panel-kicker"><i class="fas fa-chart-line me-1"></i> Tendência</span>
        <h2>Evolução Mensal por Categoria</h2>
        <small>Últimos 12 meses · <%= Date.current.year %></small>
      </div>
      <%= form_with url: dashboard_invoices_path, method: :get, local: true, class: "chart-filters" do %>
        <%= select_tag :category_id,
              options_from_collection_for_select(@all_categories, :id, :name, params[:category_id]),
              include_blank: "Todas as categorias",
              class: "form-select form-select-sm w-auto",
              onchange: "this.form.submit()" %>
        <%= hidden_field_tag :month, params[:month] if params[:month].present? %>
        <%= hidden_field_tag :year, params[:year] if params[:year].present? %>
        <%= hidden_field_tag :cost_center_id, params[:cost_center_id] if params[:cost_center_id].present? %>
        <%= hidden_field_tag :sector, @invoice_sector_filter if @invoice_sector_filter.present? %>
      <% end %>
    </div>
    <div class="chart-body">
      <%= line_chart @category_line_chart,
            height: "400px",
            curve: false,
            points: true,
            prefix: "R$ ",
            thousands: ".",
            decimal: ",",
            round: 2,
            legend: "bottom",
            xtitle: "Meses",
            ytitle: "Valor gasto (R$)" %>
    </div>
  </div>

  <!-- ========== GASTOS POR CATEGORIA (cards clicáveis) ========== -->
  <div class="category-grid-wrapper">
    <div class="dashboard-panel-heading category-heading">
      <span class="dashboard-panel-kicker"><i class="fas fa-tags me-1"></i> Composição</span>
      <h2>Gastos por Categoria</h2>
      <small><%= @period_display %> · toque em uma categoria para ver os lançamentos</small>
    </div>
    <% if @has_period_filter %>
      <div data-controller="category-details">
        <div class="category-grid">
          <% @current_month_categories.each do |category_data| %>
            <div class="category-card-clickable"
                data-action="click->category-details#show"
                data-category-details-id-value="<%= category_data[:category].id %>">
              <div class="category-card-inner">
                <div class="category-icon">
                  <span class="badge bg-<%= category_color(category_data[:category]) %>">
                    <i class="fas fa-<%= category_icon(category_data[:category]) %>"></i>
                  </span>
                </div>
                <div class="category-info">
                  <h6 class="category-name"><%= category_data[:category].name.titleize %></h6>
                  <p class="category-value">R$ <%= number_to_currency(category_data[:total], unit: "", separator: ",", delimiter: ".") %></p>
                  <small class="category-count"><%= category_data[:count] %> <%= category_data[:count] == 1 ? 'nota' : 'notas' %></small>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div id="category-details-container" class="mt-4"></div>
      </div>
    <% else %>
      <div class="empty-state-compact">
        <i class="fas fa-filter"></i>
        <span>Selecione o mês e ano no filtro para visualizar os gastos por categoria.</span>
      </div>
    <% end %>
  </div>

  <!-- ========== GRÁFICOS EM GRID ========== -->
  <div class="charts-grid">
    <div class="app-panel chart-card">
      <div class="app-panel__header chart-header">
        <div class="dashboard-panel-heading">
          <span class="dashboard-panel-kicker"><i class="fas fa-chart-pie me-1"></i> Distribuição</span>
          <h2>Valores por Categoria</h2>
          <small>Participação dos gastos no período selecionado</small>
        </div>
      </div>
      <div class="chart-body">
        <%= pie_chart @spent_per_category,
                      donut: true,
                      prefix: "R$ ",
                      round: 2,
                      thousands: ".",
                      decimal: ",",
                      colors: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'] %>
      </div>
    </div>

    <div class="app-panel chart-card">
      <div class="app-panel__header chart-header">
        <div class="dashboard-panel-heading">
          <span class="dashboard-panel-kicker"><i class="fas fa-chart-bar me-1"></i> Alocação</span>
          <h2>Manutenções por Centro de Custo</h2>
          <small>Onde os custos de manutenção estão concentrados</small>
        </div>
      </div>
      <div class="chart-body">
        <%= pie_chart @total_per_cost_center,
                      donut: true,
                      colors: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'],
                      prefix: "R$ ",
                      thousands: ".",
                      decimal: "," %>
      </div>
    </div>
  </div>

  <!-- ========== TOP FORNECEDORES + ALERTAS ========== -->
  <div class="info-grid">
    <div class="app-panel info-card">
      <div class="app-panel__header info-card-header">
        <div class="dashboard-panel-heading">
          <span class="dashboard-panel-kicker"><i class="fas fa-trophy me-1"></i> Relacionamentos</span>
          <h2>Top 5 Fornecedores</h2>
          <small>Fornecedores com maior impacto no período</small>
        </div>
      </div>
      <div class="info-card-body">
        <div class="supplier-list">
          <% @top_suppliers.each do |supplier| %>
            <div class="supplier-item">
              <div>
                <strong><%= supplier.name %></strong>
                <br>
                <small class="text-muted"><%= supplier.invoices_count %> notas</small>
              </div>
              <span class="badge bg-primary rounded-pill">
                R$ <%= number_to_currency(supplier.total_amount, unit: "", separator: ",", delimiter: ".") %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="app-panel info-card">
      <div class="app-panel__header info-card-header">
        <div class="dashboard-panel-heading">
          <span class="dashboard-panel-kicker"><i class="fas fa-exclamation-triangle me-1"></i> Atenção</span>
          <h2>Alertas e Pendências</h2>
          <small>Sinais que merecem acompanhamento</small>
        </div>
      </div>
      <div class="info-card-body">
        <div class="alert-list">
          <% if @recent_invoices.any? %>
            <div class="alert-item alert-warning">
              <i class="fas fa-clock me-2"></i>
              <span><strong><%= @recent_invoices.count %> notas</strong> dos últimos 7 dias</span>
            </div>
          <% end %>

          <% if @high_value_invoices.any? %>
            <div class="alert-item alert-info">
              <i class="fas fa-money-bill-wave me-2"></i>
              <span><strong><%= @high_value_invoices.count %> notas</strong> acima de R$ 10.000</span>
            </div>
          <% end %>

          <div class="alert-item alert-light">
            <i class="fas fa-chart-line me-2"></i>
            <span>Variação mensal:
              <span class="<%= @monthly_variation >= 0 ? 'text-success' : 'text-danger' %>">
                <%= @monthly_variation %>% em relação ao mês anterior
              </span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== ÚLTIMOS LANÇAMENTOS ========== -->
  <div class="app-panel table-card">
    <div class="app-panel__header table-card-header">
      <div class="dashboard-panel-heading">
        <span class="dashboard-panel-kicker"><i class="fas fa-list me-1"></i> Registro</span>
        <h2>Últimos Lançamentos</h2>
        <small>Os lançamentos financeiros mais recentes</small>
      </div>
      <div>
        <small class="text-muted me-3">Mostrando <%= @latest_invoices.count %> de <%= @total_invoices_count %> notas</small>
        <%= link_to "Ver Todas", invoices_path, class: "az-report-btn az-report-btn--primary" %>
      </div>
    </div>
    <div class="table-card-body">
      <div class="table-responsive">
        <table class="table table-custom">
          <thead>
            <tr>
              <th>Fornecedor</th>
              <th>NFs</th>
              <th>Data</th>
              <th>Categoria</th>
              <th>Centro de Custo</th>
              <th class="text-end">Valor</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @latest_invoices.each do |invoice| %>
              <% category_name = invoice.budget_category.name.titleize %>
              <% category_label = if category_name.length > 22
                                    words = category_name.split
                                    words.length > 1 ? "#{words.first} #{words[1..].map { |word| "#{word.first}." }.join(" ")}" : "#{category_name.first(19)}…"
                                  else
                                    category_name
                                  end %>
              <tr>
                <td data-label="Fornecedor">
                  <strong><%= invoice.supplier.name %></strong>
                  <br>
                  <small class="text-muted"><%= invoice.supplier.cnpj %></small>
                </td>
                <td data-label="NFs">
                  <% invoice.invoice_numbers.each do |num| %>
                    <span class="badge bg-info"><%= num.number %></span>
                  <% end %>
                </td>
                <td data-label="Data"><%= l(invoice.date_issued, format: :short) %></td>
                <td data-label="Categoria">
                    <span class="status-badge" title="<%= category_name %>" style="background: var(--bs-<%= category_color(invoice.budget_category) %>-bg-subtle, #e5e7eb); color: var(--bs-<%= category_color(invoice.budget_category) %>-text-emphasis, #1f2937);">
                    <%= category_label %>
                  </span>
                </td>
                <td data-label="Centro de custo">
                  <% centers = invoice.invoice_numbers.map { |num| num.cost_center&.name }.compact.uniq %>
                  <% if centers.any? %>
                    <span class="badge bg-secondary"><%= centers.first.upcase %></span>
                    <% if centers.count > 1 %>
                      <span class="badge bg-secondary" style="cursor: pointer;" data-bs-toggle="tooltip" title="<%= centers[1..-1].join(', ').upcase %>">
                        +<%= centers.count - 2 %> outros
                      </span>
                    <% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td data-label="Valor" class="text-end fw-bold text-success">
                  R$ <%= number_to_currency(invoice.total, unit: "", separator: ",", delimiter: ".") %>
                </td>
                <td data-label="Ações" class="text-end">
                  <%= link_to invoice_path(invoice), class: "icon-btn", title: "Ver detalhes" do %>
                    <i class="fas fa-eye"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ========== BOTÃO VOLTAR ========== -->
  <div class="mt-4">
    <%= link_to "Voltar", root_path, class: "btn-outline w-100 text-center" %>
  </div>

</div>
