<% supplier = @invoice.supplier %>
<% cost_centers = @invoice.invoice_numbers.filter_map(&:cost_center).uniq { |cost_center| cost_center.id } %>
<% due_status = if @invoice.due_date.present? && @invoice.due_date < Date.current
                  "Vencido"
                elsif @invoice.due_date.present?
                  "A vencer"
                else
                  "Sem vencimento"
                end %>

<div class="az-operator-report-page invoice-show-page">
  <header class="az-report-header">
    <div class="az-report-header-content">
      <div>
        <p class="az-report-eyebrow"><i class="bi bi-receipt me-1"></i> Financeiro · Detalhes do lançamento</p>
        <h1 class="az-report-title"><i class="bi bi-file-earmark-text"></i> <%= @invoice.code.presence || "Lançamento ##{@invoice.id}" %></h1>
        <p class="az-report-subtitle">Nota fiscal, rateios e histórico recente do fornecedor.</p>
        <div class="az-report-meta">
          <span><i class="bi bi-building"></i> <strong><%= supplier.name %></strong></span>
          <span><i class="bi bi-upc-scan"></i> ID <strong><%= @invoice.id %></strong></span>
          <span><i class="bi bi-calendar3"></i> Emitida em <strong><%= l(@invoice.date_issued, format: :long) %></strong></span>
        </div>
      </div>
      <div class="az-report-actions">
        <%= link_to invoices_path, class: "az-report-back-link" do %><i class="bi bi-arrow-left"></i> Voltar para lançamentos<% end %>
        <%= link_to invoice_path(@invoice, format: :pdf), target: "_blank", class: "az-report-btn", data: { turbo: false } do %><i class="bi bi-file-earmark-pdf"></i> Gerar comprovante<% end %>
        <%= link_to edit_invoice_path(@invoice), class: "az-report-btn az-report-btn--primary" do %><i class="bi bi-pencil-square"></i> Editar lançamento<% end %>
        <%= button_to @invoice, method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir este lançamento?" }, class: "az-report-btn invoice-delete-btn", form_class: "d-inline" do %><i class="bi bi-trash"></i> Excluir<% end %>
      </div>
    </div>
  </header>

  <%= render "shared/flashes" %>

  <section class="az-report-overview invoice-overview" aria-label="Resumo do lançamento">
    <div class="az-overview-card az-overview-card--total">
      <div class="az-overview-label"><i class="bi bi-cash-coin"></i> Valor total</div>
      <div class="az-overview-value"><%= number_to_currency(@invoice.total, unit: "R$ ", separator: ",", delimiter: ".") %></div>
      <div class="az-overview-detail"><%= @invoice.invoice_numbers.size %> lançamento(s) de nota fiscal</div>
    </div>
    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-calendar-event"></i> Vencimento</div>
      <div class="az-overview-value invoice-status-value"><%= @invoice.due_date.present? ? l(@invoice.due_date) : "—" %></div>
      <div class="az-overview-detail"><span class="invoice-status-pill invoice-status-pill--<%= due_status.parameterize %>"><%= due_status %></span></div>
    </div>
    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-clock-history"></i> Outros lançamentos</div>
      <div class="az-overview-value"><%= @supplier_invoice_count %></div>
      <div class="az-overview-detail"><%= number_to_currency(@supplier_invoice_total, unit: "R$ ", separator: ",", delimiter: ".") %> com este fornecedor</div>
    </div>
    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-folder2-open"></i> Documentos</div>
      <div class="az-overview-value"><%= @invoice.documents.count %></div>
      <div class="az-overview-detail"><%= cost_centers.size %> centro(s) de custo</div>
    </div>
  </section>

  <section class="az-report-grid invoice-detail-grid">
    <article class="az-report-panel">
      <div class="az-panel-header"><div><h2 class="az-report-section-title"><i class="bi bi-info-circle"></i> Dados do lançamento</h2><p>Informações principais utilizadas no controle financeiro.</p></div></div>
      <div class="az-panel-body">
        <div class="az-period-details">
          <div class="az-detail-item"><span>Código do lançamento</span><strong><%= @invoice.code.presence || "Não informado" %></strong></div>
          <div class="az-detail-item"><span>Categoria</span><strong><%= @invoice.budget_category&.name&.titleize || "Não informada" %></strong></div>
          <div class="az-detail-item"><span>Setor</span><strong><%= @invoice.budget_category&.sector.presence || "—" %></strong></div>
          <div class="az-detail-item"><span>Comprador</span><strong><%= @invoice.purchaser&.name || "Não informado" %></strong></div>
          <div class="az-detail-item"><span>Data de emissão</span><strong><%= l(@invoice.date_issued, format: :long) %></strong></div>
          <div class="az-detail-item"><span>Data de vencimento</span><strong><%= @invoice.due_date.present? ? l(@invoice.due_date, format: :long) : "Não informado" %></strong></div>
        </div>
      </div>
    </article>

    <article class="az-report-panel">
      <div class="az-panel-header">
        <div><h2 class="az-report-section-title"><i class="bi bi-truck"></i> Fornecedor</h2><p>Identificação e contatos cadastrados.</p></div>
        <%= link_to supplier_path(supplier), class: "az-report-btn" do %><i class="bi bi-box-arrow-up-right"></i> Abrir cadastro<% end %>
      </div>
      <div class="az-panel-body">
        <div class="invoice-supplier-heading"><div class="invoice-supplier-avatar"><i class="bi bi-building"></i></div><div><strong><%= supplier.name %></strong><span>Fornecedor cadastrado</span></div></div>
        <div class="az-period-details">
          <div class="az-detail-item"><span>CNPJ</span><strong><%= supplier.cnpj %></strong></div>
          <div class="az-detail-item"><span>Situação</span><strong><%= supplier.situation.presence || "Não informada" %></strong></div>
          <div class="az-detail-item"><span>E-mail</span><strong><%= supplier.email.presence || "Não informado" %></strong></div>
          <div class="az-detail-item"><span>Telefone</span><strong><%= supplier.phone.presence || "Não informado" %></strong></div>
        </div>
      </div>
    </article>
  </section>

  <article class="az-report-panel invoice-numbers-panel">
    <div class="az-panel-header"><div><h2 class="az-report-section-title"><i class="bi bi-list-ol"></i> Notas fiscais e rateios</h2><p>Números, valores e centros de custo associados a este lançamento.</p></div><span class="az-overview-detail"><strong><%= @invoice.invoice_numbers.size %></strong> item(ns)</span></div>
    <% if @invoice.invoice_numbers.any? %>
      <div class="az-report-table-wrap"><table class="az-report-table"><thead><tr><th>Número da NF</th><th>Centro de custo</th><th class="text-end">Valor</th></tr></thead><tbody>
        <% @invoice.invoice_numbers.each do |invoice_number| %><tr><td data-label="Número da NF"><strong><%= invoice_number.number %></strong></td><td data-label="Centro de custo"><%= invoice_number.cost_center&.name || "Sem centro de custo" %></td><td data-label="Valor" class="text-end az-table-total"><%= number_to_currency(invoice_number.amount, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><% end %>
      </tbody></table></div>
    <% else %><p class="az-report-empty">Nenhum número de nota fiscal cadastrado.</p><% end %>
  </article>

  <section class="az-report-section-grid">
    <article class="az-report-panel">
      <div class="az-panel-header"><div><h2 class="az-report-section-title"><i class="bi bi-clock-history"></i> Outros lançamentos do fornecedor</h2><p>Histórico recente para facilitar conferência e comparação.</p></div><%= link_to invoices_path(supplier_name: supplier.name), class: "az-report-btn" do %>Ver todos<% end %></div>
      <% if @supplier_invoices.any? %>
        <div class="az-report-table-wrap"><table class="az-report-table"><thead><tr><th>Código</th><th>Emissão</th><th>Categoria</th><th class="text-end">Total</th></tr></thead><tbody>
          <% @supplier_invoices.each do |invoice| %><tr><td data-label="Código"><%= link_to(invoice.code.presence || "##{invoice.id}", invoice_path(invoice), class: "invoice-history-link") %></td><td data-label="Emissão"><%= l(invoice.date_issued) %></td><td data-label="Categoria"><%= invoice.budget_category&.name&.titleize || "—" %></td><td data-label="Total" class="text-end az-table-total"><%= number_to_currency(invoice.total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><% end %>
        </tbody></table></div>
      <% else %><p class="az-report-empty">Este é o primeiro lançamento localizado para este fornecedor.</p><% end %>
    </article>

    <article class="az-report-panel">
      <div class="az-panel-header"><div><h2 class="az-report-section-title"><i class="bi bi-paperclip"></i> Documentos e observações</h2><p>Arquivos anexados e notas internas do lançamento.</p></div></div>
      <div class="az-panel-body">
        <% if @invoice.documents.attached? %><div class="invoice-document-list"><% @invoice.documents.each do |doc| %><% type = doc.blob.metadata["document_type"] %><div class="invoice-document-item"><span><i class="bi bi-file-earmark me-1"></i><%= doc.filename %><% if type.present? %><small><%= type.upcase %></small><% end %></span><span class="d-flex gap-1"><%= link_to url_for(doc), target: "_blank", class: "az-report-btn", title: "Visualizar" do %><i class="bi bi-eye"></i><% end %><%= link_to download_document_invoice_path(@invoice, document_id: doc.id), download: doc.filename.to_s, class: "az-report-btn", title: "Baixar" do %><i class="bi bi-download"></i><% end %></span></div><% end %></div><% else %><p class="az-report-empty">Nenhum documento anexado.</p><% end %>
        <% if @invoice.notes.present? %><div class="invoice-notes"><strong><i class="bi bi-sticky me-1"></i>Observações</strong><%= simple_format(@invoice.notes) %></div><% end %>
      </div>
    </article>
  </section>

  <div class="invoice-audit-line"><span><i class="bi bi-plus-circle me-1"></i>Criado em <%= l(@invoice.created_at, format: :short) %></span><span><i class="bi bi-arrow-repeat me-1"></i>Atualizado em <%= l(@invoice.updated_at, format: :short) %></span></div>
</div>
