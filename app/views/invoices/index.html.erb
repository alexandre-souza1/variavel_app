
<div class="invoice-index-page">
  <header class="invoice-index-header">
    <div>
      <p class="invoice-index-eyebrow"><i class="bi bi-wallet2 me-1"></i> Financeiro · Controle de lançamentos</p>
      <h1><i class="bi bi-receipt me-2"></i>Notas fiscais e boletos</h1>
      <p>Consulte, confira e acompanhe os lançamentos financeiros cadastrados.</p>
    </div>
    <div class="invoice-index-actions">
      <%= link_to root_path, class: "invoice-index-back-link" do %><i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar<% end %>
      <%= link_to dashboard_invoices_path, class: "az-report-btn" do %><i class="bi bi-bar-chart"></i> Dashboard<% end %>
      <%= link_to new_invoice_path, class: "az-report-btn az-report-btn--primary" do %><i class="bi bi-plus-lg"></i> Novo lançamento<% end %>
    </div>
  </header>

  <section class="invoice-index-summary" aria-label="Resumo dos resultados">
    <div class="invoice-summary-total"><span><i class="bi bi-files"></i> Resultados</span><strong><%= @filtered_count %></strong><small>lançamento(s) filtrado(s)</small></div>
    <div><span><i class="bi bi-cash-stack"></i> Valor filtrado</span><strong><%= number_to_currency(@filtered_total, unit: "R$ ", separator: ",", delimiter: ".") %></strong><small>soma dos resultados</small></div>
    <div><span><i class="bi bi-buildings"></i> Fornecedores</span><strong><%= @filtered_suppliers %></strong><small>fornecedor(es) relacionado(s)</small></div>
    <div><span><i class="bi bi-funnel"></i> Página</span><strong><%= @current_page %>/<%= @total_pages %></strong><small><%= params[:per_page] || 10 %> por página</small></div>
  </section>

<!-- Formulário de filtro -->
<section class="invoice-filter-section mb-4">
  <div class="invoice-section-header">
      <h5 class="mb-0"><i class="bi bi-search"></i> Filtrar lançamentos</h5>
      <small>Combine os campos abaixo para localizar um registro específico.</small>
  </div>
  <div class="invoice-section-body">
    <%= form_with url: invoices_path, method: :get, local: true, class: "row g-3" do |f| %>
      <div class="col-md-3">
        <%= f.label :id, "ID do Lançamento", class: "form-label" %>
        <%= f.number_field :id, value: params[:id], class: "form-control" %>
      </div>

      <div class="col-md-2">
        <%= f.label :supplier_cnpj, "CNPJ do Fornecedor", class: "form-label" %>
        <%= f.text_field :supplier_cnpj, value: params[:supplier_cnpj], class: "form-control" %>
      </div>

      <div class="col-md-3">
        <%= f.label :supplier_name, "Nome do Fornecedor", class: "form-label" %>
        <%= f.text_field :supplier_name, value: params[:supplier_name], class: "form-control" %>
      </div>

      <div class="col-md-2">
        <%= f.label :date_issued, "Data de Emissão", class: "form-label" %>
        <%= f.date_field :date_issued, value: params[:date_issued], class: "form-control" %>
      </div>

      <div class="col-md-2">
        <%= f.label :due_date, "Data de Vencimento", class: "form-label" %>
        <%= f.date_field :due_date, value: params[:due_date], class: "form-control" %>
      </div>

      <div class="col-md-3">
        <%= f.label :total, "Valor", class: "form-label" %>
        <div class="input-group">
          <span class="input-group-text">R$</span>
          <%= f.text_field :total, value: params[:total], type: "number", step: "0.01", placeholder: "0,00", class: "form-control" %>
        </div>
      </div>

      <div class="col-md-3">
        <%= f.label :budget_category_id, "Categoria Orçamentária", class: "form-label" %>
        <%= f.collection_select :budget_category_id,
            BudgetCategory.order(:name),
            :id,
            :name,
            { prompt: "Selecione a categoria", selected: params[:budget_category_id] },
            { class: "form-select" } %>
      </div>

      <div class="col-md-3">
        <%= f.label :cost_center_id, "Centro de Custo", class: "form-label" %>
        <%= f.collection_select :cost_center_id,
            CostCenter.all.order(:name),
            :id,
            :name,
            { prompt: "Selecione o centro de custo", selected: params[:cost_center_id] },
            class: "form-select" %>
      </div>

      <div class="col-md-3">
        <%= f.label :invoice_number, "Número da NF", class: "form-label" %>
        <div class="invoice-filter-field-with-actions">
          <%= f.text_field :invoice_number, value: params[:invoice_number], class: "form-control" %>
          <div class="invoice-filter-actions">
            <%= f.button "Filtrar", type: "submit", class: "btn btn-primary btn-sm" do %>
              <i class="bi bi-funnel" aria-hidden="true"></i><span class="visually-hidden">Filtrar</span>
            <% end %>
            <%= link_to invoices_path, class: "btn btn-outline-secondary btn-sm", title: "Limpar filtros", aria: { label: "Limpar filtros" } do %>
              <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>

<!-- Tabela de invoices -->
<section class="invoice-results-section mb-4">
  <div class="invoice-section-header">
      <div><h5 class="mb-0"><i class="bi bi-list-ul"></i> Lançamentos encontrados</h5><small>Mais recentes primeiro</small></div>
      <span class="invoice-result-count"><%= @filtered_count %> resultado(s)</span>
  </div>
  <div class="invoice-section-body">
    <div class="table-responsive">
      <div class="app-table-shell"><table class="table app-table app-table--report invoice-results-table">
        <thead class="table-light">
          <tr>
            <th>Código</th>
            <th>Fornecedor (CNPJ)</th>
            <th>Centro de Custo</th>
            <th>Categoria</th>
            <th>Data Emissão</th>
            <th>Data Vencimento</th>
            <th>Total</th>
            <th>Notas Fiscais</th>
            <th>Arquivos</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @invoices.each do |invoice| %>
            <tr>
              <td><%= link_to(invoice.code.presence || "##{invoice.id}", invoice_path(invoice), class: "invoice-code-link") %></td>
              <td><%= invoice.supplier.name %> (<%= invoice.supplier.cnpj %>)</td>
              <td>
                <% if invoice.invoice_numbers.any? %>
                  <% displayed = invoice.invoice_numbers.first(2) %>

                  <% displayed.each do |nf| %>
                    <div class="mb-1">
                      <% if nf.cost_center.present? %>
                        <span class="badge bg-secondary"><%= nf.cost_center.name %></span>
                      <% else %>
                        <span class="text-muted">(sem CC)</span>
                      <% end %>
                    </div>
                  <% end %>

                  <% if invoice.invoice_numbers.count > 2 %>
                    <small class="text-muted">
                      +<%= invoice.invoice_numbers.count - 2 %> outros
                    </small>
                  <% end %>

                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td><%= invoice.budget_category.name if invoice.budget_category %></td>
              <td><%= invoice.date_issued ? l(invoice.date_issued) : "—" %></td>
              <td><%= invoice.due_date ? l(invoice.due_date) : "—" %></td>
              <td class="fw-semibold"><%= number_to_currency(invoice.total, unit: "R$ ", separator: ",", delimiter: ".") %></td>
              <td><%= truncated_list(invoice.invoice_numbers, :number, 2) %></td>
              <td>
                <% if invoice.documents.attached? %>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-success dropdown-toggle" type="button" id="dropdownMenuButton<%= invoice.id %>" data-bs-toggle="dropdown" aria-expanded="false">
                      <i class="fas fa-file-download"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton<%= invoice.id %>">
                      <% invoice.documents.each do |document| %>
                        <% document_type = document.blob.metadata["document_type"].presence || "Documento" %>
                        <li>
                          <%= link_to download_document_invoice_path(invoice, document_id: document.id),
                                      class: "dropdown-item",
                                      data: { turbo: false } do %>
                            <i class="fas fa-file"></i> <%= document_type.upcase %>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% else %>
                  <span>-</span>
                <% end %>
              </td>
              <td>
                <div class="d-inline-flex gap-2">
                  <%= link_to invoice, class: "icon-btn", title: "Ver lançamento", aria: { label: "Ver lançamento" } do %><i class="bi bi-eye" aria-hidden="true"></i><% end %>
                  <%= link_to edit_invoice_path(invoice), class: "icon-btn", title: "Editar lançamento", aria: { label: "Editar lançamento" } do %><i class="bi bi-pencil-square" aria-hidden="true"></i><% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
      <div class="d-flex align-items-center">
        <%= form_with url: invoices_path, method: :get, local: true, html: { class: "d-flex align-items-center mb-0" } do %>
          <% params.each do |key, value| %>
            <% unless ["per_page", "page", "commit"].include?(key) %>
              <%= hidden_field_tag key, value %>
            <% end %>
          <% end %>

          <label for="per_page" class="me-2 mb-0 text-nowrap">Itens por página:</label>
          <%= select_tag :per_page,
              options_for_select([5, 10, 20, 50], params[:per_page] || 10),
              class: "form-select form-select-sm me-2",
              onchange: "this.form.submit();" %>
          <% end %>
      </div>

<div class="d-flex flex-column align-items-end">

  <small class="text-muted mb-1">
    Página <strong><%= @current_page %></strong> de <strong><%= @total_pages %></strong>
  </small>

  <nav aria-label="Page navigation">
    <ul class="pagination mb-0">

      <% window = 2 %>

      <% if @current_page > window + 2 %>
        <li class="page-item">
          <%= link_to 1, invoices_path(params.permit!.merge(page: 1, per_page: params[:per_page] || 10)), class: "page-link" %>
        </li>

        <li class="page-item disabled">
          <span class="page-link">...</span>
        </li>
      <% end %>

      <% [(@current_page - window), 1].max.upto([(@current_page + window), @total_pages].min) do |page| %>
        <li class="page-item <%= 'active' if page == @current_page %>">
          <%= link_to page, invoices_path(params.permit!.merge(page: page, per_page: params[:per_page] || 10)), class: "page-link" %>
        </li>
      <% end %>

      <% if @current_page < @total_pages - window - 1 %>
        <li class="page-item disabled">
          <span class="page-link">...</span>
        </li>

        <li class="page-item">
          <%= link_to @total_pages, invoices_path(params.permit!.merge(page: @total_pages, per_page: params[:per_page] || 10)), class: "page-link" %>
        </li>
      <% end %>

    </ul>
  </nav>

</section>
    </div>
  </div>
</div>
</div>
