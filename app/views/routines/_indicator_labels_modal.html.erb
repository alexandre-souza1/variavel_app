<div class="modal fade app-modal routine-indicator-label-modal" id="routineIndicatorLabelsModal-<%= indicator.id %>" tabindex="-1" aria-labelledby="routineIndicatorLabelsTitle-<%= indicator.id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <%= form_with model: indicator, url: routine_indicator_label_path(routine, indicator), method: :patch, class: "d-flex flex-column overflow-hidden" do |form| %>
        <div class="modal-header">
          <div class="routine-indicator-label-modal__heading">
            <span class="routine-indicator-label-modal__icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
            <div>
              <h5 class="modal-title" id="routineIndicatorLabelsTitle-<%= indicator.id %>">Etiquetas</h5>
              <p><%= indicator.name %></p>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <%= render "routine_indicators/label_fields", indicator: indicator, labels: @plan_labels %>
        </div>
        <div class="modal-footer">
          <%= link_to action_plan_path(@action_plan, view: "labels"), class: "routine-indicator-label-modal__manage" do %>
            Gerenciar no plano <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
          <% end %>
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <%= form.submit "Salvar etiquetas", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
