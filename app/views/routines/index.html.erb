<div class="routines-page">

  <!-- ========== CABEÇALHO ========== -->
  <header class="routines-header">
    <div class="header-content">
      <div>
        <h1>
          <i class="bi bi-calendar-check"></i>
          <%= @show_archived ? "Rotinas arquivadas" : "Rotinas" %>
        </h1>
        <p class="subtitle">
          <%= @show_archived ? "Histórico de rotinas encerradas e arquivadas" : "Rotinas abertas e encerradas" %>
        </p>
      </div>
      <div class="header-actions">
        <%= link_to dashboard_path, class: "btn-outline" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Voltar
        <% end %>
        <%= link_to routine_templates_path, class: "btn-primary-solid" do %>
          <i class="bi bi-pie-chart-fill"></i> Painel de Gerots
        <% end %>
        <% unless @show_archived %>
          <%= link_to archived_routines_path, class: "btn-outline" do %>
            <i class="bi bi-archive me-1"></i> Arquivadas
          <% end %>
        <% end %>
      </div>
    </div>
  </header>

  <!-- ========== LISTAGEM ========== -->
  <% if @routines.any? %>

    <table class="routines-table">
      <thead>
        <tr>
          <th>Título</th>
          <th>Período</th>
          <th>Status</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @routines.each do |routine| %>
          <tr>
            <td><%= routine.title %></td>
            <td><%= l(routine.period_start) %> até <%= l(routine.period_end) %></td>
            <td>
              <% badge_class = routine.open? ? 'active' : 'inactive' %>
              <span class="status-badge <%= badge_class %>">
                <%= routine_status_label(routine) %>
              </span>
            </td>
            <td>
              <div class="table-actions">
                <%= link_to "Abrir", routine, class: "btn-primary-solid btn-sm" %>
                <% if @show_archived && current_user.admin? %>
                  <%= button_to routine_path(routine),
                                method: :delete,
                                class: "icon-btn danger",
                                title: "Excluir rotina",
                                aria: { label: "Excluir rotina" },
                                form: { data: { turbo_confirm: "Excluir esta rotina permanentemente? Os preenchimentos e comentários também serão apagados." } } do %>
                    <i class="bi bi-trash3"></i>
                  <% end %>
                <% elsif !@show_archived %>
                  <%= button_to archive_routine_path(routine),
                                method: :patch,
                                class: "icon-btn danger",
                                title: "Arquivar rotina",
                                aria: { label: "Arquivar rotina" },
                                form: { data: { turbo_confirm: "Arquivar esta rotina? Ela sairá da lista principal, mas seus dados serão preservados." } } do %>
                    <i class="bi bi-archive"></i>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

  <% else %>

    <!-- ========== ESTADO VAZIO ========== -->
    <div class="empty-state">
      <i class="bi bi-calendar-plus"></i>
      <h4>Nenhuma rotina gerada</h4>
      <p>Gere uma rotina a partir de um template disponível.</p>
      <%= link_to routine_templates_path, class: "btn-primary-solid" do %>
        <i class="bi bi-plus-lg"></i> Gerar Nova
      <% end %>
    </div>

  <% end %>

</div>
