<div class="container-fluid py-4">

  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

    <div>

      <h2 class="fw-bold">
        <%= @routine.title %>
      </h2>

      <p class="text-muted mb-0">
        <%= l(@routine.period_start) %>
        até
        <%= l(@routine.period_end) %>
      </p>

    </div>

    <button
      type="button"
      class="btn btn-outline-secondary"
      data-bs-toggle="offcanvas"
      data-bs-target="#routineActivitiesOffcanvas"
      aria-controls="routineActivitiesOffcanvas">

      <i class="bi bi-clock-history me-1"></i>
      Atividades

    </button>

  </div>

  <div class="table-responsive">

    <table class="table table-bordered align-middle">

      <thead>

        <tr>

          <th style="min-width:250px;">
            Indicador
          </th>

          <th style="width:120px;">
            Meta
          </th>

          <th style="width:120px;">
            Resultado
          </th>

          <% @days.each do |day| %>

            <th class="text-center">
              <%= day.day %>
            </th>

          <% end %>

        </tr>

      </thead>

      <tbody>

        <% @categories.each do |category| %>

          <tr class="table-light">

            <td colspan="<%= @days.count + 3 %>">

              <strong>
                <%= category.name %>
              </strong>

            </td>

          </tr>

          <% category.routine_indicators.each do |indicator| %>

            <% calculation = @calculation_results[indicator.id] %>

            <tr>

              <td>

                <strong>
                  <%= indicator.name %>
                </strong>

                <% if indicator.description.present? %>

                  <br>

                  <small class="text-muted">
                    <%= indicator.description %>
                  </small>

                <% end %>

              </td>

              <td class="text-center">

                <%= routine_value_display(
                      indicator,
                      calculation[:goal]
                    ) %>

              </td>

              <td
                id="routine-result-<%= indicator.id %>"
                class="text-center"
                data-routine-result-indicator-id="<%= indicator.id %>">

                <div data-routine-result-value>
                  <%= routine_value_display(
                        indicator,
                        calculation[:value]
                      ) %>
                </div>

                <span data-routine-result-status>

                  <% if calculation[:status] == :success %>

                    <span class="badge text-bg-success">
                      Meta atingida
                    </span>

                  <% elsif calculation[:status] == :danger %>

                    <span class="badge text-bg-danger">
                      Meta não atingida
                    </span>

                  <% elsif calculation[:status] == :partial %>

                    <span class="badge text-bg-warning">
                      Parcial —
                      <%= calculation[:filled_days] %>/<%= calculation[:total_days] %> dias
                    </span>

                  <% elsif calculation[:status] == :no_data %>

                    <span class="badge text-bg-secondary">
                      Sem dados
                    </span>

                  <% elsif calculation[:status] == :no_goal %>

                    <span class="badge text-bg-info">
                      Sem meta
                    </span>

                  <% elsif calculation[:status] == :manual %>

                    <span class="badge text-bg-secondary">
                      Manual
                    </span>

                  <% end %>

                </span>

              </td>

              <% @days.each_with_index do |day, column_index| %>

                <% value = @values_index[[indicator.id, day]] %>

                <td
                  class="routine-cell text-center"
                  data-controller="routine-cell"
                  data-action="click->routine-cell#edit"
                  data-routine-cell-id-value="<%= value.id %>"
                  data-routine-cell-raw-value-value="<%= value.value %>"
                  data-routine-cell-type-value="<%= indicator.value_type %>"
                  data-indicator-id="<%= indicator.id %>"
                  data-row="<%= @row_index[indicator.id] %>"
                  data-column="<%= column_index %>">

                  <span data-routine-cell-target="display">
                    <%= routine_value_display(
                          indicator,
                          value&.value
                        ) %>
                  </span>

                  <input
                    type="text"
                    class="routine-cell__input d-none"
                    data-routine-cell-target="input"
                    autocomplete="off">

                </td>

              <% end %>

            </tr>

          <% end %>

        <% end %>

      </tbody>

    </table>

  </div>

</div>

<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="routineActivitiesOffcanvas"
  aria-labelledby="routineActivitiesOffcanvasLabel">

  <div class="offcanvas-header border-bottom">

    <div>

      <h5
        class="offcanvas-title"
        id="routineActivitiesOffcanvasLabel">
        Atividades
      </h5>

      <div class="small text-muted">
        <%= @routine.title %>
      </div>

    </div>

    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas"
      aria-label="Fechar">
    </button>

  </div>

  <div class="offcanvas-body">

    <%= turbo_frame_tag "routine_activities_frame",
                        src: routine_activities_path(@routine) do %>

      <div class="text-center py-5 text-muted">

        <div
          class="spinner-border spinner-border-sm"
          role="status">
          <span class="visually-hidden">
            Carregando...
          </span>
        </div>

        <p class="mt-3 mb-0">
          Carregando atividades...
        </p>

      </div>

    <% end %>

  </div>

</div>
