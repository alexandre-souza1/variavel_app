<div
  class="container-fluid py-4"
  data-controller="routine-presence"
  data-routine-presence-routine-id-value="<%= @routine.id %>"
  data-routine-presence-current-user-id-value="<%= current_user.id %>">

  <%= turbo_stream_from [@routine, :collaboration] %>

  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

    <div>

      <h2 class="fw-bold">
        <%= @routine.title %>
      </h2>

      <p class="text-muted mb-0">
        <%= l(@routine.period_start) %>
        até
        <%= l(@routine.period_end) %>
      </p>

    </div>

    <div class="d-flex gap-2">

      <button
        type="button"
        class="btn btn-outline-secondary"
        data-bs-toggle="offcanvas"
        data-bs-target="#routineActivitiesOffcanvas"
        aria-controls="routineActivitiesOffcanvas">

        <i class="bi bi-clock-history me-1"></i>
        Atividades

      </button>

      <%= button_to routine_path(@routine),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: {
                      data: {
                        turbo_confirm: "Tem certeza que deseja excluir esta rotina? Os preenchimentos também serão apagados."
                      }
                    } do %>
        <i class="bi bi-trash3 me-1"></i>
        Excluir
      <% end %>

    </div>

  </div>

  <div
    class="accordion"
    id="routineFrequencyAccordion">

    <% opened_section = false %>

    <% @frequency_sections.each do |frequency, title| %>

      <% indicator_count = @categories.sum do |category|
           @indicators_by_frequency_and_category[
             [frequency, category.id]
           ].count
         end %>

      <% next if indicator_count.zero? %>

      <% section_open = !opened_section %>
      <% opened_section = true %>
      <% section_id = "routine-frequency-#{frequency}" %>

      <div class="accordion-item">

        <h2
          class="accordion-header"
          id="<%= section_id %>-heading">

          <button
            class="accordion-button <%= 'collapsed' unless section_open %>"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#<%= section_id %>-body"
            aria-expanded="<%= section_open %>"
            aria-controls="<%= section_id %>-body">

            <span class="fw-semibold">
              <%= title %>
            </span>

            <span class="badge text-bg-secondary ms-2">
              <%= indicator_count %>
            </span>

          </button>

        </h2>

        <div
          id="<%= section_id %>-body"
          class="accordion-collapse collapse <%= 'show' if section_open %>"
          aria-labelledby="<%= section_id %>-heading"
          data-bs-parent="#routineFrequencyAccordion">

          <div class="accordion-body p-0">

            <%= render "frequency_table",
                       frequency: frequency,
                       days: @days,
                       categories: @categories,
                       indicators_by_category:
                         @indicators_by_frequency_and_category,
                       values_index: @values_index,
                       expected_dates_index: @expected_dates_index,
                       row_index: @row_index,
                       calculation_results: @calculation_results %>

          </div>

        </div>

      </div>

    <% end %>

  </div>

</div>

<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="routineActivitiesOffcanvas"
  aria-labelledby="routineActivitiesOffcanvasLabel">

  <div class="offcanvas-header border-bottom">

    <div>

      <h5
        class="offcanvas-title"
        id="routineActivitiesOffcanvasLabel">
        Atividades
      </h5>

      <div class="small text-muted">
        <%= @routine.title %>
      </div>

    </div>

    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas"
      aria-label="Fechar">
    </button>

  </div>

  <div class="offcanvas-body">

    <%= turbo_frame_tag "routine_activities_frame",
                        src: routine_activities_path(@routine) do %>

      <div class="text-center py-5 text-muted">

        <div
          class="spinner-border spinner-border-sm"
          role="status">
          <span class="visually-hidden">
            Carregando...
          </span>
        </div>

        <p class="mt-3 mb-0">
          Carregando atividades...
        </p>

      </div>

    <% end %>

  </div>

</div>
