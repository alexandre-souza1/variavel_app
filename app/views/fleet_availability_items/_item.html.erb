<% variant = local_assigns.fetch(:variant, :default).to_sym %>
<% plate = item.plate %>
<% standard_plate = local_assigns[:standard_plate] %>
<% van_exception = variant == :special_route && item.van_profile_exception? %>
<% plate_changed = !van_exception && if variant == :special_route
                     standard_plate.present? && standard_plate.id != plate.id
                   else
                     variant == :availability && standard_plate&.id != plate&.id
                   end %>
<% reason_class = variant == :unavailable && item.reason.present? ? " fleet-plate-item--reason-#{item.reason}" : "" %>
<% editable = local_assigns.fetch(:editable, false) %>
<% tire_summary = @tire_summaries&.fetch(PlateUtils.normalizar(plate.placa), nil) %>
<% tread_depth = tire_summary&.dig(:minimum_tread_depth) %>
<% missing_tires_message = fleet_missing_tires_message(plate, tire_summary) if @tire_summaries && @tires_error.nil? %>

<article id="<%= dom_id(item) %>"
         class="fleet-plate-item fleet-plate-item--<%= variant %><%= reason_class %><%= ' fleet-plate-item--changed' if plate_changed %><%= ' fleet-plate-item--van-exception' if van_exception %> sortable-item"
         data-status="<%= item.status %>"
         data-setor="<%= plate.setor.presence || "-" %>"
         data-profile="<%= plate.perfil.presence || "Sem perfil" %>"
         data-plate-id="<%= plate.id %>"
         data-reason="<%= item.reason %>"
         data-supplier-id="<%= item.supplier_id %>"
         data-supplier-name="<%= item.supplier&.display_name %>"
         data-observation="<%= item.observation %>"
         data-van-plate="<%= item.van_plate? %>"
         data-tread-depth="<%= tread_depth %>"
         data-mobile-plate-label="<%= plate.placa %>"
         <% if editable %>
         data-action="click->fleet-availability#selectPlateForMobile keydown.enter->fleet-availability#selectPlateForMobile"
         role="button"
         tabindex="0"
         <% end %>
         title="<%= "#{item.reason_label}#{item.observation.present? ? " - #{item.observation}" : ""}" if variant == :unavailable %>">

  <span class="fleet-plate-item__line text-muted" data-line-label>
    <%= item.position.to_i + 1 %> -
  </span>

  <div class="fleet-plate-card fleet-vehicle-card">

    <div class="fleet-vehicle-card__header">

      <div class="fleet-vehicle-card__identity">
        <strong class="fleet-vehicle-card__plate">
          <%= link_to plate_path(plate), data: { plate_profile_link: true }, title: "Consulte informações da placa", aria: { label: "Abrir perfil da placa #{plate.placa}" } do %>
            <%= plate.placa %> <i class="bi bi-box-arrow-up-right fleet-vehicle-card__plate-link-icon" aria-hidden="true"></i>
          <% end %>
          <% if @plate_ids_without_monthly_departure&.include?(plate.id) %>
            <span class="fleet-vehicle-card__departure-alert"
                  data-fleet-departure-alert
                  data-fleet-card-alert
                  tabindex="0"
                  title="Carro sem saída no 2ART"
                  aria-label="Carro sem saída no 2ART">
              <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            </span>
          <% end %>
          <% if missing_tires_message %>
            <span class="fleet-vehicle-card__missing-tires-alert"
                  data-fleet-missing-tires-alert
                  data-fleet-card-alert
                  tabindex="0"
                  title="<%= missing_tires_message %>"
                  aria-label="<%= missing_tires_message %>">
              <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            </span>
          <% end %>
        </strong>

        <div class="fleet-vehicle-card__profile">
          <%= [plate.tipo.presence, plate.perfil.presence].compact.uniq.join(" · ").presence || "Tipo não informado" %>
        </div>
      </div>
      <% if tread_depth != nil %>
        <div class="fleet-vehicle-card__measurement">
            <span class="fleet-tread-depth-badge <%= tread_depth_badge_class(tread_depth) %>"
                  data-controller="tread-inspection"
                  data-tread-inspection
                  data-tread-inspection-url-value="<%= tread_inspection_fleet_availability_path(item.fleet_availability_id, plate_id: plate.id) %>"
                  data-action="mouseenter->tread-inspection#load focus->tread-inspection#load"
                  tabindex="0"
                  title="Consultando a última aferição de sulcos no Prolog…"
                  aria-label="Menor sulco dos pneus em uso, sem estepes: <%= number_with_precision(tread_depth, precision: 2, strip_insignificant_zeros: true) %> milímetros">
              <span class="fleet-tread-depth-badge__label">Sulco</span>
              <strong class="fleet-tread-depth-badge__value"><%= number_with_precision(tread_depth, precision: 2, strip_insignificant_zeros: true) %><small> mm</small></strong>
            </span>
        </div>
      <% end %>
    </div>

    <div class="fleet-vehicle-card__situation" data-situation-display
         <%= "hidden" unless [:availability, :special_route, :unavailable].include?(variant) %>>
      <div class="<%= variant == :unavailable ? "fleet-plate-card__defect-wrapper" : "fleet-plate-card__side" %>"
           <%= "hidden" unless [:availability, :special_route, :unavailable].include?(variant) %>
           data-live-details>
        <% if [:availability, :special_route].include?(variant) %>
          <span>
            Placa padrão:
            <%= standard_plate&.placa.presence || "não definida" %>
          </span>
          <% if van_exception %>
            <span class="fleet-plate-card__van-exception-badge" data-van-profile-exception>
              <i class="bi bi-truck" aria-hidden="true"></i> Exceção de perfil na Van
            </span>
          <% elsif plate_changed %>
            <span class="fleet-plate-card__changed-badge">
              <i class="bi bi-exclamation-triangle-fill"></i> Placa diferente
            </span>
          <% end %>
        <% elsif variant == :unavailable %>
          <div class="fleet-plate-card__defect" data-defect>
            <strong>
              <%= item.reason_label %>
            </strong>
          </div>
        <% end %>
      </div>
      <% if editable %>
        <button type="button" class="fleet-vehicle-card__edit" data-unavailable-edit
                <%= "hidden" unless item.unavailable? %>
                title="Editar indisponibilidade"
                aria-label="Editar indisponibilidade da placa <%= plate.placa %>">
          <i class="bi bi-pencil" aria-hidden="true"></i>
        </button>
      <% end %>
    </div>

    <div class="fleet-vehicle-card__supplier" data-supplier-display
         <%= "hidden" unless item.unavailable? && item.supplier.present? %>
         title="<%= item.supplier&.display_name %>">
      <i class="bi bi-shop" aria-hidden="true"></i>
      <span data-supplier-label><%= item.supplier&.display_name %></span>
    </div>

    <div class="fleet-plate-card__observation"
         <%= "hidden" if item.observation.blank? && (!editable || item.unavailable?) %>
         data-observation-display>
      <% if item.observation.present? %>
        <span>
          <%= item.observation %>
        </span>
      <% else %>
        <span>Adicionar observação</span>
      <% end %>

      <% if editable %>
        <button type="button"
                class="btn btn-sm btn-link fleet-plate-card__observation-button"
                <%= "hidden" if item.unavailable? %>
                aria-label="Editar observação da placa <%= plate.placa %>"
                data-observation-edit>
          <i class="bi bi-pencil-square"></i>
        </button>
      <% end %>
    </div>

  </div>

</article>
