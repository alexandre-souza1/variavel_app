<div class="az-import-page app-page">
  <div class="app-page-header">
    <div>
      <p class="app-page-eyebrow"><i class="bi bi-box-seam me-1" aria-hidden="true"></i> Armazém · Remuneração variável</p>
      <h1>Central de importações AZ</h1>
      <p class="text-muted mb-0">Centralize os arquivos usados nos cálculos de operadores e ajudantes.</p>
    </div>
    <%= link_to "Voltar para consultas", az_consultas_new_path, class: "btn btn-outline-secondary" %>
  </div>


  <nav class="az-import-nav" aria-label="Seções da central de importações">
    <a href="#arquivos-az"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Arquivos CSV</a>
    <a href="#manual-az"><i class="bi bi-pencil-square" aria-hidden="true"></i> Lançamento manual</a>
    <% if current_user&.admin? %><a href="#contingencia-az"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Contingência</a><% end %>
    <a href="#historico-az"><i class="bi bi-clock-history" aria-hidden="true"></i> Histórico</a>
  </nav>

  <div id="arquivos-az" class="app-panel az-import-panel">
    <div class="az-import-heading">
      <span class="az-import-icon"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i></span>
      <div><h2>Importar arquivos da operação</h2><p>Selecione um ou mais relatórios CSV para atualizar a variável.</p></div>
      <span class="az-import-tag">CSV</span>
    </div>
    <div class="app-panel__body">
      <%= form_with url: import_az_consultas_path, method: :post, local: true, multipart: true do |form| %>
        <div class="row g-4">
          <div class="col-12 col-lg-4">
            <div class="az-import-upload">
            <i class="bi bi-stars az-import-upload-icon" aria-hidden="true"></i>
            <%= form.label :points_file, "Pontos", class: "form-label fw-semibold" %>
            <%= form.file_field :points_file, accept: ".csv", class: "form-control" %>
            <div class="form-text">O relatório não traz a data. Informe abaixo o dia em que esses pontos foram gerados.</div>
          <div class="mt-3">
            <%= form.label :points_reference_date, "Data dos pontos", class: "form-label fw-semibold" %>
            <%= form.date_field :points_reference_date, value: Date.current, class: "form-control" %>
          </div>
            </div>
          </div>

          <div class="col-12 col-lg-4">
            <div class="az-import-upload">
            <i class="bi bi-boxes az-import-upload-icon" aria-hidden="true"></i>
            <%= form.label :tasks_file, "Tarefas WMS / Refugo", class: "form-label fw-semibold" %>
            <%= form.file_field :tasks_file, accept: ".csv", class: "form-control" %>
            <div class="form-text">Alimenta os operadores e importa somente Blitz Refugo para os ajudantes.</div>
            </div>
          </div>

          <div class="col-12 col-lg-4">
            <div class="az-import-upload">
            <i class="bi bi-clipboard-check az-import-upload-icon" aria-hidden="true"></i>
            <%= form.label :ondemand_file, "On Demand", class: "form-label fw-semibold" %>
            <%= form.file_field :ondemand_file, accept: ".csv", class: "form-control" %>
            <div class="form-text">Atividades adicionais e suas observações.</div>
            </div>
          </div>


        </div>

        <div class="d-flex flex-wrap align-items-center gap-3 mt-4 pt-3 border-top">
          <%= form.submit "Importar arquivos", class: "btn btn-primary", data: { turbo_submits_with: "Importando…" } %>
          <span class="text-muted small">Os arquivos já importados não serão duplicados.</span>
        </div>
      <% end %>

      <div class="az-import-note mt-3">
        <i class="bi bi-info-circle me-1"></i>
        O arquivo de tarefas é processado uma única vez e compartilhado entre WMS, operadores e ajudantes.
      </div>
    </div>
  </div>

  <div id="manual-az" class="app-panel az-import-panel mt-4">
    <div class="app-panel__body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
          <p class="app-page-eyebrow"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Resultado diário</p>
          <h2 class="h5 mb-0">Lançamento manual de resultado diário</h2>
        </div>
        <%= link_to "Abrir cadastro completo", az_mapas_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

      <%= form_with model: @az_mapa, url: az_mapas_path, class: "row g-3", local: true, data: { controller: "resultado" } do |form| %>
        <div class="col-12 col-md-6 col-lg-3">
          <%= form.label :data, "Data", class: "form-label fw-semibold" %>
          <%= form.date_field :data, required: true, class: "form-control" %>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
          <%= form.label :tipo, "Tipo de meta", class: "form-label fw-semibold" %>
          <%= form.select :tipo,
                AzMapa.tipos.keys.map { |k| [k.humanize.titleize, k] },
                {},
                { required: true, class: "form-select", data: { resultado_target: "tipo", action: "change->resultado#atualizar" } } %>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
          <div class="mb-2" data-resultado-target="grupo" style="display: none;">
            <%= form.label :resultado, "Resultado", class: "form-label fw-semibold" %>
            <div class="input-group" data-resultado-target="campoWrapper"></div>
            <span class="input-group-text d-none" data-resultado-target="sufixo"></span>
            <small data-resultado-target="unidade" class="text-muted d-block mt-1"></small>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
          <div class="form-check mt-3">
            <%= form.check_box :atingiu_meta, class: "form-check-input", id: "az_mapas_import_atingiu_meta" %>
            <%= form.label :atingiu_meta, "Atingiu meta?", class: "form-check-label", for: "az_mapas_import_atingiu_meta" %>
          </div>
        </div>

        <div class="col-12 d-flex flex-wrap align-items-center gap-3 pt-2 border-top">
          <%= form.submit "Salvar lançamento", class: "btn btn-primary" %>
          <span class="text-muted small">Os turnos do tipo escolhido são gerados automaticamente.</span>
        </div>
      <% end %>
    </div>
  </div>

  <% if current_user&.admin? %>
    <section id="contingencia-az" class="app-panel az-import-contingency mt-4" aria-labelledby="contingencia-heading">
      <div class="app-panel__body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <p class="text-uppercase text-muted small fw-semibold mb-1">Resultados diários · Excel</p>
          <h2 id="contingencia-heading" class="h5">Importação de contingência</h2>
          <p class="text-muted mb-0">Importe planilhas de EFC, TMA e EFD para lançar vários dias de uma vez, preservando os lançamentos existentes.</p>
        </div>
        <%= link_to import_az_mapas_path, class: "btn btn-outline-primary" do %>
          <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i> Importar EFC, TMA e EFD
        <% end %>
      </div>
    </section>
  <% end %>

    <section id="historico-az" class="app-panel az-import-panel mt-4">
      <div class="az-import-heading">
        <span class="az-import-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
        <div><h2>Últimas importações</h2><p>Acompanhe os últimos arquivos de pontos, tarefas e On Demand.</p></div>
      </div>
      <% if @recent_imports.any? %>
      <div class="table-responsive app-table-shell">
        <table class="table app-table app-table--data align-middle mb-0">
          <thead>
            <tr>
              <th>Fonte</th>
              <th>Arquivo</th>
              <th>Data dos pontos</th>
              <th>Linhas</th>
              <th>Status</th>
              <th>Importado em</th>
              <% if current_user.admin? || current_user.supervisor? %>
                <th class="text-end">Ações</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @recent_imports.each do |item| %>
              <tr>
                <td><%= item.source_label %></td>
                <td class="text-truncate" style="max-width: 260px" title="<%= item.original_filename %>"><%= item.original_filename %></td>
                <td><%= l(item.reference_date, format: :short) if item.reference_date %></td>
                <td><%= item.rows_imported %></td>
                <td><span class="badge text-bg-<%= item.status == 'completed' ? 'success' : 'danger' %>"><%= item.status == 'completed' ? 'Concluída' : 'Falhou' %></span></td>
                <td><%= l(item.created_at, format: :short) %></td>
                <% if current_user.admin? || current_user.supervisor? %>
                  <td class="text-end">
                    <%= button_to destroy_az_consultas_import_path(item), method: :delete,
                                  class: "btn btn-sm btn-outline-danger",
                                  form: { class: "d-inline" },
                                  data: { turbo_confirm: "Excluir esta importação e todos os dados vinculados? Essa ação não pode ser desfeita." } do %>
                      <i class="bi bi-trash me-1"></i> Excluir
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% else %>
        <div class="az-import-empty">
          <i class="bi bi-inbox" aria-hidden="true"></i>
          <h3>Nenhum arquivo importado ainda</h3>
          <p>Após importar os relatórios CSV, acompanhe o histórico por aqui.</p>
        </div>
      <% end %>
    </section>
</div>
