<div class="az-operator-report-page">
  <header class="az-report-header">
    <div class="az-report-header-content">
      <div>
        <p class="az-report-eyebrow"><i class="bi bi-graph-up-arrow me-1"></i> Remuneração variável · Operador</p>
        <h1 class="az-report-title">
          <i class="bi bi-person-circle"></i>
          <%= @operator&.nome || "Relatório de operador" %>
        </h1>
        <p class="az-report-subtitle">Resumo da variável coletiva e das tarefas individuais do período</p>
        <div class="az-report-meta">
          <span><i class="bi bi-person-badge"></i> Matrícula <strong><%= @matricula %></strong></span>
          <span><i class="bi bi-clock"></i> Turno <strong><%= @turno == 0 ? "A/C" : (@turno == 1 ? "B" : "C") %></strong></span>
          <% if @data_inicio && @data_fim %>
            <span><i class="bi bi-calendar3"></i> <%= l(@data_inicio) %> a <%= l(@data_fim) %></span>
          <% end %>
        </div>
      </div>

      <div class="az-report-actions">
        <%= link_to az_consultas_new_path, class: "az-report-back-link" do %>
          <i class="bi bi-arrow-left"></i> Voltar
        <% end %>

        <%= form_with url: az_consulta_path, method: :get, local: true,
                      class: "az-period-filter",
                      data: { controller: "autosubmit", autosubmit_target: "form" } do %>
          <%= hidden_field_tag :matricula, @matricula %>
          <%= hidden_field_tag :turno, @turno %>

          <div class="az-period-field">
            <%= label_tag :periodo_mes, "Mês" %>
            <%= select_tag :periodo_mes,
                options_for_select((1..12).map { |month| [I18n.t("date.month_names")[month], month] }, @periodo_mes),
                class: "form-select form-select-sm",
                data: { autosubmit_target: "select", action: "change->autosubmit#submitOnChange" },
                required: true %>
          </div>

          <div class="az-period-field">
            <%= label_tag :periodo_ano, "Ano" %>
            <%= select_tag :periodo_ano,
                options_for_select((Date.current.year - 5..Date.current.year).to_a.reverse, @periodo_ano || Date.current.year),
                class: "form-select form-select-sm",
                data: { autosubmit_target: "select", action: "change->autosubmit#submitOnChange" },
                required: true %>
          </div>

          <%= submit_tag "Atualizar", class: "az-period-submit" %>
        <% end %>
      </div>
    </div>
  </header>

  <div class="az-report-flashes">
    <%= render "shared/flashes" %>
  </div>

  <section class="az-report-overview" aria-label="Resumo da variável do operador">
    <div class="az-overview-card az-overview-card--total">
      <div class="az-overview-label"><i class="bi bi-cash-coin"></i> Total da variável</div>
      <div class="az-overview-value"><%= number_to_currency(@total_operator_variable, unit: "R$ ", separator: ",", delimiter: ".") %></div>
      <div class="az-overview-detail">Mapas coletivos + WMS individual</div>
    </div>

    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-stopwatch"></i> TMA</div>
      <div class="az-overview-value"><%= number_to_currency(@total_valor_tma, unit: "R$ ", separator: ",", delimiter: ".") %></div>
      <div class="az-overview-detail">Tempo médio de atendimento</div>
    </div>

    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-speedometer2"></i> <%= [0, 2].include?(@turno) ? "EFC" : "EFD" %></div>
      <div class="az-overview-value"><%= number_to_currency(@total_valor_efc, unit: "R$ ", separator: ",", delimiter: ".") %></div>
      <div class="az-overview-detail"><%= [0, 2].include?(@turno) ? "Eficiência de carregamento" : "Eficiência de descarga" %></div>
    </div>

    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-list-task"></i> WMS</div>
      <div class="az-overview-value"><%= number_to_currency(@total_wms, unit: "R$ ", separator: ",", delimiter: ".") %></div>
      <div class="az-overview-detail"><%= @wms_tasks.respond_to?(:total_count) ? @wms_tasks.total_count : @wms_tasks.size %> tarefa(s) no período</div>
    </div>
  </section>

  <section class="az-report-grid">
    <article class="az-report-panel">
      <div class="az-panel-header">
        <div>
          <h2><i class="bi bi-bar-chart-fill az-panel-icon me-2"></i>Painel de totais</h2>
          <p>Composição da variável calculada para este fechamento.</p>
        </div>
      </div>
      <div class="az-panel-body">
        <div class="az-total-list">
          <div class="az-total-row">
            <span class="az-total-name"><span class="az-total-dot"></span>Tempo Médio de Atendimento</span>
            <span class="az-total-amount"><%= number_to_currency(@total_valor_tma, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
          <div class="az-total-row">
            <span class="az-total-name"><span class="az-total-dot"></span><%= [0, 2].include?(@turno) ? "Eficiência de Carregamento" : "Eficiência de Descarga" %></span>
            <span class="az-total-amount"><%= number_to_currency(@total_valor_efc, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
          <div class="az-total-row">
            <span class="az-total-name"><span class="az-total-dot"></span>WMS individual</span>
            <span class="az-total-amount"><%= number_to_currency(@total_wms, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
          <div class="az-total-row az-total-row--grand">
            <span class="az-total-name"><i class="bi bi-check2-circle"></i>Total geral</span>
            <span class="az-total-amount"><%= number_to_currency(@total_operator_variable, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
        </div>
      </div>
    </article>

    <article class="az-report-panel">
      <div class="az-panel-header">
        <div>
          <h2><i class="bi bi-sliders az-panel-icon me-2"></i>Parâmetros de cálculo</h2>
          <p>Valores configurados para o turno consultado.</p>
        </div>
      </div>
      <div class="az-panel-body">
        <div class="az-period-details">
          <div class="az-detail-item"><span>Valor TMA</span><span><%= number_to_currency(@valor_tma_operator, unit: "R$ ", separator: ",", delimiter: ".") %></span></div>
          <div class="az-detail-item"><span><%= [0, 2].include?(@turno) ? "Valor EFC" : "Valor EFD" %></span><span><%= number_to_currency(@valor_efc_operator, unit: "R$ ", separator: ",", delimiter: ".") %></span></div>
          <div class="az-detail-item"><span>Valor WMS</span><span><%= number_to_currency(@valor_wms_operator, unit: "R$ ", separator: ",", delimiter: ".") %></span></div>
          <div class="az-detail-item"><span>Dias no período</span><span><%= @dias_periodo || "—" %></span></div>
        </div>
      </div>
    </article>
  </section>

  <div class="az-report-note">
    <i class="bi bi-info-circle-fill"></i>
    <span>Esta é uma prévia da variável coletiva por turno. Todos os operadores do mesmo turno recebem o mesmo valor nos mapas coletivos.</span>
  </div>

  <article class="az-report-panel mb-4">
    <div class="az-panel-header">
      <div>
        <h2 class="az-report-section-title"><i class="bi bi-map"></i> Detalhes dos mapas coletivos</h2>
        <p>Resultados de TMA e eficiência considerados no período.</p>
      </div>
    </div>

    <div class="az-report-table-wrap">
      <table class="az-report-table">
        <thead>
          <tr>
            <th>Data</th>
            <th>Tipo</th>
            <th>Resultado</th>
            <th>Meta atingida</th>
            <th class="text-end">Valor obtido</th>
          </tr>
        </thead>
        <tbody>
          <% if params[:periodo_mes].present? && @azmapas.any? %>
            <% @azmapas.each do |mapa| %>
              <%
                if [0, 2].include?(@turno)
                  valor_tma = mapa.tipo == "tempo_atendimento" && mapa.atingiu_meta ? @valor_tma_operator : 0
                  valor_efc = mapa.tipo == "eficiencia_carregamento" && mapa.atingiu_meta ? @valor_efc_operator : 0
                else
                  valor_tma = mapa.tipo == "tempo_atendimento" && mapa.atingiu_meta ? @valor_tma_operator : 0
                  valor_efc = mapa.tipo == "eficiencia_descarga" && mapa.atingiu_meta ? @valor_efc_operator : 0
                end
                valor = valor_tma + valor_efc

                resultado_formatado = case mapa.tipo.to_s
                  when "eficiencia_carregamento", "eficiencia_descarga" then number_to_percentage(mapa.resultado, precision: 2)
                  when "tempo_atendimento"
                    decimal = mapa.resultado.to_f
                    horas = decimal.floor
                    minutos = ((decimal - horas) * 60).round
                    "#{horas}:#{minutos.to_s.rjust(2, "0")} h"
                  else mapa.resultado
                end
              %>
              <tr>
                <td data-label="Data"><%= mapa.data.strftime("%d/%m/%Y") %></td>
                <td data-label="Tipo"><%= mapa.tipo.humanize.titleize %></td>
                <td data-label="Resultado"><%= resultado_formatado %></td>
                <td data-label="Meta atingida"><%= mapa.atingiu_meta ? "Sim" : "Não" %></td>
                <td data-label="Valor obtido" class="text-end az-table-total"><%= number_to_currency(valor, unit: "R$ ", separator: ",", delimiter: ".") %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="5" class="az-report-empty text-center"><%= params[:periodo_mes].present? ? "Nenhum mapa encontrado para este período." : "Selecione um mês para visualizar os mapas." %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </article>

  <article class="az-report-panel">
    <div class="az-panel-header">
      <div>
        <h2 class="az-report-section-title"><i class="bi bi-list-task"></i> Tarefas WMS do operador</h2>
        <p>Atividades individuais com duração mínima considerada para remuneração.</p>
      </div>
      <% if params[:periodo_mes].present? %>
        <span class="az-overview-detail"><%= I18n.t("date.month_names")[params[:periodo_mes].to_i].capitalize %></span>
      <% end %>
    </div>

    <div class="az-report-table-wrap">
      <table class="az-report-table az-report-table--wide">
        <thead>
          <tr>
            <th>Tipo</th>
            <th>Código</th>
            <th>Placa</th>
            <th>Palete</th>
            <th>Início</th>
            <th>Término</th>
            <th class="text-end">Duração</th>
            <th class="text-end">Valor</th>
          </tr>
        </thead>
        <tbody>
          <% if params[:periodo_mes].present? && @wms_tasks.any? %>
            <% @wms_tasks.each do |task| %>
              <% valor_tarefa = task.duration.to_f >= 10 ? @valor_wms_operator : 0 %>
              <tr>
                <td data-label="Tipo"><%= task.task_type %></td>
                <td data-label="Código"><%= task.task_code %></td>
                <td data-label="Placa"><%= task.plate %></td>
                <td data-label="Palete"><%= task.pallet %></td>
                <td data-label="Início"><%= task.started_at&.strftime("%d/%m/%Y %H:%M") || "-" %></td>
                <td data-label="Término"><%= task.ended_at&.strftime("%d/%m/%Y %H:%M") || "-" %></td>
                <td data-label="Duração" class="text-end"><%= task.duration.to_f.round(2) %> min</td>
                <td data-label="Valor" class="text-end az-table-total"><%= number_to_currency(valor_tarefa, unit: "R$ ", separator: ",", delimiter: ".") %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="8" class="az-report-empty text-center"><%= params[:periodo_mes].present? ? "Nenhuma tarefa WMS encontrada para este período." : "Selecione um mês para visualizar as tarefas WMS." %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if params[:periodo_mes].present? && @wms_tasks.any? %>
      <div class="az-report-pagination py-3">
        <%= render partial: "shared/pagination", locals: {
              current_page: @current_page || 1,
              total_pages: @total_pages || 1,
              path: ->(page) { url_for(params.permit!.to_h.merge(page: page)) }
            } %>
      </div>
    <% end %>
  </article>
</div>
