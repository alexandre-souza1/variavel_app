<div class="az-consultas-new-page" data-controller="az-consultas-form">
  <header class="az-new-header">
    <div>
      <p class="az-new-eyebrow"><i class="bi bi-grid-1x2 me-1"></i> Workstation LOG20 · Foz do Iguaçu</p>
      <h1 class="az-new-title"><i class="bi bi-clipboard-data"></i> Consulta de variável</h1>
      <p class="az-new-subtitle">Escolha o turno para consultar a variável de operadores e ajudantes usando a matrícula.</p>
    </div>

    <div class="az-new-header-actions">
      <%= render "shared/unit_dream" %>
    </div>
  </header>

  <section aria-labelledby="turnos-heading">
    <div class="az-new-section-heading">
      <div>
        <h2 id="turnos-heading"><i class="bi bi-clock-history"></i> Selecione o turno</h2>
        <p>A matrícula identifica automaticamente se o colaborador é operador ou ajudante.</p>
      </div>
      <div class="az-new-section-heading__actions">
        <span class="text-muted small">Toque novamente no turno para fechar a consulta</span>
        <%= link_to downloads_path, class: "az-new-link az-new-link--primary" do %>
          <i class="bi bi-file-earmark-text"></i> Central de padrões
        <% end %>
      </div>
    </div>

    <div class="az-turno-grid">
      <div data-action="click->az-consultas-form#mostrarFormulario"
           class="az-turno-card"
           data-turno="0"
           role="button"
           tabindex="0"
           aria-label="Consultar turno A"
           style="background-image: url('<%= asset_path("turno_a.jpg") %>')">
        <span class="az-turno-label">Turno A</span>
        <span class="az-turno-action">Consultar variável <i class="bi bi-arrow-right-circle"></i></span>
      </div>

      <div data-action="click->az-consultas-form#mostrarFormulario"
           class="az-turno-card"
           data-turno="1"
           role="button"
           tabindex="0"
           aria-label="Consultar turno B"
           style="background-image: url('<%= asset_path("turno_b.webp") %>')">
        <span class="az-turno-label">Turno B</span>
        <span class="az-turno-action">Consultar variável <i class="bi bi-arrow-right-circle"></i></span>
      </div>

      <div data-action="click->az-consultas-form#mostrarFormulario"
           class="az-turno-card"
           data-turno="2"
           role="button"
           tabindex="0"
           aria-label="Consultar turno C"
           style="background-image: url('<%= asset_path("turno_c.jpg") %>')">
        <span class="az-turno-label">Turno C</span>
        <span class="az-turno-action">Consultar variável <i class="bi bi-arrow-right-circle"></i></span>
      </div>
    </div>
  </section>

  <section id="formulario-consulta" class="az-new-form-area d-none" data-az-consultas-form-target="formulario" aria-live="polite">
    <article class="az-new-form-panel">
      <div class="az-new-form-header">
        <div>
          <h2 id="titulo-form" data-az-consultas-form-target="titulo">Consultar</h2>
          <p>Informe a matrícula para abrir o relatório do período.</p>
        </div>
        <i class="bi bi-search az-new-form-icon"></i>
      </div>

      <div class="az-new-form-body">
        <%= form_with url: az_consulta_path, method: :get, local: true, html: { id: "consulta-form" } do %>
          <%= hidden_field_tag :turno, nil, id: "turno_oculto", data: { "az-consultas-form-target": "turnoInput" } %>

          <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-8">
              <%= label_tag :matricula, "Matrícula", class: "az-new-field-label" %>
              <%= text_field_tag :matricula, params[:matricula], class: "form-control form-control-lg az-new-form-control", inputmode: "numeric", placeholder: "Digite sua matrícula", required: true %>
            </div>
            <div class="col-12 col-lg-4 d-grid">
              <%= button_tag type: "submit", class: "az-new-submit" do %>
                <i class="bi bi-arrow-right"></i>
                Consultar variável
              <% end %>
            </div>
          </div>
        <% end %>

        <p class="az-new-form-help">
          <i class="bi bi-info-circle-fill"></i>
          <span>O período pode ser selecionado dentro do relatório depois da consulta.</span>
        </p>
      </div>
    </article>
  </section>

  <section class="az-new-resource-grid">
    <%= render "shared/consulta_quick_access", origin: "az" %>

    <article class="az-new-info-panel">
      <div class="az-new-panel-header">
        <h2><i class="bi bi-sliders"></i> Parâmetros de cálculo</h2>
        <p>Valores atualmente configurados para operadores.</p>
      </div>
      <div class="az-new-parameters">
        <% Array(@parametros&.dig("operador")).each do |param| %>
          <% nome = nome_legivel_parametro(param.nome) %>
          <div class="az-new-parameter">
            <strong><%= nome %></strong>
            <span>R$ <%= number_with_precision(param.valor.to_f, precision: 2, separator: ",") %><%= sufixo_parametro(nome) %></span>
          </div>
        <% end %>

        <% if Array(@parametros&.dig("operador")).empty? %>
          <p class="text-muted text-center mb-0">Nenhum parâmetro encontrado.</p>
        <% end %>
      </div>
    </article>
  </section>
</div>

<%= public_variable_chat_widget %>
