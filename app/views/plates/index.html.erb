<% inactive = params[:status] == "inactive" %>
<div class="dashboard-page plates-index-page">
  <header class="dashboard-header">
    <div class="header-content">
      <div>
        <p class="dashboard-eyebrow">Frota · Cadastro</p>
        <h1><i class="bi bi-truck-front"></i> Placas</h1>
        <p class="subtitle">Veículos e equipamentos da operação, em um só lugar.</p>
      </div>
      <div class="header-actions">
        <%= link_to root_path, class: "btn-outline" do %>
          <i class="bi bi-arrow-left"></i> Voltar
        <% end %>
        <%= link_to new_plate_path, class: "btn-primary-solid" do %>
          <i class="bi bi-plus-lg"></i> Nova placa
        <% end %>
      </div>
    </div>
  </header>

  <div class="kpi-grid">
    <% [
      [inactive ? "Placas inativas" : "Placas ativas", @plates.size, "truck", "primary"],
      ["Armazém", @plates.count { |plate| plate.setor == "ARMAZEM" }, "building", "success"],
      ["Rota", @plates.count { |plate| plate.setor == "ROTA" }, "sign-turn-right", "warning"]
    ].each do |label, count, icon, color| %>
      <div class="kpi-card">
        <div class="kpi-icon bg-<%= color %>-soft"><i class="bi bi-<%= icon %> text-<%= color %>"></i></div>
        <div class="kpi-info">
          <span class="kpi-label"><%= label %></span>
          <span class="kpi-value"><%= count %></span>
          <small class="text-muted">Na seleção atual</small>
        </div>
      </div>
    <% end %>
  </div>

  <section class="app-panel plates-register" aria-labelledby="plates-heading">
    <div class="app-panel__header plates-register-header">
      <div class="dashboard-panel-heading">
        <span class="dashboard-panel-kicker">Registro · Operação</span>
        <h2 id="plates-heading">Placas <%= inactive ? "inativas" : "ativas" %></h2>
        <small><%= inactive ? "Histórico preservado, com opção de reativação." : "Consulte os detalhes e mantenha o cadastro da frota em dia." %></small>
      </div>
      <nav class="plates-status-tabs" aria-label="Status das placas">
        <% [["Ativas", nil], ["Inativas", "inactive"]].each do |label, status| %>
          <% selected = inactive == (status == "inactive") %>
          <%= link_to label, plates_path(request.query_parameters.slice("placa", "setor", "tipo", "perfil").merge("status" => status)),
                class: "plates-status-tab #{'is-active' if selected}", aria: { current: selected ? "page" : nil } %>
        <% end %>
      </nav>
    </div>
    <div class="app-panel__body">
      <%= form_with url: plates_path, method: :get, local: true, class: "plates-filters" do %>
        <%= hidden_field_tag :status, "inactive" if inactive %>
        <div>
          <%= label_tag :placa, "Buscar placa", class: "form-label" %>
          <%= text_field_tag :placa, params[:placa], class: "form-control", placeholder: "Ex.: ABC1D23" %>
        </div>
        <div>
          <%= label_tag :setor, "Setor", class: "form-label" %>
          <%= select_tag :setor, options_for_select([["Todos", ""], ["Armazém", "ARMAZEM"], ["Rota", "ROTA"]], params[:setor]), class: "form-select" %>
        </div>
        <div>
          <%= label_tag :tipo, "Tipo", class: "form-label" %>
          <%= select_tag :tipo, options_for_select([["Todos", ""]] + Plate::TIPOS, params[:tipo]), class: "form-select" %>
        </div>
        <div>
          <%= label_tag :perfil, "Perfil", class: "form-label" %>
          <%= select_tag :perfil, options_for_select([["Todos", ""]] + Plate::PERFIS, params[:perfil]), class: "form-select" %>
        </div>
        <div class="plates-filter-actions">
          <%= submit_tag "Filtrar", class: "btn-primary-solid" %>
          <%= link_to "Limpar", plates_path(status: inactive ? "inactive" : nil), class: "btn-outline" %>
        </div>
      <% end %>

      <% if @plates.any? %>
        <div class="dashboard-table-wrapper">
          <table class="table align-middle dashboard-data-table plates-table mb-0">
            <thead>
              <tr>
                <th scope="col">Placa</th>
                <th scope="col">Setor</th>
                <th scope="col">Perfil</th>
                <th scope="col">Tipo</th>
                <th scope="col">Menor sulco</th>
                <th scope="col">Pneus</th>
                <th scope="col">Estepe</th>
                <th scope="col" class="text-end">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% @plates.each do |plate| %>
                <% tire_summary = @tire_summaries[PlateUtils.normalizar(plate.placa)] %>
                <% expected_tires = plate.tire_layout&.sum { |axle| axle[:tires] } %>
                <% actual_tires = tire_summary&.dig(:operational_count) %>
                <% tire_percent = expected_tires.to_i.positive? ? [(actual_tires.to_i * 100.0 / expected_tires).round, 100].min : 0 %>
                <% tracks_tires = plate.setor != "ARMAZEM" %>
                <tr>
                  <td><%= link_to plate.placa, plate_path(plate), class: "plates-identity" %></td>
                  <td><span class="plates-sector"><i class="bi bi-<%= plate.setor == 'ARMAZEM' ? 'building' : 'sign-turn-right' %>" aria-hidden="true"></i> <%= plate.setor == "ARMAZEM" ? "Armazém" : "Rota" %></span></td>
                  <td><%= plate.perfil.presence || "—" %></td>
                  <td><%= plate.tipo %></td>
                  <td>
                    <% if !tracks_tires %>
                      <span class="plates-tire-muted">—</span>
                    <% elsif @tires_error %>
                      <span class="plates-tire-muted">Indisponível</span>
                    <% elsif tire_summary&.dig(:minimum_tread_depth) %>
                      <% depth = tire_summary[:minimum_tread_depth] %>
                      <span class="plates-tread-badge <%= depth <= 3.5 ? 'is-danger' : depth < 5 ? 'is-warning' : 'is-good' %>"><%= number_with_precision(depth, precision: 2, strip_insignificant_zeros: true) %> mm</span>
                    <% else %>
                      <span class="plates-tire-muted">Sem medição</span>
                    <% end %>
                  </td>
                  <td>
                    <% if !tracks_tires %>
                      <span class="plates-tire-muted">—</span>
                    <% elsif expected_tires && @tires_error.nil? %>
                      <div class="plates-tire-count" aria-label="<%= actual_tires %> de <%= expected_tires %> pneus cadastrados">
                        <strong><%= actual_tires %>/<%= expected_tires %></strong>
                        <span class="plates-tire-progress" role="progressbar" aria-valuenow="<%= actual_tires %>" aria-valuemin="0" aria-valuemax="<%= expected_tires %>"><i style="width: <%= tire_percent %>%"></i></span>
                      </div>
                    <% elsif expected_tires %>
                      <span class="plates-tire-muted">—/<%= expected_tires %></span>
                    <% else %>
                      <span class="plates-tire-muted">—</span>
                    <% end %>
                  </td>
                  <td>
                    <% if !tracks_tires %>
                      <span class="plates-tire-muted">—</span>
                    <% elsif @tires_error %>
                      <span class="plates-spare-badge is-muted">Indisponível</span>
                    <% elsif tire_summary&.dig(:spare_count).to_i.positive? %>
                      <span class="plates-spare-badge is-present"><i class="bi bi-check2"></i> Cadastrado</span>
                    <% else %>
                      <span class="plates-spare-badge is-missing"><i class="bi bi-x"></i> Ausente</span>
                    <% end %>
                  </td>
                  <td>
                    <div class="plates-row-actions">
                      <%= link_to edit_plate_path(plate), class: "plates-icon-action", title: "Editar placa", aria: { label: "Editar placa #{plate.placa}" } do %>
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                      <% end %>
                      <% if plate.active? %>
                        <%= button_to retire_plate_path(plate), method: :patch,
                              form: { data: { turbo_confirm: "Inativar esta placa? O histórico será preservado." } },
                              class: "plates-icon-action", title: "Inativar placa", aria: { label: "Inativar placa #{plate.placa}" } do %>
                          <i class="bi bi-archive" aria-hidden="true"></i>
                        <% end %>
                      <% else %>
                        <%= button_to reactivate_plate_path(plate), method: :patch,
                              class: "plates-icon-action", title: "Reativar placa", aria: { label: "Reativar placa #{plate.placa}" } do %>
                          <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="plates-result-count">Exibindo <strong><%= @plates.size %></strong> placas <%= inactive ? "inativas" : "ativas" %>.</p>
      <% else %>
        <div class="plates-empty">
          <i class="bi bi-search" aria-hidden="true"></i>
          <h3>Nenhuma placa encontrada</h3>
          <p>Revise os filtros ou alterne entre placas ativas e inativas.</p>
        </div>
      <% end %>

      <details class="plates-import">
        <summary><i class="bi bi-upload" aria-hidden="true"></i> Importar placas por CSV</summary>
        <%= form_with url: import_plates_path, local: true, html: { multipart: true, class: "plates-import-form" } do |form| %>
          <div>
            <%= form.label :file, "Arquivo CSV", class: "form-label" %>
            <%= form.file_field :file, class: "form-control", accept: ".csv,text/csv", required: true %>
          </div>
          <%= form.submit "Importar CSV", class: "btn-outline" %>
        <% end %>
      </details>
    </div>
  </section>
</div>
