<div class="dashboard-page plate-profile-page">
  <header class="dashboard-header">
    <div class="header-content">
      <div>
        <p class="dashboard-eyebrow">Frota · Perfil do veículo</p>
        <div class="plate-title">
          <h1><i class="bi bi-truck-front"></i> <%= @plate.placa %></h1>
          <span class="plate-status <%= 'is-active' if @plate.active? %>"><%= @plate.active? ? "Ativa" : "Inativa" %></span>
        </div>
        <p class="subtitle"><%= [@plate.setor, @plate.tipo, @plate.perfil].compact_blank.join(" · ") %></p>
      </div>
      <div class="header-actions">
        <%= link_to plates_path, class: "btn-outline" do %><i class="bi bi-arrow-left"></i> Placas<% end %>
        <%= link_to edit_plate_path(@plate), class: "btn-primary-solid" do %><i class="bi bi-pencil-square"></i> Editar placa<% end %>
      </div>
    </div>
  </header>

  <div class="kpi-grid">
    <% [
      ["Pneus em uso", @tires_error ? "—" : @tires.size, "circle", "primary", @tires_error ? "Consulta indisponível" : "Instalados · sem estepes"],
      ["No limite de recape", @tires_error ? "—" : @retread_count, "exclamation-triangle", "danger", "Menor sulco até 3,5 mm"],
      ["Saídas registradas", @mapa_exits.size, "sign-turn-right", "success", "Histórico dos mapas"],
      ["Tarefas relacionadas", @mentioned_tasks.size, "list-check", "warning", "Acompanhamento da placa"]
    ].each do |label, value, icon, color, note| %>
      <div class="kpi-card">
        <div class="kpi-icon bg-<%= color %>-soft"><i class="bi bi-<%= icon %> text-<%= color %>"></i></div>
        <div class="kpi-info">
          <span class="kpi-label"><%= label %></span>
          <span class="kpi-value"><%= value %></span>
          <small><%= note %></small>
        </div>
      </div>
    <% end %>
    <% observation = @current_observation %>
    <div class="kpi-card plate-observation-card <%= 'has-observation' if observation&.dig(:text).present? %>">
      <div class="kpi-icon bg-warning-soft"><i class="bi bi-chat-left-text text-warning"></i></div>
      <div class="kpi-info">
        <span class="kpi-label">Última observação de hoje</span>
        <% if observation&.dig(:text).present? %>
          <div class="plate-observation-text" tabindex="0" role="region" aria-label="Texto da última observação de hoje"><%= observation[:text] %></div>
          <small><%= observation[:source] %> · <%= l(observation[:date], format: "%H:%M") %>
            · <%= link_to "Ver registro", observation[:path] %>
          </small>
        <% else %>
          <span class="plate-observation-empty">Nenhuma observação registrada hoje.</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="plate-dashboard-grid">
    <div class="plate-dashboard-column">
      <%= render "plates/tires" %>
      <%= render "plates/observations" %>
    </div>
    <div class="plate-dashboard-column">
      <%= render "plates/trips" %>
      <%= render "plates/tasks" %>
    </div>
  </div>
</div>
