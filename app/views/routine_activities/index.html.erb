<%= turbo_frame_tag "routine_activities_frame" do %>

  <%= turbo_stream_from [@routine, :activities] %>

  <% if @activities.any? %>

    <div
      id="routine-activities-list"
      class="d-flex flex-column">

      <% @activities.each do |activity| %>

        <%= render "activity",
                   activity: activity %>

      <% end %>

    </div>

  <% else %>

    <div
      id="routine-activities-list"
      class="text-center py-5 text-muted">

      <i class="bi bi-clock-history fs-1"></i>

      <p class="mt-3 mb-0">
        Nenhuma atividade registrada.
      </p>

    </div>

  <% end %>

<% end %>
