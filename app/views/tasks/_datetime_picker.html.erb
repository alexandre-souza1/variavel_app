<% picker_id = "task-#{f.object.id}-#{field}-picker" %>
<div class="task-datetime" data-controller="task-datetime"
     data-action="click@window->task-datetime#outside keydown.esc->task-datetime#escape">
  <%= f.hidden_field field, value: f.object.public_send(field)&.strftime("%Y-%m-%dT%H:%M"), data: { task_datetime_target: "value" } %>
  <button type="button" class="task-datetime__trigger" data-task-datetime-target="button"
          data-action="task-datetime#toggle" aria-label="<%= label %>"
          aria-expanded="false" aria-controls="<%= picker_id %>">
    <span data-task-datetime-target="display"></span><i class="bi bi-calendar3" aria-hidden="true"></i>
  </button>
  <div id="<%= picker_id %>" class="task-composer__people-popover task-composer__calendar task-datetime__panel"
       popover="manual" role="dialog" aria-label="<%= label %>"
       data-task-datetime-target="panel" hidden
       data-action="input->task-datetime#stop change->task-datetime#stop">
    <div class="task-composer__calendar-header">
      <button type="button" class="btn btn-sm" aria-label="Mês anterior" data-action="task-datetime#changeMonth" data-offset="-1"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
      <strong data-task-datetime-target="month" aria-live="polite"></strong>
      <button type="button" class="btn btn-sm" aria-label="Próximo mês" data-action="task-datetime#changeMonth" data-offset="1"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
    </div>
    <div class="task-composer__calendar-week" aria-hidden="true"><% %w[D S T Q Q S S].each do |day| %><span><%= day %></span><% end %></div>
    <div class="task-composer__calendar-days" data-task-datetime-target="days" data-action="click->task-datetime#choose"></div>
    <div class="task-datetime__time">
      <i class="bi bi-clock" aria-hidden="true"></i>
      <label>Hora <input type="text" inputmode="numeric" maxlength="2" autocomplete="off" data-task-datetime-target="hours" data-action="keydown.enter->task-datetime#apply" aria-label="Hora"></label>
      <span>:</span>
      <label>Minuto <input type="text" inputmode="numeric" maxlength="2" autocomplete="off" data-task-datetime-target="minutes" data-action="keydown.enter->task-datetime#apply" aria-label="Minuto"></label>
    </div>
    <p class="task-composer__error" data-task-datetime-target="error" role="alert" hidden>Escolha uma data e um horário válido (00:00 a 23:59).</p>
    <div class="task-datetime__footer">
      <button type="button" data-action="task-datetime#clear">Limpar</button>
      <button type="button" data-action="task-datetime#today">Hoje</button>
      <button type="button" class="task-datetime__apply" data-action="task-datetime#apply">Aplicar</button>
    </div>
  </div>
</div>
