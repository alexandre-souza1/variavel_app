<% composer_id = "task-composer-#{bucket.id}" %>
<div class="task-composer" data-controller="new-task"
     data-action="new-task:opened@window->new-task#otherOpened click@window->new-task#outside keydown.esc->new-task#escape">
  <button type="button" class="action-plan-kanban-add-task" aria-expanded="false"
          aria-controls="<%= composer_id %>" data-new-task-target="button" data-action="new-task#toggle">
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    <span data-new-task-target="buttonLabel">Adicionar tarefa</span>
  </button>

  <div id="<%= composer_id %>" class="task-composer__wrapper" data-new-task-target="wrapper" inert>
    <div class="task-composer__inner">
      <%= form_with model: [action_plan, bucket, Task.new], namespace: composer_id,
          class: "task-composer__form",
          data: { new_task_target: "form", action: "submit->new-task#validate change->new-task#update turbo:submit-start->new-task#submitting turbo:submit-end->new-task#afterSubmit" } do |f| %>
        <%= hidden_field_tag :view, local_assigns[:view] if local_assigns[:view].present? %>
        <%= f.label :title, "Título da tarefa", class: "visually-hidden" %>
        <%= f.text_field :title, placeholder: "O que precisa ser feito?", class: "form-control task-composer__title", required: true, autocomplete: "off", data: { new_task_target: "title" } %>

        <div class="task-composer__tools">
          <% [["date", "calendar3", "Prazo"], ["users", "person-plus", "Responsáveis"], ["repeat", "arrow-repeat", "Repetição"]].each do |panel, icon, label| %>
            <button type="button" class="task-composer__tool" data-new-task-target="tool"
                    data-panel="<%= panel %>" data-action="new-task#showPanel"
                    aria-expanded="false" aria-controls="<%= composer_id %>-<%= panel %>">
              <i class="bi bi-<%= icon %>" aria-hidden="true"></i>
              <span data-summary="<%= panel %>"><%= label %></span>
            </button>
          <% end %>
          <div class="task-composer__labels-alert">
            <button type="button" class="task-composer__tool" data-new-task-target="tool"
                    data-panel="labels" data-action="new-task#showPanel"
                    title="Selecionar etiquetas" aria-label="Selecionar etiquetas"
                    aria-expanded="false" aria-controls="<%= composer_id %>-labels">
              <i class="bi bi-tags" aria-hidden="true"></i>
              <span data-summary="labels">Etiquetas</span>
            </button>
            <%= f.check_box :due_notification_enabled, class: "d-none", data: { new_task_target: "reminder" }, tabindex: -1, aria: { hidden: true } %>
            <button type="button" class="task-composer__tool task-composer__reminder"
                    title="Avisar sobre o vencimento" aria-label="Alerta de prazo" aria-pressed="false"
                    data-new-task-target="reminderButton" data-action="new-task#toggleReminder">
              <i class="bi bi-bell" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <%= f.hidden_field :due_at, data: { new_task_target: "date" } %>
        <div id="<%= composer_id %>-date" class="task-composer__panel task-composer__people-popover task-composer__calendar"
             popover="manual" role="dialog" aria-label="Escolher prazo"
             data-new-task-target="panel" data-panel="date" hidden>
          <div class="task-composer__calendar-header">
            <button type="button" class="btn btn-sm" aria-label="Mês anterior" data-action="new-task#changeMonth" data-offset="-1"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <strong data-new-task-target="calendarMonth" aria-live="polite"></strong>
            <button type="button" class="btn btn-sm" aria-label="Próximo mês" data-action="new-task#changeMonth" data-offset="1"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
          </div>
          <div class="task-composer__calendar-week" aria-hidden="true"><% %w[D S T Q Q S S].each do |day| %><span><%= day %></span><% end %></div>
          <div class="task-composer__calendar-days" data-new-task-target="calendarDays" data-action="click->new-task#chooseDate"></div>
          <div class="task-composer__people-footer">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="new-task#clearDate">Sem prazo</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="new-task#today">Hoje</button>
          </div>
        </div>
        <div id="<%= composer_id %>-users" class="task-composer__panel task-composer__people-popover"
             popover="manual" role="dialog" aria-label="Atribuir responsáveis"
             data-new-task-target="panel" data-panel="users" hidden>
          <label for="<%= composer_id %>-user-search" class="form-label">Selecione os responsáveis</label>
          <input id="<%= composer_id %>-user-search" type="search" class="form-control form-control-sm"
                 placeholder="Digite um nome ou e-mail" autocomplete="off" data-new-task-target="userSearch"
                 data-action="input->new-task#filterUsers keydown.enter->new-task#preventSearchSubmit">
          <%= hidden_field_tag "task[user_ids][]", "", id: nil %>
          <div class="task-composer__people" role="group" aria-label="Responsáveis">
            <% User.order(:name, :id).each do |user| %>
              <% name = user.name.presence || user.email %>
              <label class="task-composer__person" data-new-task-target="userOption" data-name="<%= name %> <%= user.email %>">
                <input type="checkbox" name="task[user_ids][]" value="<%= user.id %>" data-new-task-target="assignee">
                <span class="task-composer__avatar" aria-hidden="true"><%= name.first.upcase %></span>
                <span class="task-composer__person-name"><%= name %></span>
              </label>
            <% end %>
          </div>
          <p class="task-composer__hint" data-new-task-target="noUsers" role="status" hidden>Nenhum responsável encontrado.</p>
          <div class="task-composer__people-footer">
            <span data-new-task-target="userCount" aria-live="polite">Nenhum selecionado</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="new-task#closeUsers">Pronto</button>
          </div>
        </div>
        <div id="<%= composer_id %>-labels" class="task-composer__panel task-composer__people-popover"
             popover="manual" role="dialog" aria-label="Selecionar etiquetas"
             data-new-task-target="panel" data-panel="labels" hidden>
          <label for="<%= composer_id %>-label-search" class="form-label">Etiquetas do plano</label>
          <input id="<%= composer_id %>-label-search" type="search" class="form-control form-control-sm"
                 placeholder="Buscar etiqueta..." autocomplete="off" data-new-task-target="labelSearch"
                 data-action="input->new-task#filterLabels keydown.enter->new-task#preventSearchSubmit">
          <%= hidden_field_tag "task[label_ids][]", "", id: nil %>
          <div class="task-composer__people" role="group" aria-label="Etiquetas">
            <% action_plan.labels.sort_by { |label| label.name.downcase }.each do |label| %>
              <label class="task-composer__person" data-new-task-target="labelOption" data-name="<%= label.name %>">
                <input type="checkbox" name="task[label_ids][]" value="<%= label.id %>" data-new-task-target="badge">
                <span class="task-composer__label action-plan-color-badge" style="--task-label-color: <%= label.color %>"><%= label.name %></span>
              </label>
            <% end %>
          </div>
          <p class="task-composer__hint" data-new-task-target="noLabels" role="status" hidden>
            <%= action_plan.labels.empty? ? "Este plano ainda não tem etiquetas. Adicione-as nos detalhes de uma tarefa." : "Nenhuma etiqueta encontrada." %>
          </p>
          <div class="task-composer__people-footer">
            <span data-new-task-target="labelCount" aria-live="polite">Nenhuma selecionada</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="new-task#closeLabels">Pronto</button>
          </div>
        </div>
        <div id="<%= composer_id %>-repeat" class="task-composer__panel" data-new-task-target="panel" data-panel="repeat" hidden>
          <%= f.label :recurrence, "Repetir ao concluir", class: "form-label" %>
          <%= f.select :recurrence, [["Não repetir", ""], ["Diariamente", "daily"], ["Semanalmente", "weekly"], ["Mensalmente", "monthly"], ["Bimestralmente", "bimonthly"]], {}, class: "form-select form-select-sm", data: { new_task_target: "recurrence" } %>
        </div>
        <p class="task-composer__hint" data-new-task-target="hint" hidden>Defina um prazo para usar repetição ou alerta.</p>
        <p class="task-composer__error" data-new-task-target="error" role="alert" hidden>Não foi possível salvar. Seu rascunho foi mantido. Tente novamente.</p>
        <div class="task-composer__footer">
          <button type="button" class="btn btn-sm task-composer__cancel" data-action="new-task#cancel">Cancelar</button>
          <%= f.button class: "btn btn-primary btn-sm", data: { new_task_target: "submit", turbo_submits_with: "Salvando…" } do %>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Criar tarefa
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
