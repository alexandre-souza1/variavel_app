<% if @bucket_changed %>
  <%= render "tasks/move", task: @task %>
  <%= turbo_stream.update "task-modal-content" do %>
    <%= render "tasks/modal_content", task: @task %>
  <% end %>
<% else %>
  <%= turbo_stream.replace dom_id(@task) do %>
    <%= render "tasks/task", task: @task %>
  <% end %>
<% end %>
