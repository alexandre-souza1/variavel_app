<div id="<%= dom_id(task) %>"
    class="task-card action-plan-task-card"
    data-id="<%= task.id %>"
    data-controller="task-modal"
    data-action="click->task-modal#open"
    <% if local_assigns[:search_text].present? %>
      data-action-plan-filter-target="item"
      data-search-text="<%= local_assigns[:search_text] %>"
    <% end %>
    data-plan-id="<%= task.bucket.action_plan.id %>"
    data-bucket-id="<%= task.bucket.id %>"
    data-task-id="<%= task.id %>">

  <% if task.labels.any? %>
    <div class="task-labels action-plan-task-card__labels">
      <% task.labels.each do |label| %>
        <span class="badge" style="background-color: <%= label.color %>">
          <%= label.name %>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="action-plan-task-card__header">

    <%= button_to toggle_complete_action_plan_bucket_task_path(task.bucket.action_plan, task.bucket, task),
      method: :patch,
      data: { turbo_stream: true },
      class: "action-plan-task-card__check",
      onclick: "event.stopPropagation();" do %>

      <% if task.completed %>
        <i class="bi bi-check-circle-fill text-success"></i>
      <% else %>
        <i class="bi bi-circle"></i>
      <% end %>

    <% end %>

    <div class="task-title action-plan-task-card__title <%= 'text-decoration-line-through opacity-50' if task.completed %>">
      <%= task.title %>
    </div>

  </div>

  <% if task.description.present? %>
    <div class="task-desc action-plan-task-card__description">
      <%= truncate(task.description, length: 80) %>
    </div>
  <% end %>

  <div class="task-footer action-plan-task-card__footer">

    <div class="task-meta action-plan-task-card__meta">
      <% overdue = task.due_at.present? && task.due_at < Time.current && !task.completed %>
      <% if task.due_at.present? %>
        <small class="task-date action-plan-task-card__date <%= 'overdue' if overdue %>">
          <i class="bi bi-calendar-date"></i> <%= task.due_at.strftime("%d/%m") %>
        </small>
      <% end %>
    </div>

    <div class="task-icons action-plan-task-card__icons">

      <% if task.tasklist.tasklist_items.exists? %>
        <small class="task-icon"><i class="bi bi-list-check"></i></small>
      <% end %>

      <% if task.comments.exists? %>
        <small class="task-icon"><i class="bi bi-chat-dots-fill"></i></small>
      <% end %>

      <% if task.recurrence.present? %>
        <small class="task-icon">
          <i class="bi bi-arrow-repeat"></i>
        </small>
      <% end %>
      <% users = task.users.to_a %>
      <div class="avatar-group action-plan-task-card__avatars">
        <% users.first(3).each do |user| %>
          <div class="avatar-circle-sm">
            <%= user.name.first.upcase %>
          </div>
        <% end %>

         <% if users.size > 3 %>
          <div class="avatar-circle-sm extra">
            +<<%= users.size - 3 %>
          </div>
        <% end %>
      </div>

    </div>
  </div>

</div>
