<div class="container py-4" data-controller="open-task" data-open-task-task-id-value="<%= @task_to_open&.id %>">
  <%= turbo_stream_from "tasks_inbox_#{current_user.id}" %>
  <%= link_to "Planos de ação", action_plans_path, class: "btn btn-outline-secondary mb-3" %>
  <%= render "action_plans/inbox_view", action_plan: nil, inbox_bucket: @inbox_bucket, inbox_tasks: @inbox_tasks %>
</div>
