<div class="app-page">
  <div class="app-page-header">
    <div>
      <p class="app-page-eyebrow"><i class="bi bi-list-check me-1"></i>Resultados · WMS</p>
      <h1><i class="bi bi-list-task me-2"></i>Resultados WMS</h1>
      <p>Consulte as tarefas WMS importadas e seus períodos de processamento.</p>
    </div>
    <div class="app-page-actions">
      <%= link_to az_consultas_import_path, class: "btn btn-primary" do %><i class="bi bi-upload me-1"></i> Nova importação<% end %>
      <%= link_to "Voltar", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div>
    <div class="card shadow-sm rounded mb-4">
      <div class="card-body">
        <div class="row align-items-center">
          <div class="col-md-6">
            <h2 class="mb-1">
              <i class="bi bi-calendar-date"></i>
              <%= @data_inicio_WMS.present? ? I18n.l(@data_inicio_WMS, format: "%B") : "-" %> a
              <%= @data_fim_WMS.present? ? I18n.l(@data_fim_WMS, format: "%B") : "-" %>
            </h2>
            <p class="text-muted mb-0">
              Total de Tarefas: <%= @total_tasks %>
            </p>
          </div>
          <div class="d-flex col-md-6 text-md-end justify-content-end gap-2">
            <%= button_to "Deletar Todas as Tarefas", delete_all_wms_tasks_path, method: :delete, class: "btn btn-danger", data: { confirm: "Tem certeza que deseja deletar todas as tarefas?" } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabela de Tarefas WMS -->
    <div class="app-table-section">
      <div class="app-table-section__header">
        <h5 class="mb-0"><i class="bi bi-list-task me-2"></i>Detalhes das Tarefas</h5>
      </div>
      <div class="app-table-section__body">
        <div class="table-responsive">
          <div class="app-table-shell"><table class="table app-table app-table--report">
            <thead class="table-light">
              <tr>
                <th>Tarefa</th>
                <th>Tipo</th>
                <th>Placa</th>
                <th>Palete</th>
                <th>Operador</th>
                <th>Início</th>
                <th>Final</th>
                <th>Duração (s)</th>
              </tr>
            </thead>
            <tbody>
              <% @tasks.each do |task| %>
                <tr>
                  <td><%= task.task_code %></td>
                  <td><%= task.task_type %></td>
                  <td><%= task.plate %></td>
                  <td><%= task.pallet %></td>
                  <td><%= task.operator.nome %></td>
                  <td><%= task.started_at.strftime("%d/%m/%Y %H:%M:%S") if task.started_at %></td>
                  <td><%= task.ended_at.strftime("%d/%m/%Y %H:%M:%S") if task.ended_at %></td>
                  <td class="text-end"><%= task.duration %>s</td>
                </tr>
              <% end %>
            </tbody>
          </table></div>
        </div>

        <!-- Paginação -->
        <div class="d-flex justify-content-center mt-2">
          <%= render 'shared/pagination', current_page: @current_page, total_pages: @total_pages, path: ->(p){ url_for(page: p, per_page: params[:per_page]) } %>
        </div>

        <%= form_with url: request.path, method: :get, id: "per-page-form", class: "d-none" do |f| %>
          <%= hidden_field_tag :page, params[:page] %>
          <%= hidden_field_tag :per_page, params[:per_page] %>
        <% end %>
        <%= link_to "Voltar", root_path, class: "btn btn-primary shadow-sm p-3 w-100 mt-2" %>
      </div>
    </div>
  </div>
</div>
