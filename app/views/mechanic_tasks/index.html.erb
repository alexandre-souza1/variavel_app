<div class="mechanic-tasks-page" data-controller="mechanic-filters">
  <header class="mechanic-tasks-header">
    <div class="mechanic-tasks-header__intro">
      <div class="mechanic-tasks-header__icon" aria-hidden="true"><i class="bi bi-wrench-adjustable"></i></div>
      <div class="mechanic-tasks-header__content">
        <p class="mechanic-tasks-eyebrow">Área do mecânico</p>
        <h1>Minhas tarefas</h1>
        <p>Suas ordens de serviço, organizadas para o dia a dia.</p>
      </div>
    </div>
    <div class="mechanic-tasks-header__scope"><i class="bi bi-person-check" aria-hidden="true"></i> Atribuídas a você</div>
  </header>

  <div class="mechanic-tasks-summary" aria-label="Resumo das tarefas nos filtros selecionados">
    <div class="mechanic-task-stat is-primary">
      <i class="bi bi-tools" aria-hidden="true"></i>
      <div><strong><%= @open_count %></strong><span>OS abertas</span></div>
    </div>
    <div class="mechanic-task-stat is-overdue">
      <i class="bi bi-clock-history" aria-hidden="true"></i>
      <div><strong><%= @overdue_count %></strong><span>Em atraso</span></div>
    </div>
    <div class="mechanic-task-stat is-success">
      <i class="bi bi-check2-circle" aria-hidden="true"></i>
      <div><strong><%= @completed_count %></strong><span>Concluídas</span></div>
    </div>
    <div class="mechanic-task-stat">
      <i class="bi bi-collection" aria-hidden="true"></i>
      <div><strong><%= @total_count %></strong><span>Total de OS</span></div>
    </div>
  </div>

  <details class="mechanic-tasks-filter-panel" open data-mechanic-filters-target="panel">
    <summary class="mechanic-tasks-filter-panel__heading">
      <h2 id="mechanic-filter-heading"><i class="bi bi-sliders2" aria-hidden="true"></i> Filtrar ordens de serviço</h2>
      <div class="mechanic-tasks-filter-panel__actions">
        <% if @filters_active %><span><%= @label_ids.size + (@query.present? ? 1 : 0) + (params[:action_plan_id].present? ? 1 : 0) %> ativos</span><% end %>
      <% if @filters_active %>
        <%= link_to "Limpar filtros", mechanic_tasks_path(status: @status, view: @view), class: "mechanic-tasks-clear" %>
      <% end %>
        <i class="bi bi-chevron-down mechanic-tasks-filter-panel__arrow" aria-hidden="true"></i>
      </div>
    </summary>
    <%= form_with url: mechanic_tasks_path, method: :get, local: true, class: "mechanic-tasks-filter-form" do %>
      <%= hidden_field_tag :status, @status %>
      <%= hidden_field_tag :view, @view %>
      <div class="mechanic-tasks-field mechanic-tasks-field--search">
        <label for="mechanic-title-search">Título da OS</label>
        <div class="mechanic-tasks-search">
          <i class="bi bi-search" aria-hidden="true"></i>
          <%= search_field_tag :q, @query, id: "mechanic-title-search", class: "form-control", placeholder: "Buscar pelo título..." %>
        </div>
      </div>
      <div class="mechanic-tasks-field">
        <label for="mechanic-action-plan">Plano de ação</label>
        <%= select_tag :action_plan_id, options_from_collection_for_select(@action_plans, :id, :name, params[:action_plan_id]), include_blank: "Todos os planos", class: "form-select", id: "mechanic-action-plan" %>
      </div>
      <div class="mechanic-tasks-field mechanic-tasks-field--badges">
        <label id="mechanic-badges-label">Badges</label>
        <details class="mechanic-badge-picker" data-mechanic-filters-target="picker" data-action="keydown.esc->mechanic-filters#close click@window->mechanic-filters#closeOutside">
          <summary aria-labelledby="mechanic-badges-label mechanic-badges-count"><span id="mechanic-badges-count" data-mechanic-filters-target="count"><%= @label_ids.any? ? "#{@label_ids.size} selecionados" : "Todos os badges" %></span><i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
          <div class="mechanic-badge-picker__menu">
            <div class="mechanic-badge-picker__search">
              <input type="search" class="form-control" placeholder="Buscar badge..." aria-label="Buscar badge" data-mechanic-filters-target="search" data-action="input->mechanic-filters#search keydown.enter->mechanic-filters#preventSubmit">
            </div>
            <p class="mechanic-badge-picker__hint">Selecione um ou mais. A OS pode ter qualquer um deles.</p>
            <div class="mechanic-badge-picker__options">
              <% @labels.each do |label| %>
                <label class="mechanic-badge-picker__option" data-mechanic-filters-target="option" data-search-text="<%= "#{label.name} #{label.action_plan.name}" %>">
                  <%= check_box_tag "label_ids[]", label.id, @label_ids.include?(label.id.to_s), id: "mechanic-label-#{label.id}", class: "form-check-input", data: { mechanic_filters_target: "checkbox", action: "change->mechanic-filters#updateCount" } %>
                  <span class="mechanic-badge-picker__dot" style="--label-color: <%= mechanic_label_color(label) %>" aria-hidden="true"></span>
                  <span><strong><%= label.name %></strong><small><%= label.action_plan.name %></small></span>
                </label>
              <% end %>
              <% if @labels.empty? %><p class="mechanic-badge-picker__hint">Suas OS ainda não têm badges.</p><% end %>
              <p class="mechanic-badge-picker__hint" data-mechanic-filters-target="empty" hidden>Nenhum badge encontrado.</p>
            </div>
            <button type="button" class="mechanic-badge-picker__done" data-action="mechanic-filters#close">Confirmar seleção <i class="bi bi-check-lg" aria-hidden="true"></i></button>
          </div>
        </details>
      </div>
      <button type="submit" class="btn btn-primary mechanic-tasks-apply"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrar</button>
    <% end %>
    <% if @filters_active %>
      <div class="mechanic-tasks-active-filters" aria-label="Filtros aplicados">
        <span>Filtrando por:</span>
        <% if @query.present? %>
          <%= link_to mechanic_tasks_path(@filter_params.except(:q)), class: "mechanic-filter-chip", aria: { label: "Remover busca por #{@query}" } do %>
            <i class="bi bi-search" aria-hidden="true"></i> <%= @query %> <i class="bi bi-x" aria-hidden="true"></i>
          <% end %>
        <% end %>
        <% if params[:action_plan_id].present? %>
          <%= link_to mechanic_tasks_path(@filter_params.except(:action_plan_id)), class: "mechanic-filter-chip", aria: { label: "Remover filtro de plano de ação" } do %>
            <i class="bi bi-kanban" aria-hidden="true"></i> <%= @action_plans.find { |plan| plan.id.to_s == params[:action_plan_id] }&.name || "Plano selecionado" %> <i class="bi bi-x" aria-hidden="true"></i>
          <% end %>
        <% end %>
        <% @label_ids.each do |label_id| %>
          <% label = @labels.find { |item| item.id.to_s == label_id } %>
          <%= link_to mechanic_tasks_path(@filter_params.merge(label_ids: @label_ids - [label_id])), class: "mechanic-filter-chip", title: label&.action_plan&.name, aria: { label: "Remover badge #{label&.name || label_id}" } do %>
            <i class="bi bi-tag" aria-hidden="true"></i> <%= label&.name || "Badge selecionado" %> <i class="bi bi-x" aria-hidden="true"></i>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </details>

  <section class="mechanic-tasks-workspace" aria-labelledby="mechanic-workspace-heading">
    <div class="mechanic-tasks-toolbar">
      <div class="mechanic-tasks-toolbar__heading">
        <h2 id="mechanic-workspace-heading">Suas ordens de serviço <span><%= @tasks.size %></span></h2>
        <p><%= @filters_active ? "Resultados dos filtros selecionados" : "Acompanhe os prazos e registre o andamento" %></p>
      </div>
      <div class="mechanic-tasks-toolbar__controls">
        <nav class="mechanic-tasks-filters" aria-label="Status das ordens de serviço">
          <% [["open", "Abertas", @open_count], ["completed", "Concluídas", @completed_count], ["all", "Todas", @total_count]].each do |status, label, count| %>
            <%= link_to mechanic_tasks_path(@filter_params.merge(status: status)), class: ("is-active" if @status == status), aria: { current: (@status == status ? "page" : nil) } do %>
              <%= label %> <span><%= count %></span>
            <% end %>
          <% end %>
        </nav>
        <nav class="mechanic-tasks-view-switch" aria-label="Visualização das ordens de serviço">
          <% [["kanban", "Kanban", "bi-kanban"], ["list", "Lista", "bi-list-ul"]].each do |view, label, icon| %>
            <%= link_to mechanic_tasks_path(@filter_params.merge(view: view)), class: ("is-active" if @view == view), aria: { current: (@view == view ? "page" : nil) } do %>
              <i class="bi <%= icon %>" aria-hidden="true"></i> <%= label %>
            <% end %>
          <% end %>
        </nav>
      </div>
    </div>

    <% if @tasks.any? %>
      <% if @view == "kanban" %>
        <p class="mechanic-tasks-board-hint"><i class="bi bi-layout-three-columns" aria-hidden="true"></i> OS agrupadas pelas etapas de cada plano de ação. <span>Role para os lados para ver mais etapas.</span></p>
        <div class="mechanic-tasks-board" tabindex="0" role="region" aria-label="Ordens de serviço atribuídas a você">
          <% @tasks_by_bucket.each do |bucket, tasks| %>
            <div class="mechanic-tasks-column">
              <header class="mechanic-tasks-column__header">
                <p><%= bucket.action_plan.name %></p>
                <div><h3 id="mechanic-column-<%= bucket.id %>"><%= bucket.name %></h3><span><%= tasks.size %></span></div>
              </header>
              <div class="mechanic-tasks-column__cards"><%= render partial: "task", collection: tasks, as: :task %></div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="mechanic-tasks-list"><%= render partial: "task", collection: @tasks, as: :task %></div>
      <% end %>
    <% else %>
      <div class="mechanic-tasks-empty">
        <div><i class="bi <%= @filters_active ? 'bi-search' : 'bi-check2-circle' %>" aria-hidden="true"></i></div>
        <h3><%= @filters_active ? "Nenhuma OS encontrada" : "Nenhuma OS por aqui" %></h3>
        <p><%= @filters_active ? "Experimente outro título, plano de ação ou badge." : "As OS atribuídas a você aparecerão aqui. Você também pode consultar outro status." %></p>
        <% if @filters_active %><%= link_to "Limpar filtros", mechanic_tasks_path(status: @status, view: @view), class: "btn btn-outline-primary" %><% end %>
      </div>
    <% end %>
  </section>
</div>
