<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1>Configuração da disponibilidade</h1>
      <p class="text-muted mb-0">
        Defina os horários automáticos de abertura e fechamento das disponibilidades.
      </p>
    </div>

    <%= link_to "Voltar",
                fleet_availabilities_path,
                class: "btn btn-outline-secondary" %>
  </div>

  <%= form_with model: @fleet_availability_setting,
                url: fleet_availability_setting_path,
                method: :patch do |f| %>

    <% if @fleet_availability_setting.errors.any? %>
      <div class="alert alert-danger">
        <%= @fleet_availability_setting.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="card mb-3" style="max-width: 540px">
      <div class="card-body">

        <div class="mb-4">
          <%= f.label :auto_open_time,
                      "Criar a disponibilidade do próximo dia às",
                      class: "form-label fw-semibold" %>

          <%= f.time_field :auto_open_time,
                           value: @fleet_availability_setting.normalized_time(
                             @fleet_availability_setting.auto_open_time
                           ),
                           class: "form-control" %>

          <div class="form-text">
            Todos os dias nesse horário, o sistema criará automaticamente
            a disponibilidade do dia seguinte, copiando a disponibilidade anterior.
          </div>
        </div>

        <div>
          <%= f.label :auto_lock_time,
                      "Fechar a disponibilidade às",
                      class: "form-label fw-semibold" %>

          <%= f.time_field :auto_lock_time,
                           value: @fleet_availability_setting.normalized_time(
                             @fleet_availability_setting.auto_lock_time
                           ),
                           class: "form-control" %>

          <div class="form-text">
            Nesse horário, disponibilidades que já atingiram seu horário
            de fechamento serão travadas para envio.
            O horário utiliza o fuso de Brasília.
          </div>
        </div>

      </div>
    </div>

    <%= f.submit "Salvar configuração", class: "btn btn-primary" %>
  <% end %>
</div>
