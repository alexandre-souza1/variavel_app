<nav class="tire-pagination" data-turbo-frame="_top" aria-label="Paginação de pneus">
  <div class="tire-pagination-summary">
    <strong><%= @total_rows.zero? ? 0 : (@page - 1) * @per_page + 1 %>–<%= [@page * @per_page, @total_rows].min %> <span>de <%= @total_rows %> registros</span></strong>
    <%= form_with url: tire_panel_path, method: :get, local: true, data: { turbo_frame: "_top" }, class: "tire-page-size" do %>
      <% request.query_parameters.slice("start_date", "end_date", "q", "status", "sort").each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
      <%= label_tag :tire_page_size, "Por página" %>
      <%= select_tag :per_page, options_for_select(TireInspectionsController::PAGE_SIZES, @per_page), id: "tire_page_size", class: "form-select form-select-sm", data: { app_select: "native" } %>
      <%= submit_tag "Aplicar", class: "btn-outline tire-page-button" %>
    <% end %>
  </div>
  <div class="tire-page-links">
    <% query = request.query_parameters.except("page", "format", "load", "view").merge("per_page" => @per_page) %>
    <% if @page > 1 %>
      <%= link_to "‹", tire_panel_path(query.merge(page: @page - 1)), class: "btn-outline tire-page-button", rel: "prev", aria: { label: "Página anterior" } %>
    <% else %><span class="btn-outline tire-page-button is-disabled" aria-disabled="true" aria-label="Página anterior">‹</span><% end %>
    <% pages = ([1, @total_pages] + ((@page - 2)..(@page + 2)).to_a).select { |number| number.between?(1, @total_pages) }.uniq.sort %>
    <% pages.each_with_index do |number, index| %>
      <% if index.positive? && number > pages[index - 1] + 1 %><span class="tire-page-gap">…</span><% end %>
      <%= link_to number, tire_panel_path(query.merge(page: number)), class: "btn-outline tire-page-button #{'active is-active' if number == @page}", aria: { label: "Página #{number}", current: number == @page ? "page" : nil } %>
    <% end %>
    <% if @page < @total_pages %>
      <%= link_to "›", tire_panel_path(query.merge(page: @page + 1)), class: "btn-outline tire-page-button", rel: "next", aria: { label: "Próxima página" } %>
    <% else %><span class="btn-outline tire-page-button is-disabled" aria-disabled="true" aria-label="Próxima página">›</span><% end %>
  </div>
</nav>
