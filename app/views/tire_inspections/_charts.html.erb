<details class="app-panel tire-analytics">
  <summary><span><i class="bi bi-bar-chart" aria-hidden="true"></i> Análise do período</span><span class="tire-analytics__totals"><%= @affected_inspections %> aferições com ocorrências · <%= @affected_tires %> pneus</span><%= disclosure_arrow %></summary>
  <div class="tire-chart-grid">
    <article class="app-panel tire-chart">
      <div class="tire-chart-heading"><i class="bi bi-graph-up"></i><div><h3>Evolução das aferições com ocorrências</h3><p>Aferições distintas por mês, respeitando todos os filtros.</p></div></div>
      <%= column_chart @chart_evolution, id: "tire-evolution-chart", height: "190px", min: 0, precision: 0, thousands: ".", ytitle: "Aferições", empty: "Sem aferições com ocorrências", library: { scales: { y: { ticks: { precision: 0 } } } } %>
    </article>
    <article class="app-panel tire-chart">
      <div class="tire-chart-heading"><i class="bi bi-pie-chart"></i><div><h3>Distribuição das ocorrências</h3><p><%= @pressure_view ? "Uma ocorrência por pneu com pressão baixa em cada aferição." : "Uma ocorrência por aumento de sulco; não é percentual da frota." %></p></div></div>
      <%= pie_chart @chart_distribution, id: "tire-distribution-chart", donut: true, height: "190px", legend: "bottom", empty: "Nenhuma ocorrência na seleção" %>
    </article>
  </div>
</details>
