<div class="downloads-page" data-controller="filter">

  <!-- ========== CABEÇALHO ========== -->
  <header class="downloads-header">
    <div class="header-content">

      <div class="header-copy">
        <div class="title-row">
          <div class="title-icon">
            <i class="bi bi-file-earmark-arrow-down"></i>
          </div>

          <div>
            <h1>Central de Padrões</h1>

            <p class="subtitle">
              Acesse e gerencie os documentos padrão da empresa
            </p>
          </div>
        </div>
      </div>


      <% if current_user&.admin? || current_user&.supervisor? %>

        <div class="header-actions">
          <%= link_to new_download_path, class: "btn-primary-solid" do %>
            <i class="bi bi-plus-circle-fill"></i>
            <span>Novo Documento</span>
          <% end %>
        </div>

      <% end %>

    </div>
  </header>


  <!-- ========== FILTROS ========== -->
  <section class="filters-card">

    <div class="filters-header">
      <div class="filters-title">
        <i class="bi bi-funnel"></i>
        <span>Filtrar por tipo</span>
      </div>
    </div>

    <div class="filters-body">

      <div
        class="filter-buttons"
        role="group"
        aria-label="Filtrar documentos">

        <button
          type="button"
          class="btn-filter active"
          data-filter="all"
          data-action="click->filter#filter"
          data-filter-target="filterButton">
          Todos
        </button>

        <% Download::CATEGORIES.each do |category| %>

          <button
            type="button"
            class="btn-filter"
            data-filter="<%= category %>"
            data-action="click->filter#filter"
            data-filter-target="filterButton">

            <%= category_title(category) %>

          </button>

        <% end %>

      </div>

    </div>
  </section>


  <!-- ========== LISTA DE DOCUMENTOS ========== -->
  <main class="downloads-list-wrapper">

    <% Download::CATEGORIES.each do |category| %>

      <% downloads = Download.where(category: category) %>

      <% next if downloads.empty? %>

      <section
        class="download-category"
        data-category="<%= category %>"
        data-filter-target="category">

        <!-- Cabeçalho da categoria -->

        <div class="category-header">

          <div class="category-title-wrapper">

            <div class="category-icon">
              <i class="<%= category_icon(category) %>"></i>
            </div>

            <div class="category-heading">

              <h2>
                <%= category_title(category) %>
              </h2>

              <span class="category-count">

                <%= downloads.count %>

                <%= downloads.count == 1 ? "documento" : "documentos" %>

              </span>

            </div>

          </div>

        </div>


        <!-- Documentos -->

        <div class="download-list">

          <% downloads.each do |download| %>

            <article class="download-item">

              <div class="download-main">

                <div class="download-file-icon">
                  <i class="bi bi-file-earmark-pdf"></i>
                </div>


                <div class="download-info">

                  <%= link_to download_url(download),
                              target: "_blank",
                              rel: "noopener noreferrer",
                              class: "download-link" do %>

                    <strong>
                      <%= download.title %>
                    </strong>

                  <% end %>


                  <div class="download-meta">

                    <span>
                      <i class="bi bi-filetype-pdf"></i>
                      <%= download.file_type %>
                    </span>


                    <% if download.file.attached? %>

                      <span>
                        <i class="bi bi-cloud-check"></i>
                        AWS
                      </span>

                    <% end %>


                    <span>
                      <i class="bi bi-building"></i>
                      <%= download.sector %>
                    </span>


                    <span>
                      <i class="bi bi-clock"></i>

                      <%= (
                        download.updated_at || download.created_at
                      ).strftime("%d/%m/%Y %H:%M") %>

                    </span>

                  </div>

                </div>

              </div>


              <!-- ========================== -->
              <!-- AÇÕES -->
              <!-- ========================== -->

              <div class="download-actions">


                <!-- QR CODE -->

                <button
                  type="button"
                  class="icon-btn"
                  title="QR Code"
                  aria-label="Gerar QR Code de <%= download.title %>"
                  data-bs-toggle="modal"
                  data-bs-target="#qrModal<%= download.id %>">

                  <i class="bi bi-qr-code"></i>

                </button>


                <% if current_user&.admin? || current_user&.supervisor? %>

                  <!-- EDITAR -->

                  <%= link_to edit_download_path(download),
                              class: "icon-btn",
                              title: "Editar",
                              aria: {
                                label: "Editar #{download.title}"
                              } do %>

                    <i class="bi bi-pencil"></i>

                  <% end %>


                  <!-- EXCLUIR -->

                  <%= button_to download_path(download),
                                method: :delete,
                                class: "icon-btn danger",
                                data: {
                                  turbo_confirm: "Tem certeza que deseja excluir este link?"
                                },
                                title: "Excluir",
                                aria: {
                                  label: "Excluir #{download.title}"
                                } do %>

                    <i class="bi bi-trash3"></i>

                  <% end %>


                <% else %>

                  <!-- ABRIR -->

                  <%= link_to download_url(download),
                              target: "_blank",
                              rel: "noopener noreferrer",
                              class: "download-open-btn",
                              title: "Abrir documento",
                              aria: {
                                label: "Abrir #{download.title}"
                              } do %>

                    <i class="bi bi-box-arrow-up-right"></i>

                    <span>Abrir</span>

                  <% end %>

                <% end %>

              </div>

            </article>


            <!-- ================================================= -->
            <!-- MODAL QR CODE -->
            <!-- ================================================= -->

            <div
              class="modal fade app-modal"
              id="qrModal<%= download.id %>"
              tabindex="-1"
              aria-labelledby="qrModalLabel<%= download.id %>"
              aria-hidden="true">

              <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content qr-modal">

                  <div class="modal-header">

                    <div>
                      <h5
                        class="modal-title"
                        id="qrModalLabel<%= download.id %>">

                        QR Code

                      </h5>

                      <small class="text-muted">
                        <%= download.title %>
                      </small>
                    </div>


                    <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="modal"
                      aria-label="Fechar">
                    </button>

                  </div>


                  <div class="modal-body text-center">

                    <div class="qr-code-container">

                      <%= image_tag(
                            qr_code_download_path(download),
                            class: "qr-code-image",
                            alt: "QR Code para #{download.title}"
                          ) %>

                    </div>


                    <p class="text-muted small mt-3 mb-0">
                      Escaneie este QR Code para abrir o documento.
                    </p>

                  </div>


                  <div class="modal-footer">

                    <%= link_to qr_code_download_path(
                                  download,
                                  download: true
                                ),
                                class: "btn btn-primary",
                                download: true do %>

                      <i class="bi bi-download me-1"></i>
                      Baixar QR Code

                    <% end %>


                    <button
                      type="button"
                      class="btn btn-outline-secondary"
                      data-bs-dismiss="modal">

                      Fechar

                    </button>

                  </div>

                </div>

              </div>

            </div>

          <% end %>

        </div>

      </section>

    <% end %>

  </main>


  <!-- ========== VOLTAR ========== -->

  <div class="downloads-footer">

    <%= link_to root_path, class: "btn-outline back-btn" do %>

      <i class="bi bi-arrow-left"></i>
      <span>Voltar</span>

    <% end %>

  </div>

</div>
