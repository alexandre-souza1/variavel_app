<div class="action-plan-inbox-page">
  <section class="action-plan-inbox-intro">
    <div>
      <span class="action-plan-inbox-eyebrow"><i class="bi bi-inbox me-1"></i> Entrada</span>
      <h2>Sua Entrada pessoal</h2>
      <p>Suas tarefas sem plano, disponíveis em todos os planos de ação.</p>
    </div>
    <span id="inbox-count-<%= current_user.id %>" class="action-plan-inbox-count"><%= inbox_tasks.size %> <%= inbox_tasks.size == 1 ? "tarefa" : "tarefas" %></span>
  </section>

  <% unless current_user.mechanical? %>
    <section class="action-plan-inbox-capture">
      <%= render "tasks/composer", action_plan: action_plan, bucket: inbox_bucket, view: local_assigns.fetch(:view, "inbox") %>
    </section>
  <% end %>

  <section id="open-tasks-<%= inbox_bucket.id %>"
           class="action-plan-inbox-list <%= 'action-plan-inbox-list--empty' if inbox_tasks.empty? %>"
           data-bucket-id="<%= inbox_bucket.id %>"
           data-controller="sortable"
           data-sortable-source="inbox">
      <div id="inbox-empty-<%= current_user.id %>" class="action-plan-inbox-empty">
        <i class="bi bi-inbox"></i>
        <strong>Nada na Entrada</strong>
        <span>Capture uma tarefa acima e organize-a quando estiver pronto.</span>
      </div>
      <% inbox_tasks.each do |task| %>
        <%= render "tasks/task", task: task %>
      <% end %>
  </section>
</div>
