<div class="dashboard-tasks">

  <!-- ========== CABEÇALHO ========== -->
  <header class="dashboard-header">
    <div class="header-content">
      <div>
        <h1>
          <i class="bi bi-house-door-fill"></i>
          Meu Painel
        </h1>
        <p class="subtitle">Acompanhamento das suas tarefas e planos</p>
      </div>
      <div class="header-actions">
        <button class="btn-outline d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#plansOffcanvas">
          <i class="bi bi-folder2-open me-1"></i> Meus Planos
        </button>
        <%= link_to new_action_plan_path, class: "btn-primary-solid" do %>
          <i class="bi bi-plus-circle-fill me-1"></i> Novo Plano
        <% end %>
      </div>
    </div>
  </header>

  <!-- ========== ROW PRINCIPAL (Bootstrap Grid) ========== -->
  <div class="row g-4 align-items-stretch">

    <!-- COLUNA LATERAL – PLANOS (desktop) -->
    <div class="col-lg-3 d-none d-lg-flex">
      <div class="plans-card w-100">
        <div class="plans-card-header">
          <h5><i class="bi bi-kanban-fill me-2"></i> Meus Planos</h5>
          <span class="badge bg-primary-soft text-primary"><%= @action_plans.count %></span>
        </div>
        <div class="plans-card-body">
          <div class="plans-scroll">
            <%= render "plans_list", action_plans: @action_plans %>
          </div>
        </div>
        <div class="plans-card-footer">
          <%= link_to new_action_plan_path, class: "btn-primary-solid btn-sm w-100" do %>
            <i class="bi bi-plus-circle me-1"></i> Novo Plano
          <% end %>
        </div>
      </div>
    </div>

    <!-- CONTEÚDO PRINCIPAL -->
    <div class="col-lg-9 d-flex flex-column gap-4">

      <!-- CARDS DE RESUMO (KPI) -->
      <div class="row g-3">
        <div class="col-md-3 col-6">
          <div class="kpi-card">
            <div class="kpi-icon bg-primary-soft">
              <i class="bi bi-list-task text-primary"></i>
            </div>
            <div class="kpi-info">
              <span class="kpi-label">Tarefas abertas</span>
              <span class="kpi-value"><%= @my_tasks.count %></span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-6">
          <div class="kpi-card clickable" data-bs-toggle="modal" data-bs-target="#overdueTasksModal">
            <div class="kpi-icon bg-danger-soft">
              <i class="bi bi-alarm-fill text-danger"></i>
            </div>
            <div class="kpi-info">
              <span class="kpi-label">Atrasadas</span>
              <span class="kpi-value text-danger"><%= @overdue_tasks.count %></span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-6">
          <div class="kpi-card">
            <div class="kpi-icon bg-success-soft">
              <i class="bi bi-kanban-fill text-success"></i>
            </div>
            <div class="kpi-info">
              <span class="kpi-label">Planos</span>
              <span class="kpi-value"><%= @action_plans.count %></span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-6">
          <div class="kpi-card clickable" data-bs-toggle="modal" data-bs-target="#todayTasksModal">
            <div class="kpi-icon bg-warning-soft">
              <i class="bi bi-calendar-check-fill text-warning"></i>
            </div>
            <div class="kpi-info">
              <span class="kpi-label">Hoje</span>
              <span class="kpi-value"><%= @today_tasks.count %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- CALENDÁRIO + PRÓXIMAS AÇÕES -->
      <div class="row g-3">
        <!-- CALENDÁRIO -->
        <div class="col-lg-7 d-flex">
          <div class="chart-card w-100">
            <div class="chart-header">
              <h5><i class="bi bi-calendar3 me-2"></i> Calendário de Prazos</h5>
            </div>
            <div class="chart-body calendar-body">
              <% if @calendar_tasks.any? %>
                <%= month_calendar(events: @calendar_tasks, attribute: :due_at, start_date: @calendar_start_date) do |date, tasks| %>
                  <div class="calendar-day">
                    <div class="calendar-day-number"><%= date.day %></div>
                    <% if tasks.any? %>
                      <div class="calendar-tasks">
                        <% tasks.first(2).each do |task| %>
                          <div class="calendar-task" data-bs-toggle="modal" data-bs-target="#modal-day-<%= date %>">
                            <%= task.title %>
                          </div>
                        <% end %>
                      </div>
                      <% if tasks.size > 2 %>
                        <span class="calendar-more" data-bs-toggle="modal" data-bs-target="#modal-day-<%= date %>">
                          +<%= tasks.size - 2 %>
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                  <%= render "calendar_modal", date: date, tasks: tasks %>
                <% end %>
              <% else %>
                <div class="empty-state-compact">
                  <i class="bi bi-calendar2"></i>
                  <span>Nenhuma tarefa com prazo definido.</span>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- PRÓXIMAS AÇÕES -->
        <div class="col-lg-5 d-flex">
          <div class="chart-card w-100">
            <div class="chart-header">
              <h5><i class="bi bi-lightning-charge-fill me-2"></i> Próximas ações</h5>
            </div>
            <div class="chart-body tasks-list-body">
              <% if @my_tasks.any? %>
                <div class="tasks-list">
                  <% @my_tasks.limit(10).each do |task| %>
                    <div class="task-item">
                      <div class="task-item-header">
                        <i class="bi bi-check2-circle text-primary me-1"></i>
                        <span class="task-title"><%= task.title %></span>
                      </div>
                      <div class="task-item-meta">
                        <span><i class="bi bi-kanban me-1"></i> <%= task.bucket.action_plan.name %></span>
                        <% if task.due_at %>
                          <span><i class="bi bi-calendar-event me-1"></i> <%= l(task.due_at, format: :short) %></span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="empty-state-compact">
                  <i class="bi bi-check-circle-fill text-success"></i>
                  <span>Tudo em dia! Você não possui tarefas pendentes.</span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ========== OFFCANVAS – PLANOS (mobile) ========== -->
  <div class="offcanvas offcanvas-end d-lg-none" tabindex="-1" id="plansOffcanvas">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title"><i class="bi bi-kanban-fill me-2"></i> Meus Planos</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
      <%= render "plans_list", action_plans: @action_plans %>
      <div class="mt-3">
        <%= link_to new_action_plan_path, class: "btn-primary-solid w-100" do %>
          <i class="bi bi-plus-circle me-1"></i> Novo Plano
        <% end %>
      </div>
    </div>
  </div>

  <!-- ========== MODAIS ========== -->
  <% @action_plans.each do |plan| %>
    <%= render "delete_modal", plan: plan %>
  <% end %>
  <%= render "todaytasks_modal", today_tasks: @today_tasks %>
  <%= render "overdue_tasks_modal", overdue_tasks: @overdue_tasks %>

</div>
