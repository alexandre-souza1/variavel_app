<div class="modal fade app-modal" id="todayTasksModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-calendar-check me-2"></i>
          Tarefas para hoje
        </h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <% if today_tasks.any? %>
          <% today_tasks.each do |task| %>
            <div class="modal-task-item">
              <div class="modal-task-info">
                <div class="modal-task-title"><%= task.title %></div>
                <div class="modal-task-meta">
                  <span><i class="bi bi-folder me-1"></i> <%= task.bucket.name %></span>
                  <span><i class="bi bi-kanban me-1"></i> <%= task.bucket.action_plan.name %></span>
                </div>
                <% if task.due_at %>
                  <div class="modal-task-due">
                    <i class="bi bi-clock me-1"></i> <%= l(task.due_at, format: :short) %>
                  </div>
                <% end %>
                <div class="modal-task-users">
                  <% task.users.each do |user| %>
                    <span class="user-badge"><%= user.name.split.first %></span>
                  <% end %>
                </div>
              </div>
              <div class="modal-task-action">
                <%= link_to action_plan_path(task.bucket.action_plan, task_id: task.id),
                            class: "btn-primary-solid btn-sm" do %>
                  <i class="bi bi-arrow-right me-1"></i> Abrir
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted text-center py-4">Nenhuma tarefa vence hoje 🎉</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
