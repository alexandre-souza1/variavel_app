<div class="container-fluid action-plan-show dashboard-page <%= 'action-plan-show--auto-view' if params[:view].blank? %>"
     data-controller="open-task"
     data-open-task-task-id-value="<%= @task_to_open&.id %>">
  <%= turbo_stream_from "tasks_action_plan_#{@action_plan.id}" %>
  <div class="dashboard-header action-plan-header">

    <div class="header-content">

      <div class="action-plan-header__title">
        <h1>
          <i class="fas fa-file-invoice me-2"></i>
          <%= @action_plan.name %>
        </h1>

        <p class="subtitle">
          Criado em <%= l(@action_plan.created_at, format: :long) %>
        </p>
      </div>

      <div class="header-actions">
        <%= link_to action_plan_path(@action_plan, view: "kanban"),
            class: "btn-outline action-plan-view-link action-plan-view-link--kanban #{params[:view] != 'list' ? 'active' : ''}" do %>
          <i class="bi bi-kanban"></i>
          <span>Kanban</span>
        <% end %>

        <%= link_to action_plan_path(@action_plan, view: "list"),
            class: "btn-outline action-plan-view-link action-plan-view-link--list #{params[:view] == 'list' ? 'active' : ''}" do %>
          <i class="bi bi-list-check"></i>
          <span>Lista</span>
        <% end %>

        <%= link_to action_plans_path, class: "btn-outline action-plan-back-link", aria: { label: "Voltar para planos" } do %>
          <i class="fas fa-arrow-left me-1"></i> Voltar
        <% end %>
      </div>
    </div>
  </div>

  <div class="action-plan-mobile-summary d-md-none">
    <div class="action-plan-mobile-summary__item">
      <span class="action-plan-mobile-summary__value"><%= @open_tasks_count %></span>
      <span class="action-plan-mobile-summary__label">Abertas</span>
    </div>

    <div class="action-plan-mobile-summary__item">
      <span class="action-plan-mobile-summary__value"><%= @overdue_tasks_count %></span>
      <span class="action-plan-mobile-summary__label">Atrasadas</span>
    </div>

    <div class="action-plan-mobile-summary__item">
      <span class="action-plan-mobile-summary__value"><%= @done_tasks_count %></span>
      <span class="action-plan-mobile-summary__label">Concluídas</span>
    </div>
  </div>

  <% if params[:view] == "list" %>
    <%= render "list_view", buckets: @buckets, action_plan: @action_plan %>
  <% elsif params[:view] == "kanban" %>
    <div data-controller="kanban-scroll">

      <!-- SCROLL TOP -->
      <div
        data-kanban-scroll-target="top"
        class="kanban-scroll-top"
      >
        <div data-kanban-scroll-target="spacer"></div>
      </div>

      <!-- KANBAN -->
      <div
        data-kanban-scroll-target="bottom"
        class="kanban-scroll-bottom"
      >
        <div class="action-plan-kanban-panel">
          <%= render "kanban_view", buckets: @buckets, action_plan: @action_plan %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="action-plan-auto-list">
      <%= render "list_view", buckets: @buckets, action_plan: @action_plan %>
    </div>

    <div class="action-plan-auto-kanban" data-controller="kanban-scroll">

      <!-- SCROLL TOP -->
      <div
        data-kanban-scroll-target="top"
        class="kanban-scroll-top"
      >
        <div data-kanban-scroll-target="spacer"></div>
      </div>

      <!-- KANBAN -->
      <div
        data-kanban-scroll-target="bottom"
        class="kanban-scroll-bottom"
      >
        <div class="action-plan-kanban-panel">
          <%= render "kanban_view", buckets: @buckets, action_plan: @action_plan %>
        </div>
      </div>
    </div>
  <% end %>
</div>
