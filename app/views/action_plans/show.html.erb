<div
  class="container-fluid action-plan-show dashboard-page <%= 'action-plan-show--auto-view' if params[:view].blank? %>"
  data-controller="open-task"
  data-open-task-task-id-value="<%= @task_to_open&.id %>"
>
  <%= turbo_stream_from "tasks_action_plan_#{@action_plan.id}" %>

  <div class="dashboard-header action-plan-header">
    <div class="header-content">

      <div class="action-plan-header__title">
        <h1>
          <i class="fas fa-file-invoice me-2"></i>
          <%= @action_plan.name %>
        </h1>

        <p class="subtitle">
          Criado em <%= l(@action_plan.created_at, format: :long) %>
        </p>
      </div>

      <div class="action-plan-header__tools">
        <div class="header-actions">

        <!-- DEFINIR RESPONSÁVEIS -->
        <% if current_user.admin? %>
          <button
            type="button"
            class="btn-outline action-plan-assign-link"
            data-bs-toggle="modal"
            data-bs-target="#assignTasksModal"
          >
            <i class="bi bi-people"></i>
            <span>Definir responsáveis</span>
          </button>
        <% end %>

        <%= link_to new_action_plan_meeting_minute_path(@action_plan), class: "btn-outline action-plan-view-link" do %>
          <i class="bi bi-mic"></i>
          <span>Nova Reunião</span>
        <% end %>

        <%= link_to action_plan_meeting_minutes_path(@action_plan), class: "btn-outline action-plan-view-link" do %>
          <i class="bi bi-file-earmark-text"></i>
          <span>Atas de Reuniões</span>
        <% end %>

        <!-- LABELS -->
        <%= link_to action_plan_path(@action_plan, view: "labels"),
            class: "btn-outline action-plan-view-link #{params[:view] == 'labels' ? 'active' : ''}" do %>
          <i class="bi bi-tags"></i>
          <span>Etiquetas</span>
        <% end %>

        <!-- VOLTAR -->
        <%= link_to action_plans_path,
            class: "btn-outline action-plan-back-link",
            aria: { label: "Voltar para planos" } do %>
          <i class="fas fa-arrow-left me-1"></i>
          Voltar
        <% end %>

        <div class="action-plan-view-tools">
          <div class="action-plan-view-switch" role="group" aria-label="Visualização das tarefas">
            <%= link_to action_plan_path(@action_plan, view: "kanban"),
                class: "action-plan-view-switch__link action-plan-view-switch__link--kanban #{params[:view] != 'list' && params[:view] != 'labels' ? 'active' : ''}" do %>
              <i class="bi bi-kanban"></i>
              <span>Kanban</span>
            <% end %>

            <%= link_to action_plan_path(@action_plan, view: "list"),
                class: "action-plan-view-switch__link action-plan-view-switch__link--list #{params[:view] == 'list' ? 'active' : ''}" do %>
              <i class="bi bi-list-check"></i>
              <span>Lista</span>
            <% end %>
          </div>
        </div>

        </div>
      </div>
    </div>
  </div>


  <!-- RESUMO MOBILE -->
  <div class="action-plan-mobile-summary d-md-none">

    <div class="action-plan-mobile-summary__item">
      <span class="action-plan-mobile-summary__value">
        <%= @open_tasks_count %>
      </span>

      <span class="action-plan-mobile-summary__label">
        Abertas
      </span>
    </div>

    <div class="action-plan-mobile-summary__item">
      <span class="action-plan-mobile-summary__value">
        <%= @overdue_tasks_count %>
      </span>

      <span class="action-plan-mobile-summary__label">
        Atrasadas
      </span>
    </div>

    <div class="action-plan-mobile-summary__item">
      <span class="action-plan-mobile-summary__value">
        <%= @done_tasks_count %>
      </span>

      <span class="action-plan-mobile-summary__label">
        Concluídas
      </span>
    </div>

  </div>


  <!-- CONTEÚDO DO PLANO -->
  <% if params[:view] == "inbox" %>

    <%= render "inbox_view", action_plan: @action_plan, inbox_bucket: @inbox_bucket, inbox_tasks: @inbox_tasks %>

  <% elsif params[:view] == "labels" %>

    <%= render "labels_view", labels: @labels, action_plan: @action_plan, can_manage_labels: @can_manage_labels %>

  <% elsif params[:view] == "list" %>

    <div class="action-plan-with-inbox <%= 'is-inbox-collapsed' if current_user.action_plan_inbox_collapsed %>">
      <div class="action-plan-inbox-panel <%= 'is-inbox-collapsed' if current_user.action_plan_inbox_collapsed %>" data-controller="inbox-panel" data-inbox-panel-collapsed-value="<%= current_user.action_plan_inbox_collapsed %>" data-inbox-panel-preference-url="<%= inbox_preference_action_plan_path(@action_plan) %>">
        <div class="action-plan-inbox-collapsed-icon" aria-hidden="true">
          <i class="bi bi-inbox"></i>
        </div>
        <button type="button" class="action-plan-inbox-toggle" data-inbox-panel-toggle aria-expanded="<%= !current_user.action_plan_inbox_collapsed %>" aria-label="Minimizar Entrada" data-action="click->inbox-panel#toggle">
          <i class="bi bi-chevron-double-left"></i>
        </button>
        <div data-inbox-panel-target="content">
          <%= render "inbox_view", action_plan: @action_plan, inbox_bucket: @inbox_bucket, inbox_tasks: @inbox_tasks, sortable: false, view: "list" %>
        </div>
      </div>
      <div class="action-plan-tasks-panel action-plan-list-workspace">
        <%= render "list_view", buckets: @work_buckets, action_plan: @action_plan %>
      </div>
    </div>

  <% elsif params[:view] == "kanban" %>

    <div class="action-plan-with-inbox <%= 'is-inbox-collapsed' if current_user.action_plan_inbox_collapsed %>">
      <div class="action-plan-inbox-panel <%= 'is-inbox-collapsed' if current_user.action_plan_inbox_collapsed %>" data-controller="inbox-panel" data-inbox-panel-collapsed-value="<%= current_user.action_plan_inbox_collapsed %>" data-inbox-panel-preference-url="<%= inbox_preference_action_plan_path(@action_plan) %>">
        <div class="action-plan-inbox-collapsed-icon" aria-hidden="true">
          <i class="bi bi-inbox"></i>
        </div>
        <button type="button" class="action-plan-inbox-toggle" data-inbox-panel-toggle aria-expanded="<%= !current_user.action_plan_inbox_collapsed %>" aria-label="Minimizar Entrada" data-action="click->inbox-panel#toggle">
          <i class="bi bi-chevron-double-left"></i>
        </button>
        <div data-inbox-panel-target="content">
          <%= render "inbox_view", action_plan: @action_plan, inbox_bucket: @inbox_bucket, inbox_tasks: @inbox_tasks, sortable: true, view: "kanban" %>
        </div>
      </div>
      <div class="action-plan-tasks-panel action-plan-kanban-workspace">

      <!-- KANBAN -->
      <div
        data-kanban-scroll-target="bottom"
        class="kanban-scroll-bottom"
      >
        <div class="action-plan-kanban-panel">

          <%= render "kanban_view",
              buckets: @work_buckets,
              action_plan: @action_plan %>

        </div>
      </div>

      </div>
    </div>

  <% else %>

    <!-- VISÃO AUTOMÁTICA -->
    <div class="action-plan-with-inbox <%= 'is-inbox-collapsed' if current_user.action_plan_inbox_collapsed %>">
      <div class="action-plan-inbox-panel <%= 'is-inbox-collapsed' if current_user.action_plan_inbox_collapsed %>" data-controller="inbox-panel" data-inbox-panel-collapsed-value="<%= current_user.action_plan_inbox_collapsed %>" data-inbox-panel-preference-url="<%= inbox_preference_action_plan_path(@action_plan) %>">
        <div class="action-plan-inbox-collapsed-icon" aria-hidden="true">
          <i class="bi bi-inbox"></i>
        </div>
        <button type="button" class="action-plan-inbox-toggle" data-inbox-panel-toggle aria-expanded="<%= !current_user.action_plan_inbox_collapsed %>" aria-label="Minimizar Entrada" data-action="click->inbox-panel#toggle">
          <i class="bi bi-chevron-double-left"></i>
        </button>
        <div data-inbox-panel-target="content">
          <%= render "inbox_view", action_plan: @action_plan, inbox_bucket: @inbox_bucket, inbox_tasks: @inbox_tasks, sortable: true, view: "kanban" %>
        </div>
      </div>
      <div class="action-plan-tasks-panel action-plan-kanban-workspace">
        <div class="action-plan-auto-list">

          <%= render "list_view",
              buckets: @work_buckets,
              action_plan: @action_plan %>

        </div>

        <div class="action-plan-auto-kanban">

          <!-- KANBAN -->
          <div
            data-kanban-scroll-target="bottom"
            class="kanban-scroll-bottom"
          >
            <div class="action-plan-kanban-panel">

              <%= render "kanban_view",
                  buckets: @work_buckets,
                  action_plan: @action_plan %>

            </div>
          </div>
        </div>
      </div>
    </div>

  <% end %>


  <!-- ===================================================== -->
  <!-- MODAL - DEFINIR RESPONSÁVEIS -->
  <!-- ===================================================== -->

  <% if current_user.admin? %>
    <div
      class="modal fade action-plan-assign-modal"
      id="assignTasksModal"
      tabindex="-1"
      aria-labelledby="assignTasksModalLabel"
      aria-hidden="true"
    >
    <div class="modal-dialog modal-dialog-centered">

      <div class="modal-content">

        <!-- HEADER -->
        <div class="modal-header">

          <div>
            <p class="action-plan-assign-modal__eyebrow">Administração do plano</p>
            <h5
              class="modal-title"
              id="assignTasksModalLabel"
            >
              <i class="bi bi-people me-2"></i>
              Definir responsáveis
            </h5>

            <p class="action-plan-assign-modal__subtitle">
              Distribua as tarefas abertas entre os responsáveis escolhidos.
            </p>
          </div>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Fechar"
          ></button>

        </div>


        <!-- FORM -->
        <%= form_with(
          url: assign_open_tasks_action_plan_path(@action_plan),
          method: :patch,
          local: true
        ) do |form| %>

          <div class="modal-body">

            <!-- MANTÉM A VISÃO ATUAL -->
            <%= hidden_field_tag :view, params[:view] %>


            <!-- RESPONSÁVEIS -->
            <div class="action-plan-assign-modal__section">

              <div class="action-plan-assign-modal__section-heading">
                <div>
                  <label class="form-label">Responsáveis</label>
                  <small>Selecione uma ou mais pessoas</small>
                </div>
                <i class="bi bi-check2-square" aria-hidden="true"></i>
              </div>

              <div class="action-plan-assign-modal__user-grid">

                <% @users.each do |user| %>

                  <label class="action-plan-assign-modal__user-option" for="user_<%= user.id %>">

                    <%= check_box_tag(
                      "user_ids[]",
                      user.id,
                      false,
                      class: "form-check-input",
                      id: "user_#{user.id}"
                    ) %>

                    <span><%= user.name %></span>

                  </label>

                <% end %>

              </div>

            </div>


            <!-- AVISO -->
            <div class="action-plan-assign-modal__warning">

              <i class="bi bi-exclamation-triangle mt-1"></i>

              <div>
                <strong>As tarefas abertas serão redistribuídas</strong>
                <span>
                todas as tarefas
                <strong>abertas</strong>
                deste plano terão seus responsáveis atuais substituídos
                pelos usuários selecionados.
                As tarefas concluídas não serão alteradas.
                </span>
              </div>

            </div>

          </div>


          <!-- FOOTER -->
          <div class="modal-footer">

            <button
              type="button"
              class="btn btn-outline-secondary"
              data-bs-dismiss="modal"
            >
              Cancelar
            </button>

            <%= form.submit "Atribuir tarefas", class: "btn btn-primary" %>

          </div>

        <% end %>

      </div>
    </div>
    </div>
  <% end %>

</div>
