<% filtered_tasks = local_assigns[:tasks] %>
<div data-controller="action-plan-filter">
  <div class="action-plan-kanban-filter">
    <div class="action-plan-kanban-filter__content">
      <div class="action-plan-kanban-filter__label">
        <span class="action-plan-kanban-filter__icon">
          <i class="bi bi-search"></i>
        </span>
        <div>
          <strong>Filtrar Kanban</strong>
          <span>Busque por tarefa, bucket, label ou responsável</span>
        </div>
      </div>

      <div class="action-plan-list-search action-plan-kanban-filter__search">
        <i class="bi bi-search"></i>
        <input class="form-control"
               type="search"
               placeholder="Digite para filtrar..."
               autocomplete="off"
               data-action-plan-filter-target="query"
               data-action="input->action-plan-filter#filter">
      </div>
    </div>
  </div>

  <p class="action-plan-kanban-hint d-md-none">
    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
    Deslize para ver os buckets. Segure uma tarefa para movê-la.
  </p>

  <div id="kanban-<%= action_plan.id %>"
       class="row flex-nowrap action-plan-kanban-board"
       data-controller="kanban-drag-scroll bucket-sortable"
       data-bucket-sortable-action-plan-id-value="<%= action_plan.id %>">

  <% buckets.each do |bucket| %>
    <% task_scope = bucket.tasks.visible_for(current_user) %>
    <% task_scope = task_scope.where(id: filtered_tasks.map(&:id)) if filtered_tasks %>
    <% open_tasks = task_scope
                          .includes(:users, :labels)
                          .where(completed: false)
                          .order(:position) %>
    <% done_tasks = task_scope
                           .where(completed: true)
                           .includes(:users, :labels)
                           .order(:position) %>
    <% done_tasks_count = done_tasks.count %>

    <div id="bucket_<%= bucket.id %>"
     class="kanban-column col-12 col-md-4 col-lg-3 action-plan-kanban-column"
     data-action-plan-filter-target="group"
     data-bucket-id="<%= bucket.id %>">

      <div class="card action-plan-kanban-card mb-3">

        <div class="card-header action-plan-kanban-card__header d-flex justify-content-between align-items-center">

          <div data-controller="bucket-edit" data-bucket-id="<%= bucket.id %>" data-action-plan-id="<%= action_plan.id %>" class="action-plan-kanban-card__heading">
            <i class="bi bi-grip-vertical drag-handle"></i>
            <div class="action-plan-kanban-card__title-group">
              <span data-bucket-edit-target="title"
                    data-action="click->bucket-edit#edit blur->bucket-edit#save keydown->bucket-edit#enter"
                    contenteditable="false"
                    class="action-plan-kanban-card__title">
                <%= bucket.name %>
              </span>
            </div>

          </div>

          <div class="action-plan-kanban-card__actions">
            <span class="action-plan-kanban-card__count" aria-label="Tarefas abertas">
              <%= open_tasks.size %>
            </span>

            <% if !filtered_tasks && (current_user.admin? || action_plan.user == current_user) %>
              <%= link_to action_plan_bucket_path(action_plan, bucket),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Tem certeza?"
                  },
                  class: "btn btn-sm action-plan-kanban-card__remove" do %>

                <i class="bi bi-x-lg text-danger"></i>

              <% end %>
            <% end %>
          </div>
        </div>

        <% unless current_user.mechanical? || filtered_tasks %>
        <div class="card-footer action-plan-kanban-card__composer">
          <%= render "tasks/composer", action_plan: action_plan, bucket: bucket %>
        </div>
        <% end %>

        <div class="card-body action-plan-kanban-card__body"
             data-sortable-bucket-id-value="<%= bucket.id %>"
             data-bucket-id="<%= bucket.id %>">


          <div id="open-tasks-<%= bucket.id %>"
               class="action-plan-kanban-task-list"
               data-controller="sortable">

            <% open_tasks.each do |task| %>
              <% search_text = [
                   task.title,
                   task.description,
                   bucket.name,
                   task.labels.map(&:name),
                   task.users.map(&:name)
                 ].flatten.compact.join(" ") %>

              <%= render "tasks/task", task: task, search_text: search_text %>
            <% end %>

          </div>


          <div class="mt-3">

            <div data-controller="toggle-done"
              data-toggle-done-preloaded-value="<%= filtered_tasks.present? %>"
              data-bucket-id="<%= bucket.id %>">


              <button type="button" class="action-plan-kanban-done-toggle"
                   aria-expanded="false" aria-controls="done-tasks-<%= bucket.id %>"
                   data-action="click->toggle-done#toggle">


                <small id="done-count-<%= bucket.id %>"
                       class="text-muted action-plan-kanban-done-count">

                  <i class="bi bi-check2-circle"></i>
                  Tarefas concluídas (<%= done_tasks_count %>)

                </small>


                <%= disclosure_arrow(css_class: "action-plan-kanban-done-icon", data: { toggle_done_target: "icon" }) %>


              </button>


              <div id="done-tasks-<%= bucket.id %>"
                  class="d-none"
                  data-toggle-done-target="list">
                <%= render "tasks/done_tasks", tasks: done_tasks if filtered_tasks %>
              </div>


            </div>

          </div>


        </div>


      </div>

    </div>


  <% end %>


  <!-- NOVO BUCKET -->
  <% unless current_user.mechanical? || filtered_tasks %>
    <div class="col-12 col-md-4 col-lg-3 action-plan-kanban-column">

      <div class="h-100 d-flex align-items-start">

        <div class="action-plan-kanban-new-bucket">

          <%= form_with model: [action_plan, Bucket.new] do |f| %>

            <div class="action-plan-kanban-new-bucket__header">
              <i class="bi bi-plus-lg"></i>

              <div>
                Novo bucket
              </div>
            </div>


            <div class="input-group">

              <%= f.text_field :name,
                  placeholder: "Nome...",
                  class: "form-control form-control-sm" %>


              <button class="btn btn-primary btn-sm">
                Criar
              </button>

            </div>


          <% end %>

        </div>

      </div>

    </div>
  <% end %>

  </div>

  <div class="action-plan-list-empty d-none" data-action-plan-filter-target="empty">
    Nenhuma tarefa encontrada para esse filtro.
  </div>
</div>
