<div data-controller="action-plan-filter">
  <div class="action-plan-kanban-filter">
    <div class="action-plan-kanban-filter__content">
      <div class="action-plan-kanban-filter__label">
        <span class="action-plan-kanban-filter__icon">
          <i class="bi bi-search"></i>
        </span>
        <div>
          <strong>Filtrar Kanban</strong>
          <span>Busque por tarefa, bucket, label ou responsável</span>
        </div>
      </div>

      <div class="action-plan-list-search action-plan-kanban-filter__search">
        <i class="bi bi-search"></i>
        <input class="form-control"
               type="search"
               placeholder="Digite para filtrar..."
               autocomplete="off"
               data-action-plan-filter-target="query"
               data-action="input->action-plan-filter#filter">
      </div>
    </div>
  </div>

  <div id="kanban-<%= action_plan.id %>"
       class="row flex-nowrap overflow-auto action-plan-kanban-board"
       data-controller="drag-scroll bucket-sortable"
       data-bucket-sortable-action-plan-id-value="<%= action_plan.id %>">

  <% buckets.each do |bucket| %>
    <% open_tasks = bucket.tasks
                          .visible_for(current_user)
                          .includes(:users, :labels)
                          .where(completed: false)
                          .order(:position) %>
    <% done_tasks_count = bucket.tasks.visible_for(current_user)
                           .where(completed: true)
                           .count %>

    <div id="bucket_<%= bucket.id %>"
     class="kanban-column col-12 col-md-4 col-lg-3 action-plan-kanban-column"
     data-action-plan-filter-target="group"
     data-bucket-id="<%= bucket.id %>">

      <div class="card action-plan-kanban-card mb-3">

        <div class="card-header action-plan-kanban-card__header d-flex justify-content-between align-items-center">

          <div data-controller="bucket-edit" data-bucket-id="<%= bucket.id %>" data-action-plan-id="<%= action_plan.id %>" class="action-plan-kanban-card__heading">
            <i class="bi bi-grip-vertical drag-handle"></i>
            <div class="action-plan-kanban-card__title-group">
              <span data-bucket-edit-target="title"
                    data-action="click->bucket-edit#edit"
                    class="action-plan-kanban-card__title">
                <%= bucket.name %>
              </span>

              <span class="action-plan-kanban-card__count">
                <%= open_tasks.size %> abertas
              </span>
            </div>

            <input type="text"
                   value="<%= bucket.name %>"
                   data-bucket-edit-target="input"
                   data-action="blur->bucket-edit#save keydown->bucket-edit#enter"
                   class="form-control form-control-sm d-none"
                   autocomplete="off">

          </div>

          <% if current_user.admin? or action_plan.user == current_user %>
            <%= link_to action_plan_bucket_path(action_plan, bucket),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Tem certeza?"
                },
                class: "btn btn-sm action-plan-kanban-card__remove" do %>

              <i class="bi bi-x-lg text-danger"></i>

            <% end %>
          <% end %>
        </div>

        <% unless current_user.mechanical? %>
        <div class="card-footer action-plan-kanban-card__composer" data-controller="new-task">

          <button
            class="action-plan-kanban-add-task"
            data-action="click->new-task#toggle"
            data-new-task-target="button">
            <i class="bi bi-plus-lg"></i>
            Adicionar tarefa
          </button>


          <div class="collapse mt-2" data-new-task-target="wrapper">

            <div class="action-plan-kanban-new-task">

              <%= form_with model: [action_plan, bucket, Task.new],
                  data: {
                    action: "turbo:submit-end->new-task#afterSubmit",
                    new_task_target: "form"
                  } do |f| %>


                <%= f.text_field :title,
                    placeholder: "Nome da tarefa...",
                    class: "form-control mb-2",
                    data: { new_task_target: "title" },
                    required: true %>


                <div data-controller="toggle-field" class="mb-2">

                  <button
                    type="button"
                    class="btn btn-light text-dark btn-sm w-100 align-items-start d-flex gap-1 action-plan-kanban-form-toggle"
                    data-toggle-field-target="button"
                    data-action="click->toggle-field#toggle">
                    📅 Definir data
                  </button>


                  <div class="mt-2 d-none" data-toggle-field-target="field">

                    <%= f.date_field :due_at,
                        class: "form-control",
                        data: {
                          action: "change->toggle-field#updateDate"
                        } %>

                  </div>

                </div>


                <div data-controller="toggle-field" class="mb-2">

                  <button
                    type="button"
                    class="btn btn-light text-dark btn-sm w-100 align-items-start d-flex gap-1 action-plan-kanban-form-toggle"
                    data-toggle-field-target="button"
                    data-action="click->toggle-field#toggle">
                    👤 Atribuir responsável
                  </button>


                  <div class="mt-2 d-none" data-toggle-field-target="field">

                    <%= f.collection_select :user_ids,
                        User.all,
                        :id,
                        :name,
                        {},
                        {
                          class:"form-select",
                          multiple:true,
                          data:{
                            controller:"tom-select-users",
                            action: "change->toggle-field#updateUsers"
                          }
                        } %>

                  </div>

                </div>


                <div class="d-flex justify-content-between gap-1">

                  <button class="btn btn-primary col-10">
                    Salvar
                  </button>


                  <button
                    type="button"
                    class="btn btn-outline-secondary col-1 align-items-center d-flex justify-content-center"
                    data-action="click->new-task#cancel">

                    <i class="bi bi-x"></i>

                  </button>

                </div>


              <% end %>

            </div>

          </div>

        </div>
        <% end %>


        <div class="card-body action-plan-kanban-card__body"
             data-sortable-bucket-id-value="<%= bucket.id %>"
             data-bucket-id="<%= bucket.id %>"
             style="min-height:300px;">


          <div id="open-tasks-<%= bucket.id %>"
               class="action-plan-kanban-task-list"
               data-controller="sortable">

            <% open_tasks.each do |task| %>
              <% search_text = [
                   task.title,
                   task.description,
                   bucket.name,
                   task.labels.map(&:name),
                   task.users.map(&:name)
                 ].flatten.compact.join(" ") %>

              <%= render "tasks/task", task: task, search_text: search_text %>
            <% end %>

          </div>


          <div class="mt-3">

            <div data-controller="toggle-done"
              data-bucket-id="<%= bucket.id %>">


              <div class="action-plan-kanban-done-toggle"
                   data-action="click->toggle-done#toggle">


                <small id="done-count-<%= bucket.id %>"
                       class="text-muted action-plan-kanban-done-count">

                  <i class="bi bi-check2-circle"></i>
                  Tarefas concluídas (<%= done_tasks_count %>)

                </small>


                <span data-toggle-done-target="icon" class="action-plan-kanban-done-icon">
                  ▼
                </span>


              </div>


              <div id="done-tasks-<%= bucket.id %>"
                  class="d-none"
                  data-toggle-done-target="list">
              </div>


            </div>

          </div>


        </div>


      </div>

    </div>


  <% end %>


  <!-- NOVO BUCKET -->
  <% unless current_user.mechanical? %>
    <div class="col-12 col-md-4 col-lg-3 action-plan-kanban-column">

      <div class="h-100 d-flex align-items-start">

        <div class="action-plan-kanban-new-bucket">

          <%= form_with model: [action_plan, Bucket.new] do |f| %>

            <div class="action-plan-kanban-new-bucket__header">
              <i class="bi bi-plus-lg"></i>

              <div>
                Novo bucket
              </div>
            </div>


            <div class="input-group">

              <%= f.text_field :name,
                  placeholder: "Nome...",
                  class: "form-control form-control-sm" %>


              <button class="btn btn-primary btn-sm">
                Criar
              </button>

            </div>


          <% end %>

        </div>

      </div>

    </div>
  <% end %>

  </div>

  <div class="action-plan-list-empty d-none" data-action-plan-filter-target="empty">
    Nenhuma tarefa encontrada para esse filtro.
  </div>
</div>
