<% filters = params.permit(:query, :start_date, :show_hidden).to_h %>
<nav class="d-flex flex-wrap align-items-center gap-2 p-3 border-bottom" aria-label="Filtrar planos">
  <%= link_to "Ativos", action_plans_path(filters),
              class: "btn btn-sm #{@show_archived_action_plans ? 'btn-outline-primary' : 'btn-primary'}",
              aria: { current: @show_archived_action_plans ? nil : "page" } %>
  <% if @hidden_action_plan_ids.any? %>
    <%= link_to action_plans_path(filters.merge(status: @show_archived_action_plans ? "archived" : nil, show_hidden: @show_hidden_action_plans ? nil : 1)),
                class: "text-secondary small",
                title: @show_hidden_action_plans ? "Ocultar planos ocultos" : "Ver planos ocultos",
                aria: { label: @show_hidden_action_plans ? "Ocultar planos ocultos" : "Ver planos ocultos" } do %>
      <i class="bi <%= @show_hidden_action_plans ? 'bi-eye-slash' : 'bi-eye' %>" aria-hidden="true"></i>
    <% end %>
  <% end %>
</nav>
