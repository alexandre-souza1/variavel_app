<div class="modal fade" id="modal-day-<%= date %>" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-calendar3 me-2"></i>
          Tarefas do dia <%= l(date, format: "%d de %B") %>
        </h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <% tasks.each do |task| %>
          <div class="modal-task-item">
            <div class="modal-task-info">
              <div class="modal-task-title"><%= task.title %></div>
              <div class="modal-task-meta">
                <span><i class="bi bi-folder me-1"></i> <%= task.bucket.name %></span>
                <span><i class="bi bi-kanban me-1"></i> <%= task.bucket.action_plan.name %></span>
              </div>
              <div class="modal-task-users">
                <% task.users.each do |user| %>
                  <span class="user-badge"><%= user.name.split.first %></span>
                <% end %>
              </div>
            </div>
            <div class="modal-task-action">
              <%= link_to action_plan_path(task.bucket.action_plan, task_id: task.id),
                          class: "btn-primary-solid btn-sm" do %>
                <i class="bi bi-arrow-right me-1"></i> Abrir
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
