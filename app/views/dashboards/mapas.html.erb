<div class="mapas-dashboard-page">
  <!-- Cabeçalho -->
  <header class="mapas-dashboard-header">
    <div>
      <p class="mapas-dashboard-eyebrow"><i class="bi bi-map me-1"></i> DU · Distribuição urbana</p>
      <h1><i class="bi bi-speedometer2 me-2"></i>Dashboard de mapas</h1>
      <p>Visão consolidada da operação, produtividade e remuneração do ciclo.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to dashboard_mapas_path(format: :pdf, mes: @mes, ano: @ano, periodo_tipo: @periodo_tipo), class: 'btn btn-primary', data: { turbo: false } do %><i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i> Relatório gerencial<% end %>
      <%= link_to mapas_todos_path, class: "btn btn-outline-primary" do %><i class="bi bi-list-ul me-1"></i> Mapas cadastrados<% end %>
    </div>
  </header>

  <!-- Filtro de período -->
  <div class="app-panel mb-4 mapas-period-card">
    <div class="app-panel__body">
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
          <h2 class="mb-1 mapas-period-title">
            <i class="bi bi-calendar-range me-2"></i>
            <%= @periodo_inicio.strftime("%d/%m/%Y") %> a <%= @periodo_fim.strftime("%d/%m/%Y") %>
          </h2>
          <p class="text-muted mb-0">Visão consolidada pelo ciclo de remuneração, do dia 21 ao dia 20.</p>
        </div>

        <%= form_with url: dashboard_mapas_path, method: :get, local: true, class: "row gx-2 gy-2 align-items-end" do %>
          <div class="col-auto">
            <label class="form-label small text-muted mb-1" for="mes">Mês</label>
            <%= select_tag :mes,
                options_for_select((1..12).map { |m| [I18n.t("date.month_names")[m], m] }, @mes),
                class: "form-select form-select-sm" %>
          </div>

          <div class="col-auto">
            <label class="form-label small text-muted mb-1" for="ano">Ano</label>
            <%= select_tag :ano,
                options_for_select((Date.today.year - 5..Date.today.year).to_a.reverse, @ano),
                class: "form-select form-select-sm" %>
          </div>

          <div class="col-auto">
            <label class="form-label small text-muted mb-1" for="periodo_tipo">Período</label>
            <%= select_tag :periodo_tipo,
                options_for_select([
                  ["Ciclo completo", "mes"],
                  ["1ª quinzena do ciclo", "primeira_quinzena"],
                  ["2ª quinzena do ciclo", "segunda_quinzena"]
                ], @periodo_tipo),
                class: "form-select form-select-sm" %>
          </div>

          <div class="col-auto">
            <%= submit_tag "Filtrar", class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Cards de resumo -->
  <div class="row g-3 mb-4 mapas-summary-grid">
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card h-100">
        <div class="card-body text-center">
          <p class="text-muted small mb-1">Mapas</p>
          <h3 class="mb-0"><%= @total_mapas %></h3>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card h-100">
        <div class="card-body text-center">
          <p class="text-muted small mb-1">Motoristas</p>
          <h3 class="mb-0"><%= @ranking_motoristas.size %></h3>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card h-100">
        <div class="card-body text-center">
          <p class="text-muted small mb-1">Ajudantes</p>
          <h3 class="mb-0"><%= @ranking_ajudantes.size %></h3>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card h-100">
        <div class="card-body text-center">
          <p class="text-muted small mb-1">Placas</p>
          <h3 class="mb-0"><%= @ranking_placas.size %></h3>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card h-100">
        <div class="card-body text-center">
          <p class="text-muted small mb-1">Variável · Motoristas</p>
          <h5 class="mb-0"><%= number_to_currency(@total_remuneracao_motoristas, unit: "R$ ", separator: ",", delimiter: ".") %></h5>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card h-100">
        <div class="card-body text-center">
          <p class="text-muted small mb-1">Variável · Ajudantes</p>
          <h5 class="mb-0"><%= number_to_currency(@total_remuneracao_ajudantes, unit: "R$ ", separator: ",", delimiter: ".") %></h5>
        </div>
      </div>
    </div>
  </div>

  <!-- Segunda linha de cards (operações) -->
  <div class="row g-3 mb-4 mapas-operation-grid">
    <div class="col-12 col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <p class="text-muted small mb-1">Caixas entregues</p>
          <h4 class="mb-0"><%= number_with_precision(@total_cx_real, precision: 0, delimiter: ".") %></h4>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <p class="text-muted small mb-1">PDVs atendidos</p>
          <h4 class="mb-0"><%= number_with_precision(@total_pdv_real, precision: 0, delimiter: ".") %></h4>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <p class="text-muted small mb-1">Recargas</p>
          <h4 class="mb-0"><%= @total_recargas %></h4>
        </div>
      </div>
    </div>
  </div>

  <!-- Gráficos -->
  <section class="mapas-chart-pages mb-4" data-controller="chart-pages" aria-label="Gráficos da operação DU">
    <div class="mapas-chart-stage" data-chart-pages-target="stage">
      <div id="mapas-productivity-page" class="mapas-chart-page" data-chart-pages-target="page">
        <div class="row g-3 mapas-charts-grid">
          <div class="col-12 col-md-6 col-xl-4">
            <%= render 'ranking_chart', label: 'Motoristas', icon: 'bi-bar-chart-fill', chart_id: 'mapas-motoristas-chart', top_data: @motoristas_top10_valor, bottom_data: @motoristas_bottom10_valor %>
          </div>
          <div class="col-12 col-md-6 col-xl-4">
            <%= render 'ranking_chart', label: 'Ajudantes', icon: 'bi-people-fill', chart_id: 'mapas-ajudantes-chart', top_data: @ajudantes_top10_valor, bottom_data: @ajudantes_bottom10_valor %>
          </div>
          <div class="col-12 col-md-12 col-xl-4">
            <div class="card h-100 mapas-chart-card">
              <div class="mapas-card-header app-panel__header">
                <div class="dashboard-panel-heading">
                  <span class="dashboard-panel-kicker"><i class="bi bi-graph-up me-1"></i> Tendência · Operação</span>
                  <h2>Mapas por dia</h2>
                  <small>Quantidade de mapas registrados em cada dia do ciclo.</small>
                </div>
              </div>
              <div class="card-body">
                <%= line_chart @mapas_por_dia, height: "250px", discrete: true %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="mapas-devolution-page" class="mapas-chart-page" data-chart-pages-target="page" hidden inert>
        <%= render 'devolution_charts', report: @devolution_report %>
      </div>

      <div id="mapas-variable-average-page" class="mapas-chart-page" data-chart-pages-target="page" hidden inert>
        <%= render 'variable_average_charts', report: @variable_average_report %>
      </div>
    </div>
    <div class="mapas-chart-dots mapas-chart-page-dots" role="group" aria-label="Selecionar conjunto de gráficos"
         data-action="keydown.left->chart-pages#previous:prevent keydown.right->chart-pages#next:prevent">
      <% [['Produtividade', 'mapas-productivity-page'], ['Devolução', 'mapas-devolution-page'], ['Média de variável', 'mapas-variable-average-page']].each_with_index do |(label, page_id), index| %>
        <button type="button" class="mapas-chart-dot" aria-label="Mostrar gráficos de <%= label.downcase %>" title="<%= label %>"
                aria-controls="<%= page_id %>" aria-pressed="<%= index.zero? %>"
                data-chart-pages-target="dot" data-chart-pages-index-param="<%= index %>"
                data-action="chart-pages#select"><span aria-hidden="true"></span></button>
      <% end %>
      <span class="visually-hidden" aria-live="polite" data-chart-pages-target="status">Gráficos de produtividade</span>
    </div>
  </section>

  <!-- Tabelas Motoristas e Ajudantes lado a lado -->
  <div class="mapas-rankings-grid mb-4">
    <!-- Tabela Motoristas -->
    <section class="app-panel mapas-table-card" aria-labelledby="mapas-motoristas-title">
      <div class="mapas-card-header app-panel__header">
        <div class="dashboard-panel-heading">
          <span class="dashboard-panel-kicker"><i class="bi bi-person-lines-fill me-1"></i> Ranking do ciclo</span>
          <h2 id="mapas-motoristas-title">Motoristas que mais rodaram</h2>
          <small>Ranking de produtividade e remuneração no ciclo.</small>
        </div>
      </div>
      <div class="mapas-table-card__body">
        <div class="app-table-shell" tabindex="0" role="region" aria-label="Ranking de motoristas">
          <table class="table app-table app-table--report mapas-ranking-table mb-0">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Motorista</th>
                <th scope="col">Mapas</th>
                <th scope="col">Cx Real</th>
                <th scope="col">PDV Real</th>
                <th scope="col" title="Recargas">Rec.</th>
                <th scope="col" title="Percentual de devolução">Dev.%</th>
                <th scope="col">Valor</th>
              </tr>
            </thead>
            <tbody>
              <% if @ranking_motoristas.empty? %>
                <tr>
                  <td colspan="8" class="text-center text-muted">Nenhum motorista encontrado.</td>
                </tr>
              <% end %>
              <% @ranking_motoristas.each_with_index do |m, index| %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td class="mapas-ranking-name">
                    <%= m[:nome] %>
                    <% if m[:cargo] == 'van' %><span class="mapas-role-label">Van</span><% end %>
                  </td>
                  <td><span class="badge mapas-count"><%= m[:mapas] %></span></td>
                  <td><%= number_with_precision(m[:cx_real], precision: 0, delimiter: ".") %></td>
                  <td><%= number_with_precision(m[:pdv_real], precision: 0, delimiter: ".") %></td>
                  <td><%= m[:recargas].to_i %></td>
                  <td><%= m[:percentual_devolucao].nil? ? '—' : "#{(m[:percentual_devolucao] * 100).round(2)}%" %></td>
                  <td class="mapas-ranking-value"><%= number_to_currency(m[:valor_total], unit: "R$ ", separator: ",", delimiter: ".") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Tabela Ajudantes -->
    <section class="app-panel mapas-table-card" aria-labelledby="mapas-ajudantes-title">
      <div class="mapas-card-header app-panel__header">
        <div class="dashboard-panel-heading">
          <span class="dashboard-panel-kicker"><i class="bi bi-people-fill me-1"></i> Ranking do ciclo</span>
          <h2 id="mapas-ajudantes-title">Ajudantes que mais rodaram</h2>
          <small>Ranking de produtividade e remuneração no ciclo.</small>
        </div>
      </div>
      <div class="mapas-table-card__body">
        <div class="app-table-shell" tabindex="0" role="region" aria-label="Ranking de ajudantes">
          <table class="table app-table app-table--report mapas-ranking-table mb-0">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Ajudante</th>
                <th scope="col">Mapas</th>
                <th scope="col">Cx Real</th>
                <th scope="col">PDV Real</th>
                <th scope="col" title="Recargas">Rec.</th>
                <th scope="col" title="Percentual de devolução">Dev.%</th>
                <th scope="col">Valor</th>
              </tr>
            </thead>
            <tbody>
              <% if @ranking_ajudantes.empty? %>
                <tr>
                  <td colspan="8" class="text-center text-muted">Nenhum ajudante encontrado.</td>
                </tr>
              <% end %>
              <% @ranking_ajudantes.each_with_index do |a, index| %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td class="mapas-ranking-name"><%= a[:nome] %></td>
                  <td><span class="badge mapas-count"><%= a[:mapas] %></span></td>
                  <td><%= number_with_precision(a[:cx_real], precision: 0, delimiter: ".") %></td>
                  <td><%= number_with_precision(a[:pdv_real], precision: 0, delimiter: ".") %></td>
                  <td><%= a[:recargas].to_i %></td>
                  <td><%= a[:percentual_devolucao].nil? ? '—' : "#{(a[:percentual_devolucao] * 100).round(2)}%" %></td>
                  <td class="mapas-ranking-value"><%= number_to_currency(a[:valor_total], unit: "R$ ", separator: ",", delimiter: ".") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <!-- Tabela Placas (largura total) -->
  <section class="app-panel mb-4 mapas-table-card" aria-labelledby="mapas-placas-title">
    <div class="mapas-card-header app-panel__header">
      <div class="dashboard-panel-heading">
        <span class="dashboard-panel-kicker"><i class="bi bi-truck-front-fill me-1"></i> Registro · Frota</span>
        <h2 id="mapas-placas-title">Placas que mais rodaram</h2>
        <small>Veículos com maior volume de mapas no ciclo.</small>
      </div>
    </div>
    <div class="mapas-table-card__body">
      <div class="app-table-shell" tabindex="0" role="region" aria-label="Ranking de placas">
        <table class="table app-table app-table--report mapas-fleet-table mb-0">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Placa</th>
              <th scope="col">Mapas</th>
              <th scope="col">Motoristas</th>
              <th scope="col">Cx Real</th>
              <th scope="col">PDV Real</th>
              <th scope="col">Recargas</th>
            </tr>
          </thead>
          <tbody>
            <% if @ranking_placas.empty? %>
              <tr>
                <td colspan="7" class="text-center text-muted">Nenhuma placa encontrada.</td>
              </tr>
            <% end %>
            <% @ranking_placas.each_with_index do |placa, index| %>
              <tr>
                <td><%= index + 1 %></td>
                <td class="fw-bold"><%= placa[:placa] %></td>
                <td><span class="badge mapas-count"><%= placa[:mapas] %></span></td>
                <td><%= placa[:motoristas] %></td>
                <td><%= number_with_precision(placa[:cx_real], precision: 0, delimiter: ".") %></td>
                <td><%= number_with_precision(placa[:pdv_real], precision: 0, delimiter: ".") %></td>
                <td><%= placa[:recargas] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <%= link_to "Voltar ao início", variaveis_path, class: "btn btn-primary shadow-sm w-100 mb-4" %>
</div>
