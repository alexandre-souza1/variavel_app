<div class="dashboard-page placas-sector-page">
  <header class="dashboard-header">
    <div class="header-content">
      <div>
        <h1><i class="bi bi-speedometer2"></i> Placas por Setor</h1>
        <p class="subtitle">Teste de estresse e acompanhamento da movimentação mensal da frota.</p>
      </div>
    </div>
  </header>

  <!-- Filtros -->
  <section class="app-panel filter-panel mb-4">
    <div class="app-panel__header">
      <div class="panel-heading">
        <span class="app-panel__kicker"><i class="bi bi-sliders me-1"></i> Consulta</span>
        <h2 class="app-panel__title">Filtros da movimentação</h2>
        <small class="app-panel__subtitle">Selecione a placa e o período que deseja acompanhar.</small>
      </div>
    </div>
    <div class="app-panel__body">
      <%= form_with url: placas_por_setor_path, method: :get, local: true, class: "row g-3" do |f| %>
        <div class="col-md-4">
          <%= f.label :placa, "Placa" %>
            <%= f.select :placa,
              options_for_select(
                [["Todas", ""]] + Plate.active.where(setor: "ROTA").order(:placa).pluck(:placa),
                params[:placa]
              ),
              {},
              class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= f.label :mes, "Mês" %>
          <%= f.select :mes, options_for_select((1..12).map { |m| [I18n.t("date.month_names")[m], m] }, params[:mes] || Date.current.month), {}, class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= f.label :ano, "Ano" %>
          <%= f.select :ano, options_for_select((Date.current.year-2..Date.current.year+1).to_a, params[:ano] || Date.current.year), {}, class: "form-select" %>
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <%= f.submit "Filtrar", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Resumo por setor -->
  <div class="sector-status-grid mb-4">
    <% @status_por_setor.each do |setor, status| %>
      <div class="app-panel sector-status-card <%= status[:completo] ? 'is-complete' : 'is-pending' %>">
        <div class="app-panel__body text-center">
            <span class="app-panel__kicker">Setor</span>
            <h2 class="sector-status-title"><%= setor %></h2>
            <p class="sector-status-summary">
              <%= status[:rodaram] %> / <%= status[:total] %> placas rodaram
            </p>
            <% if status[:completo] %>
              <span class="status-pill status-pill--success"><i class="bi bi-check-circle me-1"></i> Setor completo</span>
            <% else %>
              <span class="status-pill status-pill--danger"><i class="bi bi-exclamation-circle me-1"></i> <%= status[:total] - status[:rodaram] %> placa(s) ociosa(s)</span>
            <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Tabela de placas -->
  <section class="app-panel plates-detail-panel">
    <div class="app-panel__header">
      <div class="panel-heading">
        <span class="app-panel__kicker"><i class="bi bi-calendar3 me-1"></i> Operação</span>
        <h2 class="app-panel__title">Detalhamento diário</h2>
        <small class="app-panel__subtitle">Movimentação das placas no período selecionado.</small>
      </div>
    </div>
    <div class="app-panel__body table-responsive">
      <table class="table table-bordered table-hover table-sm">
        <thead class="table-light">
          <tr>
            <th>Setor</th>
            <th>Placa</th>
            <th>Perfil</th>
            <th>Tipo</th>
            <th>Dias rodados</th>
            <% @dias_do_mes.each do |dia| %>
              <th class="text-center"><%= dia %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @placas.each do |placa_obj| %>
            <%
            dias_rodados =
              PlateUtils
                .equivalentes(placa_obj.placa)
                .flat_map { |placa| @dias_rodados[placa] || [] }
                .uniq
            %>
            <tr>
              <td><%= placa_obj.setor %></td>
              <td><strong><%= placa_obj.placa %></strong></td>
              <td><%= placa_obj.perfil %></td>
              <td><%= placa_obj.tipo %></td>
              <td>
                <span class="badge bg-<%= dias_rodados.any? ? 'success' : 'danger' %>"> <%# herb:disable erb-no-interpolated-class-names %>
                  <%= dias_rodados.size %> dia(s)
                </span>
              </td>
              <% @dias_do_mes.each do |dia| %>
                <td class="text-center">
                  <% if dias_rodados.include?(dia) %>
                    <span class="badge bg-success rounded-circle" style="width: 24px; height: 24px; display: inline-block;">✓</span>
                  <% else %>
                    <span class="badge bg-light text-muted rounded-circle" style="width: 24px; height: 24px; display: inline-block;">-</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-3">
    <%= link_to mapas_path, class: "btn-outline" do %>
      <i class="bi bi-arrow-left me-1"></i> Voltar
    <% end %>
  </div>
</div>
