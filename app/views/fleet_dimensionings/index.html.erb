<div class="app-page">
  <div class="app-page-header">
    <div>
      <p class="app-page-eyebrow"><i class="bi bi-truck me-1"></i>Configurações · Frota</p>
      <h1><i class="bi bi-sliders me-2"></i>Dimensionamentos da frota</h1>
      <p>Quinzenas usadas para montar a disponibilidade da frota.</p>
    </div>
    <div class="app-page-actions">
      <%= link_to new_fleet_dimensioning_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i> Novo dimensionamento<% end %>
      <%= link_to "Voltar", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="app-table-section">
    <div class="app-table-section__body">
      <% if @fleet_dimensionings.any? %>
        <div class="table-responsive">
          <div class="app-table-shell"><table class="table app-table app-table--data mb-0">
            <thead class="table-light">
              <tr>
                <th>Nome</th>
                <th>Período</th>
                <th class="text-center">Carros</th>
                <th class="text-center">Vans</th>
                <th class="text-center">Vespertinas</th>
                <th class="text-center">AS</th>
                <th class="text-end"></th>
              </tr>
            </thead>

            <tbody>
              <% @fleet_dimensionings.each do |dimensioning| %>
                <tr>
                  <td><%= dimensioning.label %></td>
                  <td>
                    <%= l(dimensioning.start_date) %> a
                    <%= l(dimensioning.end_date) %>
                  </td>
                  <td class="text-center"><%= dimensioning.route_quantity %></td>
                  <td class="text-center"><%= dimensioning.van_quantity %></td>
                  <td class="text-center"><%= dimensioning.vespertina_quantity %></td>
                  <td class="text-center"><%= dimensioning.as_quantity %></td>
                  <td class="text-end">
                    <%= link_to edit_fleet_dimensioning_path(dimensioning),
                                class: "icon-btn", title: "Editar dimensionamento", aria: { label: "Editar dimensionamento" } do %>
                      <i class="bi bi-pencil-square" aria-hidden="true"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table></div>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-calendar-range display-4 text-muted"></i>

          <h5 class="mt-3">Nenhum dimensionamento cadastrado</h5>

          <p class="text-muted">
            Cadastre a quinzena antes de criar a disponibilidade da frota.
          </p>

          <%= link_to new_fleet_dimensioning_path,
                      class: "btn btn-primary" do %>
            <i class="bi bi-plus-circle"></i>
            Novo Dimensionamento
          <% end %>
        </div>
      <% end %>
  </div>
</div>
  <div class="mt-2">
      <%= link_to fleet_availabilities_path,
                class: "btn btn-outline-secondary" do %>

      <i class="bi bi-arrow-left"></i>
      Voltar

    <% end %>
</div>
