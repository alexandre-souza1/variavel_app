<section class="az-new-form-area">
  <article class="az-new-form-panel">
    <div class="az-new-form-header"><div><h2>Consultar minha variável</h2><p>Seu cargo, setor e turno são identificados pelo cadastro.</p></div><i class="bi bi-search az-new-form-icon"></i></div>
    <div class="az-new-form-body">
      <%= form_with url: consulta_path, method: :get, local: true do |f| %>
        <%= f.hidden_field :categoria, value: 'colaborador' %>
        <%= hidden_field_tag :return_to, request.path == root_path ? variaveis_path : request.path %>
        <div class="row g-3 align-items-end">
          <div class="col-12 col-lg-8"><%= f.label :matricula, 'Matrícula', class: 'az-new-field-label' %><%= f.text_field :matricula, value: params[:matricula], class: 'form-control form-control-lg az-new-form-control', required: true, autocomplete: 'off' %></div>
          <div class="col-12 col-lg-4 d-grid"><%= f.submit 'Consultar variável', class: 'az-new-submit' %></div>
        </div>
      <% end %>
      <p class="az-new-form-help">O período pode ser selecionado no relatório. DU: 21 a 20. AZ: 19 a 18.</p>
    </div>
  </article>
</section>
