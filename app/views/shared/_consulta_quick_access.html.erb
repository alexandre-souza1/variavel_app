<% items = consulta_quick_access_items(origin: origin) %>
<% carousel_id = "quick-access-#{origin}" %>
<article class="az-new-carousel-panel quick-access-panel">
  <div class="az-new-panel-header quick-access-heading">
    <div>
      <h2 id="<%= carousel_id %>-heading"><i class="bi bi-grid" aria-hidden="true"></i> Acessos rápidos</h2>
      <p>Ferramentas para facilitar seu dia.</p>
    </div>
    <span class="quick-access-count"><%= items.size %> acessos</span>
  </div>

  <div id="<%= carousel_id %>" class="carousel slide quick-access" data-bs-interval="false"
       role="region" aria-roledescription="carrossel" aria-labelledby="<%= carousel_id %>-heading">
    <div class="carousel-indicators quick-access-tabs" aria-label="Escolher acesso">
      <% items.each_with_index do |item, index| %>
        <button type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide-to="<%= index %>"
                class="<%= 'active' if index.zero? %>" aria-current="<%= index.zero? %>" aria-label="Mostrar <%= item[:title] %>">
          <i class="bi <%= item[:icon] %>" aria-hidden="true"></i><span><%= item[:tab_title] || item[:title] %></span>
        </button>
      <% end %>
    </div>

    <div class="carousel-inner">
      <% items.each_with_index do |item, index| %>
        <div class="carousel-item <%= 'active' if index.zero? %>" role="group" aria-roledescription="slide" aria-label="<%= index + 1 %> de <%= items.size %>: <%= item[:title] %>">
          <%= link_to item[:href], class: "quick-access-card quick-access-card--#{item[:theme]}", target: item[:external] ? "_blank" : nil, rel: item[:external] ? "noopener noreferrer" : nil do %>
            <div class="quick-access-copy">
              <span class="quick-access-category"><span class="quick-access-dot"></span><%= item[:category] %></span>
              <h3><%= item[:title] %></h3>
              <p><%= item[:description] %></p>
              <span class="quick-access-cta"><%= item[:action] %><i class="<%= item[:external] ? "bi bi-box-arrow-up-right" : "bi bi-arrow-right" %>" aria-hidden="true"></i></span>
              <% if item[:external] %><span class="visually-hidden"> (abre em nova aba)</span><% end %>
            </div>
            <div class="quick-access-art" aria-hidden="true">
              <span class="quick-access-orbit"></span>
              <span class="quick-access-symbol"><i class="bi <%= item[:icon] %>"></i></span>
              <span class="quick-access-number"><%= format('%02d', index + 1) %> / <%= format('%02d', items.size) %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="quick-access-footer">
      <span><i class="bi bi-hand-index-thumb" aria-hidden="true"></i> Escolha um acesso ou deslize</span>
      <div class="quick-access-controls">
        <button type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="prev" aria-label="Acesso anterior"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
        <button type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="next" aria-label="Próximo acesso"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
      </div>
    </div>
  </div>
</article>
