<%
  person = @driver || @ajudante
  profile_label = @employee ? (@selected_function ? @selected_parameter_profile[:label] : "Todos os cargos") : (@categoria == "van" ? "Van" : @categoria.to_s.capitalize)
  totals = @mapa_totals || {}
  show_recarga = @selected_function ? @selected_function != "van" : @categoria != "van"
%>

<div class="az-operator-report-page consultas-report-page">
  <header class="az-report-header">
    <div class="az-report-header-content">
      <div>
        <p class="az-report-eyebrow"><i class="bi bi-graph-up-arrow me-1"></i> Remuneração variável · <%= profile_label %></p>
        <h1 class="az-report-title">
          <i class="bi bi-person-circle"></i>
          <%= person&.nome || "Relatório de variável" %>
        </h1>
        <p class="az-report-subtitle">Resumo de mapas, entregas e valores calculados para o período consultado</p>
        <div class="az-report-meta">
          <span><i class="bi bi-person-badge"></i> Matrícula <strong><%= @matricula %></strong></span>
          <span><i class="bi bi-truck"></i> Perfil <strong><%= profile_label %></strong></span>
          <% if @data_inicio && @data_fim %>
            <span><i class="bi bi-calendar3"></i> <%= l(@data_inicio) %> a <%= l(@data_fim) %></span>
          <% end %>
        </div>
      </div>

      <div class="az-report-actions">
        <%= link_to consultas_new_path, class: "az-report-back-link" do %>
          <i class="bi bi-arrow-left"></i> Voltar
        <% end %>

        <div class="az-report-actions__controls">
          <%= form_with url: consulta_path, method: :get, local: true,
                        class: "az-period-filter",
                        data: { controller: "autosubmit", autosubmit_target: "form" } do %>
            <%= hidden_field_tag :matricula, @matricula %>
            <%= hidden_field_tag :categoria, @categoria %>
            <%= hidden_field_tag :funcao, params[:funcao] if params[:funcao].present? %>

            <div class="az-period-field">
              <%= label_tag :periodo_mes, "Mês" %>
              <%= select_tag :periodo_mes,
                  options_for_select((1..12).map { |month| [I18n.t("date.month_names")[month], month] }, params[:periodo_mes]),
                  class: "form-select form-select-sm",
                  data: { autosubmit_target: "select", action: "change->autosubmit#submitOnChange" },
                  required: true %>
            </div>

            <div class="az-period-field">
              <%= label_tag :periodo_ano, "Ano" %>
              <%= select_tag :periodo_ano,
                  options_for_select((Date.current.year - 5..Date.current.year).to_a.reverse, params[:periodo_ano] || Date.current.year),
                  class: "form-select form-select-sm",
                  data: { autosubmit_target: "select", action: "change->autosubmit#submitOnChange" },
                  required: true %>
            </div>

            <%= submit_tag "Atualizar", class: "az-period-submit" %>
          <% end %>

          <% if @parameter_profiles&.many? %>
            <div class="az-function-switch" aria-label="Selecionar função do período" data-controller="function-switch">
              <div class="az-function-switch__options" role="tablist" aria-label="Funções disponíveis">
                <%= link_to 'Todos', consulta_path(matricula: @matricula, categoria: @categoria, periodo_mes: params[:periodo_mes], periodo_ano: params[:periodo_ano], funcao: 'todos'), class: "az-function-switch__option #{'is-active' if @selected_function.blank?}", aria: { selected: @selected_function.blank? }, data: { action: 'click->function-switch#change' } %>
                <% @parameter_profiles.each do |profile| %>
                  <% switch_label = profile[:cargo] == 'van' ? 'Van' : profile[:cargo].capitalize %>
                  <%= link_to switch_label, consulta_path(matricula: @matricula, categoria: @categoria, periodo_mes: params[:periodo_mes], periodo_ano: params[:periodo_ano], funcao: profile[:cargo]), class: "az-function-switch__option #{'is-active' if @selected_function == profile[:cargo]}", aria: { selected: @selected_function == profile[:cargo] }, title: profile[:label], data: { action: 'click->function-switch#change' } %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </header>

  <div class="az-report-flashes">
    <% Array(@report_issues).each do |issue| %><p class="alert alert-warning"><%= issue %></p><% end %>
    <% if @closing && !@closing.legacy_baseline? %><p class="alert alert-info">Fechamento registrado · revisão <%= @closing.revision %>. Valores preservados conforme o registro.</p><% end %>
  </div>

  <section class="az-report-overview" aria-label="Resumo da variável">
    <div class="az-overview-card az-overview-card--total">
      <div class="az-overview-label"><i class="bi bi-cash-coin"></i> Total da variável</div>
      <div class="az-overview-value"><%= number_to_currency(totals[:valor_total].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></div>
      <div class="az-overview-detail">Mapas e valores do fechamento</div>
    </div>

    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-map"></i> Mapas</div>
      <div class="az-overview-value"><%= totals[:quantidade_mapas].to_i %></div>
      <div class="az-overview-detail"><%= number_to_currency(totals[:valor_total].to_f, unit: "R$ ", separator: ",", delimiter: ".") %> no total</div>
    </div>

    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-box-seam"></i> Caixa real</div>
      <div class="az-overview-value"><%= number_to_currency(totals[:valor_caixas].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></div>
      <div class="az-overview-detail"><%= totals[:caixas_reais].to_i %> caixa(s)</div>
    </div>

    <div class="az-overview-card">
      <div class="az-overview-label"><i class="bi bi-shop"></i> PDV real</div>
      <div class="az-overview-value"><%= number_to_currency(totals[:valor_pdvs].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></div>
      <div class="az-overview-detail"><%= totals[:pdvs_reais].to_i %> entrega(s)</div>
    </div>
  </section>

  <%= render "consumption", report: @gasola_consumption if @gasola_consumption %>

  <section class="az-report-grid">
    <article class="az-report-panel">
      <div class="az-panel-header">
        <div>
          <h2><i class="bi bi-bar-chart-fill az-panel-icon me-2"></i>Painel de totais</h2>
          <p>Composição da variável calculada para este fechamento.</p>
        </div>
      </div>
      <div class="az-panel-body">
        <div class="az-total-list">
          <div class="az-total-row">
            <span class="az-total-name"><span class="az-total-dot"></span>Caixa real</span>
            <span class="az-total-amount"><%= number_to_currency(totals[:valor_caixas].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
          <div class="az-total-row">
            <span class="az-total-name"><span class="az-total-dot"></span>PDV real</span>
            <span class="az-total-amount"><%= number_to_currency(totals[:valor_pdvs].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
          <% if show_recarga %>
            <div class="az-total-row">
              <span class="az-total-name"><span class="az-total-dot"></span>Recargas</span>
              <span class="az-total-amount"><%= number_to_currency(totals[:valor_recargas].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></span>
            </div>
          <% end %>
          <div class="az-total-row">
            <span class="az-total-name"><span class="az-total-dot"></span>Bônus de devolução</span>
            <span class="az-total-amount"><%= number_to_currency(totals[:bonus_devolucao].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
          <div class="az-total-row az-total-row--grand">
            <span class="az-total-name"><i class="bi bi-check2-circle"></i>Total geral</span>
            <span class="az-total-amount"><%= number_to_currency(totals[:valor_total].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
        </div>
      </div>
    </article>

    <article class="az-report-panel">
      <div class="az-panel-header">
        <div>
          <h2><i class="bi bi-calendar-range az-panel-icon me-2"></i>Dados do período</h2>
          <p>Referência usada na consulta atual.</p>
        </div>
      </div>
      <div class="az-panel-body">
        <div class="az-period-details">
          <div class="az-detail-item"><span>Fechamento</span><span><%= params[:periodo_mes].present? ? "#{I18n.t("date.month_names")[params[:periodo_mes].to_i].capitalize}/#{params[:periodo_ano]}" : "Não selecionado" %></span></div>
          <div class="az-detail-item"><span>Intervalo</span><span><%= @data_inicio && @data_fim ? "#{l(@data_inicio)} — #{l(@data_fim)}" : "—" %></span></div>
          <div class="az-detail-item"><span>Dias no intervalo</span><span><%= @dias_periodo || "—" %></span></div>
          <div class="az-detail-item"><span>Devolução</span><span><%= totals[:devolucoes].to_f.to_i %> · <%= (totals[:percentual_devolucao].to_f * 100).round(2) %>%</span></div>
        </div>
      </div>
    </article>
  </section>

  <div class="az-report-note">
    <i class="bi bi-info-circle-fill"></i>
    <span><%= @closing ? "Resultado registrado. Correções exigem uma nova revisão no RH." : "Esta é uma prévia da variável." %> Os valores podem variar em casos de alocação como ajudante, extra ou ajustes de operação. Em caso de inconsistência, contate a supervisão.</span>
  </div>

  <article class="az-report-panel mb-4">
    <div class="az-panel-header">
      <div>
        <h2 class="az-report-section-title"><i class="bi bi-map"></i> Detalhes dos mapas</h2>
        <p>Volumes, recargas e valores considerados no período.</p>
      </div>
      <span class="az-overview-detail"><strong><%= totals[:quantidade_mapas].to_i %></strong> mapa(s)</span>
    </div>

    <% if params[:periodo_mes].blank? %>
      <p class="az-report-empty"><i class="bi bi-calendar3 me-1"></i> Selecione um mês e ano para visualizar os mapas.</p>
    <% elsif @mapas.empty? %>
      <p class="az-report-empty">Nenhum mapa encontrado para este período.</p>
    <% else %>
      <div class="az-report-table-wrap">
        <table class="az-report-table az-report-table--wide">
          <thead>
            <tr>
              <th>Mapa</th>
              <th>Data</th><th>Cargo aplicado</th>
              <% if show_recarga %><th>Fator</th><% end %>
              <th>Cx total</th><th>Cx real</th><th>PDV total</th><th>PDV real</th>
              <% if show_recarga %><th>Recarga</th><% end %>
              <th class="text-end">Valor cx</th><th class="text-end">Valor PDV</th>
              <% if show_recarga %><th class="text-end">Valor rec.</th><% end %>
              <th class="text-end">Valor MP</th>
            </tr>
          </thead>
          <tbody>
            <% @mapas.each do |mapa| %>
              <% values = @mapa_calculations[mapa.id] %>
              <% recarga = values[:recarga] %>
              <tr>
                <td data-label="Mapa"><%= mapa.mapa %></td>
                <td data-label="Data"><%= mapa.data_formatada&.strftime("%d/%m/%Y") || "Data inválida" %></td>
                <td data-label="Cargo aplicado"><%= EmployeeRole::CARGOS.key(values[:categoria]) %><% if values[:recarga_inconsistente] %><small class="d-block text-warning">Recarga informada; paga como mapa normal.</small><% end %></td>
                <% if show_recarga %><td data-label="Fator"><%= mapa.fator %></td><% end %>
                <td data-label="Cx total"><%= mapa.cx_total %></td>
                <td data-label="Cx real"><%= mapa.cx_real %></td>
                <td data-label="PDV total"><%= mapa.pdv_total %></td>
                <td data-label="PDV real"><%= mapa.pdv_real %></td>
                <% if show_recarga %><td data-label="Recarga"><%= mapa.recarga %></td><% end %>
                <td data-label="Valor cx" class="text-end"><%= number_to_currency(recarga ? 0 : values[:valor_cx], unit: "R$ ", separator: ",", delimiter: ".") %></td>
                <td data-label="Valor PDV" class="text-end"><%= number_to_currency(recarga ? 0 : values[:valor_pdv], unit: "R$ ", separator: ",", delimiter: ".") %></td>
                <% if show_recarga %><td data-label="Valor rec." class="text-end"><%= number_to_currency(values[:valor_rec], unit: "R$ ", separator: ",", delimiter: ".") %></td><% end %>
                <td data-label="Valor MP" class="text-end az-table-total"><%= number_to_currency(values[:valor_mp], unit: "R$ ", separator: ",", delimiter: ".") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </article>

  <section class="az-report-section-grid">
    <article class="az-report-panel">
      <div class="az-panel-header">
        <div>
          <h2 class="az-report-section-title"><i class="bi bi-list-check"></i> Resumo operacional</h2>
          <p>Volumes e indicadores do período.</p>
        </div>
      </div>
      <div class="az-report-table-wrap">
        <table class="az-report-table">
          <tbody>
            <tr><td data-label="Caixa real"><%= totals[:caixas_reais].to_i %></td><td data-label="Valor" class="text-end az-table-total"><%= number_to_currency(totals[:valor_caixas].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr>
            <tr><td data-label="PDV real"><%= totals[:pdvs_reais].to_i %></td><td data-label="Valor" class="text-end az-table-total"><%= number_to_currency(totals[:valor_pdvs].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr>
            <% if show_recarga %><tr><td data-label="Recargas"><%= totals[:recargas].to_i %></td><td data-label="Valor" class="text-end az-table-total"><%= number_to_currency(totals[:valor_recargas].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><% end %>
            <tr><td data-label="Devolução"><%= totals[:devolucoes].to_f.to_i %> · <%= (totals[:percentual_devolucao].to_f * 100).round(2) %>%</td><td data-label="Bônus" class="text-end az-table-total"><%= number_to_currency(totals[:bonus_devolucao].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr>
            <tr><td data-label="Quantidade de mapas"> <%= totals[:total_mapas].to_i %></td><td data-label="Total" class="text-end az-table-total"><%= number_to_currency(totals[:valor_total].to_f, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr>
          </tbody>
        </table>
      </div>
    </article>

    <article class="az-report-panel">
      <div class="az-panel-header">
        <div>
          <h2 class="az-report-section-title"><i class="bi bi-sliders"></i> Parâmetros de cálculo</h2>
          <p>Parâmetros efetivamente usados no cálculo da função selecionada.</p>
        </div>
      </div>
      <div class="az-panel-body">
        <% if @selected_parameter_profiles.present? %>
          <p class="text-muted small">Valores da última data de mapa de <strong><%= @selected_function ? @selected_parameter_profile[:label] : 'todos os cargos' %></strong> no período. Cada mapa mantém a tarifa usada no seu próprio cálculo.</p>
          <div class="az-parameter-profiles">
            <% @selected_parameter_profiles.each do |profile| %>
              <div class="az-parameter-profile">
                <div class="az-parameter-profile__header">
                  <strong><%= profile[:label] %></strong>
                  <small><%= profile[:map_date] ? l(profile[:map_date]) : 'Data não informada' %></small>
                </div>
                <div class="az-period-details">
                  <div class="az-detail-item"><span>Caixa real</span><span><%= number_to_currency(profile[:caixa], unit: "R$ ", separator: ",", delimiter: ".") %></span></div>
                  <div class="az-detail-item"><span>PDV real</span><span><%= number_to_currency(profile[:entrega], unit: "R$ ", separator: ",", delimiter: ".") %></span></div>
                  <% unless profile[:cargo] == "van" %>
                    <div class="az-detail-item"><span>Recarga</span><span><%= number_to_currency(profile[:recarga], unit: "R$ ", separator: ",", delimiter: ".") %></span></div>
                  <% end %>
                  <div class="az-detail-item"><span>Bônus devolução</span><span><%= number_to_currency(profile[:bonus_devolucao], unit: "R$ ", separator: ",", delimiter: ".") %></span></div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted mb-0">Selecione um período com mapas calculados para visualizar os parâmetros utilizados.</p>
        <% end %>
      </div>
    </article>
  </section>
</div>

<%= public_variable_chat_widget %>
