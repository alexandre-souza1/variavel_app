<div class="consultas-new-page" data-controller="formulario">
  <header class="az-new-header">
    <div>
      <p class="az-new-eyebrow"><i class="bi bi-grid-1x2 me-1"></i> Workstation LOG20 · Foz do Iguaçu</p>
      <h1 class="az-new-title"><i class="bi bi-clipboard-data"></i> Consulta de variável</h1>
      <p class="az-new-subtitle">Informe sua matrícula. O sistema identifica o setor e o histórico de cargos.</p>
    </div>

    <div class="az-new-header-actions">
      <%= link_to "Voltar ao início", variaveis_path, class: "btn btn-outline-secondary" %>
      <%= render "shared/unit_dream" %>
    </div>
  </header>

  <%= render 'shared/employee_variable_lookup' %>

  <section class="az-new-resource-grid">
    <%= render "shared/consulta_quick_access", origin: "consultas" %>

    <article class="az-new-info-panel">
      <div class="az-new-panel-header">
        <h2><i class="bi bi-sliders"></i> Parâmetros de cálculo</h2>
        <p>Valores configurados por perfil.</p>
      </div>
      <div class="az-new-parameters">
        <% ["motorista", "ajudante", "van"].each do |categoria| %>
          <div class="consultas-parameter-group">
            <h3><%= categoria %></h3>
            <% if @parametros && @parametros[categoria].present? %>
              <% @parametros[categoria].each do |param| %>
                <div class="az-new-parameter">
                  <strong><%= param.nome.to_s.titleize %></strong>
                  <span>R$ <%= number_with_precision(param.valor.to_f, precision: 2, separator: ",") %></span>
                </div>
              <% end %>
            <% else %>
              <p class="text-muted small mb-0">Nenhum parâmetro encontrado.</p>
            <% end %>
          </div>
        <% end %>
      </div>
    </article>
  </section>
</div>

<%= public_variable_chat_widget %>
